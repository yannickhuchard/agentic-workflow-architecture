            "target_id": "e0c7df6c-11cc-4b6f-85ff-a700142bc3c2",
            "label": "Coverages designed"
        },
        {
            "id": "e1f7df6c-11cc-4b6f-85ff-a700142bc3a3",
            "source_id": "e0c7df6c-11cc-4b6f-85ff-a700142bc3c2",
            "target_id": "e0c7df6c-11cc-4b6f-85ff-a700142bc3c3",
            "label": "Underwriting rules established"
        },
        {
            "id": "e1f7df6c-11cc-4b6f-85ff-a700142bc3a4",
            "source_id": "e0c7df6c-11cc-4b6f-85ff-a700142bc3c3",
            "target_id": "e0c7df6c-11cc-4b6f-85ff-a700142bc3c4",
            "label": "Proposal drafted"
        },
        {
            "id": "e1f7df6c-11cc-4b6f-85ff-a700142bc3a5",
            "source_id": "e0c7df6c-11cc-4b6f-85ff-a700142bc3c4",
            "target_id": "e0c7df6c-11cc-4b6f-85ff-a700142bc3c5",
            "label": "IPID generated"
        }
    ],
    "roles": [
        {
            "id": "e77bb28b-b8c7-4eb9-bf55-cb09a1de8852",
            "name": "Flying Cars Market Analyst",
            "description": "Researches risks and regulatory landscapes of the UAM and eVTOL vehicle industry.",
            "actor_type": "ai_agent",
            "capabilities": ["aviation_research", "risk_identification"],
            "ai_model_config": {
                "model_id": "gemini-3-flash-preview",
                "temperature": 0.5,
                "max_tokens": 1000
            }
        },
        {
            "id": "d20e7df6-c11c-4b6f-85ff-a700142bc3c5",
            "name": "eVTOL Product Designer",
            "description": "Formulates specific coverage components, exclusions, and limits.",
            "actor_type": "ai_agent",
            "capabilities": ["insurance_product_design", "policy_structure"],
            "ai_model_config": {
                "model_id": "gemini-3-flash-preview",
                "temperature": 0.5,
                "max_tokens": 1000
            }
        },
        {
            "id": "a911e3b2-9d3b-489d-bdff-c081e289e685",
            "name": "eVTOL Risk Underwriter",
            "description": "Establishes risks guidelines, pilot standards, and constraints.",
            "actor_type": "ai_agent",
            "capabilities": ["risk_underwriting", "operational_rules"],
            "ai_model_config": {
                "model_id": "gemini-3-flash-preview",
                "temperature": 0.5,
                "max_tokens": 1000
            }
        },
        {
            "id": "92e1e3b2-7bb3-4eef-bdfe-3e0e7a1de999",
            "name": "Commercial Offering Officer",
            "description": "Drafts insurance proposals, pricing quotes, and standard IPID documents.",
            "actor_type": "ai_agent",
            "capabilities": ["proposal_generation", "ipid_structuring"],
            "ai_model_config": {
                "model_id": "gemini-3-flash-preview",
                "temperature": 0.5,
                "max_tokens": 1000
            }
        },
        {
            "id": "c4d9e3b1-9bb4-4ddf-bdde-3e0e7a1de000",
            "name": "Chief Aviation Underwriter",
            "description": "Reviews the finalized offering proposal, pricing, and IPID for sign-off.",
            "actor_type": "human",
            "capabilities": ["final_signoff", "policy_approval"]
        }
    ],
