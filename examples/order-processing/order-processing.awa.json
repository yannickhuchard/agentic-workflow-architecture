                    "direction": "requires",
                    "resource_type": "api",
                    "resource_id": "fraud-detection",
                    "permission": "execute"
                }
            ],
            "analytics": {
                "value_added": true,
                "process_time": "PT45S"
            }
        },
        {
            "id": "a057c5df-23f0-5530-9e63-e2226b75b7d0",
