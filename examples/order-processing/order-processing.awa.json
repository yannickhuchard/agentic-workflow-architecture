                    "waiting"
                ]
            }
        },
        {
            "id": "ecf1db83-2ef8-5c5c-9d0a-66e79ecd9375",
            "name": "Fulfill Order",
            "description": "AI agent coordinates order fulfillment with warehouse robots",
            "role_id": "5c1ef60f-7e4d-593e-9a9d-b8be38193a8b",
            "actor_type": "ai_agent",
            "context_bindings": [
                {
                    "context_id": "8bcac4ae-ee97-5aa1-b475-b4e9557caf73",
