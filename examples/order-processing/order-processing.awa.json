                    "access_mode": "read",
                    "required": true
                }
            ],
            "analytics": {
                "value_added": true,
                "process_time": "PT3M"
            }
        },
        {
            "id": "e6264dee-bc73-57f3-87f2-fc058767050d",
            "name": "Notify Customer",
            "description": "AI agent generates and sends personalized order confirmation",
            "role_id": "9027160c-833a-540f-9147-31c011907e7f",
            "actor_type": "ai_agent",
            "context_bindings": [
                {
                    "context_id": "8bcac4ae-ee97-5aa1-b475-b4e9557caf73",
                    "access_mode": "read",
                    "required": true
                }
            ],
            "access_rights": [
                {
                    "id": "f780c9a6-01b2-595e-8576-d94b6aee0743",
                    "name": "Email Service",
                    "direction": "requires",
                    "resource_type": "service",
