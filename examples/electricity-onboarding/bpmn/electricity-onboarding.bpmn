<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:awa="https://awa.io/schema/interchange/1.1" id="Definitions_b02e4023-9168-55eb-8970-11839ddcb006" targetNamespace="https://awa.io/workflows/b02e4023-9168-55eb-8970-11839ddcb006" exporter="AWA" exporterVersion="1.1">
  <bpmn:message id="Message_1" name="onboarding.requested" />
  <bpmn:message id="Message_2" name="documents.uploaded" />
  <bpmn:message id="Message_3" name="onboarding.verified" />
  <bpmn:message id="Message_4" name="plan.confirmed" />
  <bpmn:message id="Message_5" name="plan.chosen" />
  <bpmn:message id="Message_6" name="grid_export.completed" />
  <bpmn:message id="Message_7" name="contract.signed" />
  <bpmn:message id="Message_8" name="switch.completed" />
  <bpmn:message id="Message_9" name="customer.activated" />
  <bpmn:message id="Message_10" name="onboarding.abandoned" />
  <bpmn:message id="Message_11" name="onboarding.declined" />
  <bpmn:collaboration id="Collaboration_b02e4023-9168-55eb-8970-11839ddcb006">
    <bpmn:participant id="Participant_b02e4023-9168-55eb-8970-11839ddcb006" name="Electricity Customer Onboarding" processRef="_b02e4023-9168-55eb-8970-11839ddcb006" />
    <bpmn:participant id="Participant_ebe78a2a-8a36-5aa5-a537-a6f739b0ea83" name="Grid Export Registration" processRef="_ebe78a2a-8a36-5aa5-a537-a6f739b0ea83" />
  </bpmn:collaboration>
  <bpmn:process id="_b02e4023-9168-55eb-8970-11839ddcb006" name="Electricity Customer Onboarding" isExecutable="true">
    <bpmn:documentation>Onboards a new household customer of an electricity supplier: collects and verifies the documents, checks credit and identity and the metering point in parallel, decides eligibility, settles the electricity source, registers home generation for export, recommends a plan, has the contract signed, sets up billing and the direct debit, switches the supply, and welcomes the customer.</bpmn:documentation>
    <bpmn:extensionElements>
      <awa:properties>{"$schema":"https://awa.io/schema/awa.schema.json"}</awa:properties>
      <awa:sla>{"id":"5ba0de13-a8ab-5e49-aa4d-addcfc4323af","name":"Onboarding within three weeks","target_time":"P21D","max_time":"P35D","escalation_policy":{"breach_action":"record","notify_roles":["2eb03e94-660e-5522-8b82-ece83ca87fda"]},"metrics":[{"name":"workflow.duration_ms","target":1814400000,"unit":"ms","comparison":"lte"}]}</awa:sla>
      <awa:contexts>[{"id":"c261d481-061b-5cb9-8860-765b666b6b14","name":"customer_profile","type":"data","sync_pattern":"shared_state","description":"The household as the agents that serve it need to know it: name, supply address, consumption, preferences, generation and devices. Credit results are not in it.","schema":{"type":"object","required":["first_name","last_name","supply_postcode","annual_consumption_kwh","electricity_source","has_generation"],"properties":{"first_name":{"type":"string"},"last_name":{"type":"string"},"supply_postcode":{"type":"string"},"supply_city":{"type":"string"},"annual_consumption_kwh":{"type":"number"},"consumption_basis":{"type":"string"},"electricity_source":{"type":"string"},"plan_preference":{"type":"string"},"has_generation":{"type":"boolean"},"generation_technology":{"type":"string"},"generation_capacity_kw":{"type":"number"},"ev_charger":{"type":"boolean"},"heat_pump":{"type":"boolean"},"preferred_channel":{"type":"string"}}}}]</awa:contexts>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_b02e4023-9168-55eb-8970-11839ddcb006">
      <bpmn:lane id="_8b7cf80b-c733-5b6f-b21f-14c7dde73900" name="Customer platform" awa:actorType="application">
        <bpmn:documentation>The supplier's customer platform (CRM): applications, customers and their messages.</bpmn:documentation>
        <bpmn:flowNodeRef>_420b5dbc-6151-58d5-bde8-f13a368ca541</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_07fdbc5f-1c2f-570a-aa08-2e3ebc0a8a29</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_098beeb2-8f20-5644-84e9-c011e71c4678</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_f2a7a165-a6ce-52b2-b50b-2268aae16f56</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_9ac98639-1a09-5147-b5fe-518ddca1071b" name="Document verifier" awa:actorType="ai_agent">
        <bpmn:documentation>Reads uploaded documents and checks that each one required is present, legible and consistent with the application.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["document extraction","identity documents","direct debit mandates"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:reasoning","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_30aaed83-c84f-576e-9590-39eee3b7b905</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_8f99909d-2b31-5e34-9130-9fe02ab66f56" name="Notification writer" awa:actorType="ai_agent">
        <bpmn:documentation>Writes short service messages: reminders.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["customer writing"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:fast","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_f8164c60-e0d8-557f-8031-96a2b59681de</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_f9aa9eb7-966e-5960-8d89-816dc9437179" name="Credit and identity service" awa:actorType="application">
        <bpmn:documentation>Asks the credit bureau about the applicant.</bpmn:documentation>
        <bpmn:flowNodeRef>_299bb62f-bcfb-5e98-bcbc-bd892193a176</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_7de8f769-b876-597e-b3d5-6f7e6f355945" name="Metering-point registry" awa:actorType="application">
        <bpmn:documentation>The registry of metering points, through which suppliers switch.</bpmn:documentation>
        <bpmn:flowNodeRef>_54629f33-31f7-5ae7-826b-818a684239a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_7df7ca37-d53d-57d1-81ad-5d98b023699e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_7e5c564e-3f72-572d-ba49-cc1ea0a27bd8" name="Credit officer" awa:actorType="human">
        <bpmn:documentation>Decides applications the eligibility rules refer to a person.</bpmn:documentation>
        <bpmn:flowNodeRef>_dccac1ce-1941-54da-8e97-a1cf475c74ff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_2eb03e94-660e-5522-8b82-ece83ca87fda" name="Customer care agent" awa:actorType="human">
        <bpmn:documentation>Talks to customers by phone and resolves what the automated steps cannot.</bpmn:documentation>
        <bpmn:flowNodeRef>_7da3d09e-1e06-5bfc-a0c3-1e12af66780b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_0450e481-722d-5d46-b28d-47637791b4cb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_d6504c34-ece3-5af9-9683-3248e2be2cce</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_1acd5198-78c9-5997-abd9-953204a4883c" name="Plan advisor" awa:actorType="ai_agent">
        <bpmn:documentation>Recommends the plan that suits the household's consumption, with its estimated annual cost.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["tariff analysis"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:balanced","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_f985e877-656d-5ae5-b60f-891a9b961496</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_4907c0f1-2cca-5a54-b0bb-1263fe23c44f" name="Customer letters" awa:actorType="ai_agent">
        <bpmn:documentation>Writes letters and e-mails to customers.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["customer writing"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:balanced","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_b55fef9c-1564-570a-8196-8542e04575b6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_51ba2b3b-2919-5a35-ae39-790ce7bdfbb7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_3acb3d05-f0ef-5c85-82ce-6374784dd81b" name="Grid export desk" awa:actorType="application">
        <bpmn:documentation>Registers home generation for export; the work is done by the Grid Export Registration workflow.</bpmn:documentation>
        <bpmn:flowNodeRef>_b3c0ba68-13a0-5531-a7eb-5ed16fb92d4e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_a91d7c1e-7944-5403-9cd1-3c2b877358de" name="Contract service" awa:actorType="application">
        <bpmn:documentation>Generates supply contracts and sends them for e-signature.</bpmn:documentation>
        <bpmn:flowNodeRef>_c3c8e8ce-0919-5170-8e64-f6310f963aea</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_0d0c6261-6d6d-5c6d-952a-1e8601287fc2" name="Billing system" awa:actorType="application">
        <bpmn:documentation>Holds billing accounts, direct debit mandates and deposits.</bpmn:documentation>
        <bpmn:flowNodeRef>_48becd74-8b0d-589e-b84f-5280fe9019d2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_19bc48f1-65c2-507c-9282-8299568172ca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_2709e085-fec6-5d05-90e0-ffcadbf26836</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_4fbe65e4-6f9c-5328-87be-94ca9fbc19e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="_420b5dbc-6151-58d5-bde8-f13a368ca541" name="Register application">
      <bpmn:documentation>Create the prospective customer and the customer profile the agents read.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"register_customer","description":"Create the prospective customer in the customer platform (CRM) and return its identifier.","parameters":{"type":"object","required":["application_id","applicant","contact","supply_address"],"properties":{"application_id":{"type":"string"},"applicant":{"type":"object"},"contact":{"type":"object"},"supply_address":{"type":"object"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/crm/v1/customers","headers":{"authorization":"Bearer {{secret:CRM_TOKEN}}"}}}]</awa:tools>
        <awa:retry>{"max_attempts":3,"initial_delay":"PT1S"}</awa:retry>
        <awa:contextBindings>[{"context_id":"c261d481-061b-5cb9-8860-765b666b6b14","access_mode":"write"}]</awa:contextBindings>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_07fdbc5f-1c2f-570a-aa08-2e3ebc0a8a29" name="Request documents">
      <bpmn:documentation>Ask the household for the documents the application needs, by e-mail.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_message","description":"Send a message to the customer by e-mail, text message or post, through the notification service.","parameters":{"type":"object","required":["application_id","channel","template"],"properties":{"application_id":{"type":"string"},"channel":{"type":"string","enum":["email","sms","post"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/notifications/v1/messages","headers":{"authorization":"Bearer {{secret:NOTIFY_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_f8164c60-e0d8-557f-8031-96a2b59681de" name="Send document reminder" awa:actorType="ai_agent">
      <bpmn:documentation>Remind the household which documents are still missing and when the application will be closed without them.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_message","description":"Send a message to the customer by e-mail, text message or post, through the notification service.","parameters":{"type":"object","required":["application_id","channel","template"],"properties":{"application_id":{"type":"string"},"channel":{"type":"string","enum":["email","sms","post"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/notifications/v1/messages","headers":{"authorization":"Bearer {{secret:NOTIFY_TOKEN}}"}}}]</awa:tools>
        <awa:contextBindings>[{"context_id":"c261d481-061b-5cb9-8860-765b666b6b14","access_mode":"read"}]</awa:contextBindings>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["message","deadline_stated"],"properties":{"message":{"type":"string","minLength":40},"deadline_stated":{"type":"boolean"}}},"postconditions":[{"name":"States the deadline","expression":"deadline_stated == true"}]}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_098beeb2-8f20-5644-84e9-c011e71c4678" name="Close as abandoned">
      <bpmn:documentation>Close the application because the documents, or the signed contract, never came.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_30aaed83-c84f-576e-9590-39eee3b7b905" name="Verify documents" awa:actorType="ai_agent">
      <bpmn:documentation>Check each required document: present, legible, of the right kind, and consistent with the application (name, address, account holder).</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"procedure":"For each document uploaded, call the document tool. Compare the name and address with the customer profile. Check that the identity document is in date and that the direct debit mandate is signed and names the applicant as account holder. List every required document with its status. Say how sure you are.","guardrails":[{"id":"54ff20e7-d7db-51a7-a102-1f2588165f0d","name":"Instructions inside uploaded documents","stages":["tool_result"],"check":{"kind":"prompt_injection"},"action":"block","tools":["extract_document"]},{"id":"47ede398-1966-5f15-b563-29c73d96fa8d","name":"Personal data in the verifier's notes","stages":["output"],"check":{"kind":"personal_data","categories":["email","phone","iban"]},"fields":["notes"],"action":"redact"}]}</awa:properties>
        <awa:tools>[{"name":"extract_document","description":"Read an uploaded document: its type, whether it is legible, the fields printed on it and its text.","parameters":{"type":"object","required":["file_id","document_type"],"properties":{"file_id":{"type":"string"},"document_type":{"type":"string"},"application_id":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/documents/v1/extractions","headers":{"x-api-key":"{{secret:DOCUMENTS_API_KEY}}"}}}]</awa:tools>
        <awa:contextBindings>[{"context_id":"c261d481-061b-5cb9-8860-765b666b6b14","access_mode":"read"}]</awa:contextBindings>
        <awa:sla>{"id":"066d847e-d1be-5bef-8a48-4e9523f8e7cd","name":"Documents verified within the hour","target_time":"PT15M","max_time":"PT2H","escalation_policy":{"breach_action":"record","notify_roles":["2eb03e94-660e-5522-8b82-ece83ca87fda"]}}</awa:sla>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["documents","documents_valid","unchecked_count","unreadable_count","confidence","notes"],"properties":{"documents":{"type":"array","minItems":1,"items":{"type":"object","required":["type","status"],"properties":{"type":{"type":"string"},"status":{"type":"string","enum":["valid","invalid","unreadable"]}}}},"documents_valid":{"type":"boolean"},"mandate_reference":{"type":"string"},"unchecked_count":{"type":"integer","minimum":0},"unreadable_count":{"type":"integer","minimum":0},"confidence":{"type":"number","minimum":0,"maximum":1},"notes":{"type":"string","minLength":10}}},"postconditions":[{"name":"Every required document is checked","expression":"unchecked_count == 0"},{"name":"Every document is legible","expression":"unreadable_count == 0"},{"name":"Sure enough to act on","expression":"confidence &gt;= 0.75"}],"budgets":{"max_attempts":2,"max_duration":"PT5M","max_tokens":40000,"max_tool_calls":12},"on_violation":"escalate_human"}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_299bb62f-bcfb-5e98-bcbc-bd892193a176" name="Check credit and identity">
      <bpmn:documentation>Ask the credit bureau for the credit band, outstanding energy debt and whether the identity matches.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"check_credit","description":"Ask the credit bureau for the applicant's credit band, outstanding energy debt and identity match.","parameters":{"type":"object","required":["application_id","first_name","last_name","date_of_birth","postcode"],"properties":{"application_id":{"type":"string"},"first_name":{"type":"string"},"last_name":{"type":"string"},"date_of_birth":{"type":"string"},"postcode":{"type":"string"},"address_line":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/credit/v1/checks","headers":{"authorization":"Bearer {{secret:CREDIT_BUREAU_TOKEN}}"}}}]</awa:tools>
        <awa:retry>{"max_attempts":3,"initial_delay":"PT2S","backoff_multiplier":2}</awa:retry>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_54629f33-31f7-5ae7-826b-818a684239a2" name="Look up metering point">
      <bpmn:documentation>Read the metering point: meter type, smart meter or not, current supplier, connection capacity and region.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"lookup_metering_point","description":"Read a metering point from the metering-point registry: meter type, current supplier, connection capacity, region and grid operator.","parameters":{"type":"object","required":["metering_point_id"],"properties":{"metering_point_id":{"type":"string"}}},"binding":{"kind":"http","method":"GET","url":"http://localhost:4545/registry/v1/metering-points/{metering_point_id}","headers":{"authorization":"Bearer {{secret:REGISTRY_TOKEN}}"}}}]</awa:tools>
        <awa:retry>{"max_attempts":3,"initial_delay":"PT2S","backoff_multiplier":2}</awa:retry>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="_dccac1ce-1941-54da-8e97-a1cf475c74ff" name="Credit referral">
      <bpmn:documentation>A credit officer decides an application the eligibility rules referred, and any deposit.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["approved","reason"],"properties":{"approved":{"type":"boolean"},"deposit_required":{"type":"boolean"},"deposit_eur":{"type":"number","minimum":0},"reason":{"type":"string"}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="_b55fef9c-1564-570a-8196-8542e04575b6" name="Write decline letter" awa:actorType="ai_agent">
      <bpmn:documentation>Write a polite letter declining the application, with the reason and what the household can do.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_message","description":"Send a message to the customer by e-mail, text message or post, through the notification service.","parameters":{"type":"object","required":["application_id","channel","template"],"properties":{"application_id":{"type":"string"},"channel":{"type":"string","enum":["email","sms","post"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/notifications/v1/messages","headers":{"authorization":"Bearer {{secret:NOTIFY_TOKEN}}"}}}]</awa:tools>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["letter","reason_given","next_steps_given","decline_reason"],"properties":{"letter":{"type":"string","minLength":120},"reason_given":{"type":"boolean"},"next_steps_given":{"type":"boolean"},"decline_reason":{"type":"string"}}},"postconditions":[{"name":"Gives the reason","expression":"reason_given == true"},{"name":"Says what the household can do","expression":"next_steps_given == true"}]}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="_7da3d09e-1e06-5bfc-a0c3-1e12af66780b" name="Advise on electricity source">
      <bpmn:documentation>A customer care agent agrees an electricity source with the customer when no option could be proposed.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:serviceTask id="_f985e877-656d-5ae5-b60f-891a9b961496" name="Recommend plan" awa:actorType="ai_agent">
      <bpmn:documentation>Recommend the plan that suits the household, with its estimated annual cost, putting the customer's preference first when it is eligible.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"procedure":"Read the eligible plans and the customer profile. Estimate the annual cost of the customer's preferred plan and of the other eligible plans with the tariff tool. Recommend the preferred plan when it is eligible; otherwise the cheapest eligible plan for the profile. Give the reasons."}</awa:properties>
        <awa:tools>[{"name":"estimate_annual_cost","description":"Estimate the annual cost of a plan for a consumption, a region and an electricity source, from the tariff catalogue.","parameters":{"type":"object","required":["plan","annual_consumption_kwh","region"],"properties":{"plan":{"type":"string","enum":["fixed_12","fixed_24","variable","time_of_use","ev","prosumer"]},"annual_consumption_kwh":{"type":"number"},"region":{"type":"string"},"electricity_source":{"type":"string"}}},"binding":{"kind":"http","method":"GET","url":"http://localhost:4545/tariffs/v1/plans/{plan}/estimate","headers":{"x-api-key":"{{secret:TARIFF_API_KEY}}"}}}]</awa:tools>
        <awa:contextBindings>[{"context_id":"c261d481-061b-5cb9-8860-765b666b6b14","access_mode":"read"}]</awa:contextBindings>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["recommended_plan","estimated_annual_cost_eur","alternatives","reasons"],"properties":{"recommended_plan":{"type":"string","enum":["fixed_12","fixed_24","variable","time_of_use","ev","prosumer"]},"estimated_annual_cost_eur":{"type":"number","exclusiveMinimum":0},"alternatives":{"type":"array","items":{"type":"object","required":["plan","estimated_annual_cost_eur"],"properties":{"plan":{"type":"string","enum":["fixed_12","fixed_24","variable","time_of_use","ev","prosumer"]},"estimated_annual_cost_eur":{"type":"number"}}}},"reasons":{"type":"string","minLength":20},"follows_preference":{"type":"boolean"}}},"postconditions":[{"name":"Has a cost","expression":"estimated_annual_cost_eur &gt; 0"}],"budgets":{"max_attempts":2,"max_tool_calls":8}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="_0450e481-722d-5d46-b28d-47637791b4cb" name="Confirm plan by phone">
      <bpmn:documentation>A customer care agent calls the household, which has not confirmed a plan, and records the plan and source they choose.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["plan"],"properties":{"plan":{"type":"string","enum":["fixed_12","fixed_24","variable","time_of_use","ev","prosumer"]},"source_offered":{"type":"string","enum":["renewable_100","local_community","low_carbon_mix","standard_mix"]}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:callActivity id="_b3c0ba68-13a0-5531-a7eb-5ed16fb92d4e" name="Register grid export" calledElement="_ebe78a2a-8a36-5aa5-a537-a6f739b0ea83">
      <bpmn:documentation>Register the home's generation for export to the grid, by running the Grid Export Registration workflow.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"subworkflow":{"input":{"application_id":"application_id","metering_point_id":"metering_point_id","technology":"generation_technology","capacity_kw":"generation_capacity_kw","installation":"installation","installation_documents":"installation_documents"},"output":{"export_status":"export_status","export_registration_id":"export_registration_id","approved_export_kw":"approved_export_kw","export_tariff_eur_per_kwh":"export_tariff_eur_per_kwh","installation_class":"installation_class"}}}</awa:properties>
        <awa:outcomeContract>{"postconditions":[{"name":"Says how the registration ended","expression":"export_status exists"}]}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:userTask id="_d6504c34-ece3-5af9-9683-3248e2be2cce" name="Agree another plan">
      <bpmn:documentation>The export was not registered, so the prosumer plan cannot apply: a customer care agent agrees another plan with the customer.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["plan"],"properties":{"plan":{"type":"string","enum":["fixed_12","fixed_24","variable","time_of_use","ev"]}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="_c3c8e8ce-0919-5170-8e64-f6310f963aea" name="Generate contract">
      <bpmn:documentation>Generate the supply contract, with the 14-day cooling-off period, and send it for e-signature.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"generate_contract","description":"Generate the supply contract for e-signature, with the plan, the source, the export tariff and the cooling-off period.","parameters":{"type":"object","required":["application_id","customer_id","plan","electricity_source"],"properties":{"application_id":{"type":"string"},"customer_id":{"type":"string"},"plan":{"type":"string","enum":["fixed_12","fixed_24","variable","time_of_use","ev","prosumer"]},"electricity_source":{"type":"string","enum":["renewable_100","local_community","low_carbon_mix","standard_mix"]},"export_tariff_eur_per_kwh":{"type":["number","null"]},"deposit_eur":{"type":"number"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/contracts/v1/contracts","headers":{"authorization":"Bearer {{secret:CONTRACTS_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_48becd74-8b0d-589e-b84f-5280fe9019d2" name="Set up account and direct debit">
      <bpmn:documentation>Open the billing account and register the direct debit mandate.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"create_billing_account","description":"Open the billing account and register the direct debit mandate.","parameters":{"type":"object","required":["customer_id","contract_id","mandate_reference"],"properties":{"customer_id":{"type":"string"},"contract_id":{"type":"string"},"mandate_reference":{"type":"string"},"billing_day":{"type":"number"}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4545/billing/rpc","method":"billing.create_account"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_19bc48f1-65c2-507c-9282-8299568172ca" name="Collect deposit">
      <bpmn:documentation>Collect the security deposit eligibility asked for.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"collect_deposit","description":"Collect a security deposit by direct debit.","parameters":{"type":"object","required":["account_id","amount_eur"],"properties":{"account_id":{"type":"string"},"amount_eur":{"type":"number","exclusiveMinimum":0}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4545/billing/rpc","method":"billing.collect_deposit"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_7df7ca37-d53d-57d1-81ad-5d98b023699e" name="Request supplier switch">
      <bpmn:documentation>Ask the registry to switch the supply from the current supplier.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"request_switch","description":"Ask the metering-point registry to switch the supply to this supplier.","parameters":{"type":"object","required":["metering_point_id","customer_id","contract_id"],"properties":{"metering_point_id":{"type":"string"},"customer_id":{"type":"string"},"contract_id":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/registry/v1/switches","headers":{"authorization":"Bearer {{secret:REGISTRY_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_51ba2b3b-2919-5a35-ae39-790ce7bdfbb7" name="Write welcome pack" awa:actorType="ai_agent">
      <bpmn:documentation>Write the personalised welcome message: the plan, the electricity source, the supply start date and, for a home that exports, the export tariff.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"guardrails":[{"id":"57de6ffc-d7a8-58de-99fd-8156266943df","name":"No bank or phone numbers in the welcome message","stages":["output"],"check":{"kind":"personal_data","categories":["iban","phone"]},"action":"redact"}]}</awa:properties>
        <awa:contextBindings>[{"context_id":"c261d481-061b-5cb9-8860-765b666b6b14","access_mode":"read"}]</awa:contextBindings>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["message","tone","facts"],"properties":{"message":{"type":"string","minLength":120},"tone":{"type":"string","enum":["warm","neutral"]},"facts":{"type":"object","required":["plan","electricity_source","supply_start_date","export_tariff_eur_per_kwh"],"properties":{"plan":{"type":"string","enum":["fixed_12","fixed_24","variable","time_of_use","ev","prosumer"]},"electricity_source":{"type":"string","enum":["renewable_100","local_community","low_carbon_mix","standard_mix"]},"supply_start_date":{"type":"string"},"export_tariff_eur_per_kwh":{"type":["number","null"]}}}}},"postconditions":[{"name":"Warm or neutral in tone","expression":"tone == warm || tone == neutral"},{"name":"States the plan","expression":"facts.plan exists"},{"name":"States the supply start date","expression":"facts.supply_start_date exists"}]}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_f2a7a165-a6ce-52b2-b50b-2268aae16f56" name="Activate customer">
      <bpmn:documentation>Mark the customer active from the supply start date and send the welcome pack.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"activate_customer","description":"Mark the customer active in the customer platform from the supply start date.","parameters":{"type":"object","required":["customer_id","supply_start_date"],"properties":{"customer_id":{"type":"string"},"supply_start_date":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/crm/v1/customers/{customer_id}/activation","headers":{"authorization":"Bearer {{secret:CRM_TOKEN}}"}}},{"name":"send_message","description":"Send a message to the customer by e-mail, text message or post, through the notification service.","parameters":{"type":"object","required":["application_id","channel","template"],"properties":{"application_id":{"type":"string"},"channel":{"type":"string","enum":["email","sms","post"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/notifications/v1/messages","headers":{"authorization":"Bearer {{secret:NOTIFY_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_2709e085-fec6-5d05-90e0-ffcadbf26836" name="Cancel account and mandate" isForCompensation="true">
      <bpmn:documentation>Close the billing account and cancel the direct debit mandate of a switch that did not happen.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"cancel_billing_account","description":"Close a billing account and cancel its direct debit mandate.","parameters":{"type":"object","required":["account_id","reason"],"properties":{"account_id":{"type":"string"},"reason":{"type":"string"}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4545/billing/rpc","method":"billing.cancel_account"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_4fbe65e4-6f9c-5328-87be-94ca9fbc19e2" name="Refund deposit" isForCompensation="true">
      <bpmn:documentation>Refund the deposit of a switch that did not happen.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"refund_deposit","description":"Refund a security deposit.","parameters":{"type":"object","required":["deposit_id","amount_eur"],"properties":{"deposit_id":{"type":"string"},"amount_eur":{"type":"number"}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4545/billing/rpc","method":"billing.refund_deposit"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Compensation_48becd74-8b0d-589e-b84f-5280fe9019d2" attachedToRef="_48becd74-8b0d-589e-b84f-5280fe9019d2">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_48becd74-8b0d-589e-b84f-5280fe9019d2" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Compensation_19bc48f1-65c2-507c-9282-8299568172ca" attachedToRef="_19bc48f1-65c2-507c-9282-8299568172ca">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_19bc48f1-65c2-507c-9282-8299568172ca" />
    </bpmn:boundaryEvent>
    <bpmn:startEvent id="_7d65a424-9443-5447-84e8-d4cb46a25499" name="Application received">
      <bpmn:documentation>A household applies to become a customer on the web form.</bpmn:documentation>
      <bpmn:messageEventDefinition id="MessageEventDefinition_7d65a424-9443-5447-84e8-d4cb46a25499" messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="_a4869700-6441-5bff-9d46-f4f7452d74fd" name="Documents uploaded">
      <bpmn:documentation>Wait for the supporting documents.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"application_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_a4869700-6441-5bff-9d46-f4f7452d74fd" messageRef="Message_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="_71f05bf6-9de0-50f7-adce-24fbd030b7ae" name="Documents uploaded after reminder">
      <bpmn:documentation>Wait once more after the reminder.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"application_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_71f05bf6-9de0-50f7-adce-24fbd030b7ae" messageRef="Message_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_ad813dfd-06ad-5a80-a9c3-95eb240f9f6e" name="Documents checked">
      <bpmn:documentation>The documents are verified: the credit check and the metering point lookup start in parallel.</bpmn:documentation>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_d39216a8-f8d6-59c2-992f-5a7acdb4f689" name="Checks complete">
      <bpmn:documentation>Both checks are back.</bpmn:documentation>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_83a3cd5a-a6e3-562d-b723-104aeadfc928" name="Applicant verified">
      <bpmn:documentation>Tell other systems and the journey the applicant is verified.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["application_id","eligibility","deposit_required"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_83a3cd5a-a6e3-562d-b723-104aeadfc928" messageRef="Message_3" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="_4f909882-f33b-5f3a-b204-f369f69cd8c5" name="Plan confirmed">
      <bpmn:documentation>Wait for the customer to confirm the plan in the portal.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"application_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_4f909882-f33b-5f3a-b204-f369f69cd8c5" messageRef="Message_4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_3d9209b8-137a-5518-846f-01f72b359089" name="Plan chosen">
      <bpmn:documentation>Tell other systems and the journey which plan and source the household chose.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["application_id","plan","source_offered"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_3d9209b8-137a-5518-846f-01f72b359089" messageRef="Message_5" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_6b006125-02d3-5003-ba39-7ef3e8aece1c" name="Grid export settled">
      <bpmn:documentation>Tell other systems and the journey how the export registration ended.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["application_id","export_status","export_registration_id","approved_export_kw","export_tariff_eur_per_kwh"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_6b006125-02d3-5003-ba39-7ef3e8aece1c" messageRef="Message_6" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="_8029a17c-5fae-5d7d-91f9-bbe33449f345" name="Contract signed">
      <bpmn:documentation>Wait for the e-signature service to report the signed contract.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"application_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_8029a17c-5fae-5d7d-91f9-bbe33449f345" messageRef="Message_7" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="_721661b5-6756-569b-998b-bb7466a7a890" name="Switch completed">
      <bpmn:documentation>Wait for the registry to confirm the switch. If it has not by the deadline the wait fails the run (EVENT_TIMEOUT), and compensation cancels the deposit, the account and the mandate.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"application_id","timeout":"P21D"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_721661b5-6756-569b-998b-bb7466a7a890" messageRef="Message_8" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_470b4299-1cfc-5aed-b695-c33a1992290e" name="Customer activated">
      <bpmn:documentation>Tell other systems and the journey the customer is active.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["application_id","customer_id","customer_active","plan","source_offered","supply_start_date"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_470b4299-1cfc-5aed-b695-c33a1992290e" messageRef="Message_9" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_a0aaf1e4-0bc0-55e9-8683-fd48ef350a46" name="Application abandoned">
      <bpmn:documentation>Tell other systems and the journey the application was abandoned.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["application_id","abandoned_reason"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_a0aaf1e4-0bc0-55e9-8683-fd48ef350a46" messageRef="Message_10" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_6b49bba5-d4f2-559a-8e94-7715e4d6de37" name="Application declined">
      <bpmn:documentation>Tell other systems and the journey the application was declined.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["application_id","decline_reason"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_6b49bba5-d4f2-559a-8e94-7715e4d6de37" messageRef="Message_11" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="_39d5ee68-c241-5937-982d-e4a8c4f1d538" name="Customer active" />
    <bpmn:endEvent id="_fe02b392-c487-5f88-bdd0-b71e22efa80c" name="Abandoned" />
    <bpmn:endEvent id="_b3638dfc-5dc0-5cf8-b2b2-00533f5cfa8e" name="Declined" />
    <bpmn:businessRuleTask id="_84ae3333-dcd3-523b-a95a-2e82d9efb112" name="Required documents" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_84ae3333-dcd3-523b-a95a-2e82d9efb112">
      <bpmn:documentation>The documents an application needs: three for every household, four more for a home with its own generation.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="_480e4f31-b458-5bf1-92c1-8c7678820b1c" name="Eligibility" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_480e4f31-b458-5bf1-92c1-8c7678820b1c">
      <bpmn:documentation>Whether the supplier takes the household on, from the credit band, outstanding energy debt and the identity check. The limits are examples each supplier sets.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="_9580a223-1fd5-5b6a-9bb3-5a40a52dae9d" name="Electricity source" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_9580a223-1fd5-5b6a-9bb3-5a40a52dae9d">
      <bpmn:documentation>Whether the source the customer chose is offered in their region. When it is not, an energy advisor model proposes the closest source that is.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:decisionModel>{"model":"tier:fast","instructions":"The customer chose an electricity source that is not offered in their region. Propose the available source closest to what they asked for: keep a renewable choice renewable, and a local choice as close to local generation as the region allows. Give the reason in one sentence the customer can read.","options":[{"id":"renewable_100","description":"100% renewable electricity backed by guarantees of origin, available in every region","output_edge_id":"04b8c062-7f43-5e34-b863-7ba5852e6351"},{"id":"low_carbon_mix","description":"A low-carbon mix of renewable and nuclear generation, available in every region","output_edge_id":"04b8c062-7f43-5e34-b863-7ba5852e6351"},{"id":"standard_mix","description":"The standard supply mix, available in every region","output_edge_id":"04b8c062-7f43-5e34-b863-7ba5852e6351"}],"inputs":["electricity_source","region","annual_consumption_kwh","has_generation"],"output":"source_offered","min_confidence":0.6}</awa:decisionModel>
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="_34dd0365-c442-55d2-ad09-e6cf1cfd0773" name="Plan eligibility" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_34dd0365-c442-55d2-ad09-e6cf1cfd0773">
      <bpmn:documentation>The plans the household may choose: time-of-use needs a smart meter, the electric vehicle plan a declared charger, the prosumer plan home generation to register for export, the 24-month plan no deposit.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:eventBasedGateway id="Wait_a4869700-6441-5bff-9d46-f4f7452d74fd" />
    <bpmn:intermediateCatchEvent id="Timeout_a4869700-6441-5bff-9d46-f4f7452d74fd" name="Documents uploaded: no event within P7D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_a4869700-6441-5bff-9d46-f4f7452d74fd">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Wait_71f05bf6-9de0-50f7-adce-24fbd030b7ae" />
    <bpmn:intermediateCatchEvent id="Timeout_71f05bf6-9de0-50f7-adce-24fbd030b7ae" name="Documents uploaded after reminder: no event within P7D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_71f05bf6-9de0-50f7-adce-24fbd030b7ae">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Wait_4f909882-f33b-5f3a-b204-f369f69cd8c5" />
    <bpmn:intermediateCatchEvent id="Timeout_4f909882-f33b-5f3a-b204-f369f69cd8c5" name="Plan confirmed: no event within P14D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_4f909882-f33b-5f3a-b204-f369f69cd8c5">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Wait_8029a17c-5fae-5d7d-91f9-bbe33449f345" />
    <bpmn:intermediateCatchEvent id="Timeout_8029a17c-5fae-5d7d-91f9-bbe33449f345" name="Contract signed: no event within P14D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_8029a17c-5fae-5d7d-91f9-bbe33449f345">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:parallelGateway id="Join_d39216a8-f8d6-59c2-992f-5a7acdb4f689" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="Route_dccac1ce-1941-54da-8e97-a1cf475c74ff" gatewayDirection="Diverging" default="_6525f8a5-9a9d-5ff0-9d2a-ce53a7279a9a" />
    <bpmn:exclusiveGateway id="Route_48becd74-8b0d-589e-b84f-5280fe9019d2" gatewayDirection="Diverging" default="_87e2b32e-6140-5486-b374-a4083d62167c" />
    <bpmn:exclusiveGateway id="Route_ad813dfd-06ad-5a80-a9c3-95eb240f9f6e" gatewayDirection="Diverging" />
    <bpmn:exclusiveGateway id="Route_3d9209b8-137a-5518-846f-01f72b359089" gatewayDirection="Diverging" default="_3e783fac-eda9-5ac2-9dfd-b6ec79d6d659" />
    <bpmn:exclusiveGateway id="Route_6b006125-02d3-5003-ba39-7ef3e8aece1c" gatewayDirection="Diverging" default="_396d08d7-849c-5ccc-9d10-bbf522c3f49a" />
    <bpmn:exclusiveGateway id="Route_480e4f31-b458-5bf1-92c1-8c7678820b1c" gatewayDirection="Diverging" default="_a0a810cb-a1ff-599a-b81f-354840682dac" />
    <bpmn:exclusiveGateway id="Route_9580a223-1fd5-5b6a-9bb3-5a40a52dae9d" gatewayDirection="Diverging" default="_f5feafe7-76d1-55c7-a27f-1eca46cb2f1c" />
