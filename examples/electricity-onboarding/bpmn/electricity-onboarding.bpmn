  <bpmn:process id="_ebe78a2a-8a36-5aa5-a537-a6f739b0ea83" name="Grid Export Registration" isExecutable="true">
    <bpmn:documentation>Registers a home's own generation for export to the grid: checks the installation documents, classifies the installation by technology and capacity, files a simplified notification or obtains the grid operator's approval, and registers the export meter and tariff.</bpmn:documentation>
    <bpmn:extensionElements>
      <awa:properties>{"$schema":"https://awa.io/schema/awa.schema.json"}</awa:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_ebe78a2a-8a36-5aa5-a537-a6f739b0ea83">
      <bpmn:lane id="_2753f34c-59df-5498-8432-fb54f8719dfe" name="Installation verifier" awa:actorType="ai_agent">
        <bpmn:documentation>Checks installers' certificates, compliance certificates and commissioning reports, and that the serial numbers agree.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["document extraction","electrical certificates"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:reasoning","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_e85ae5c0-61e2-59cb-9d7a-776df3813e0f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_ae4589d5-75e5-532f-a61d-1bbe15a6c8ca" name="Grid connection service" awa:actorType="application">
        <bpmn:documentation>Files notifications with the grid operator and records the outcome.</bpmn:documentation>
        <bpmn:flowNodeRef>_53c873be-d456-5c2a-a459-1713160c788a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_df2c6915-6414-51a0-9121-055366c3d963</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_5129c05e-f0bb-5abd-b36f-56971f0693b8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_15cb571d-d8fd-5d35-85e4-14431632055a" name="Grid engineer" awa:actorType="human">
        <bpmn:documentation>Approves the export of a medium installation for the grid operator.</bpmn:documentation>
        <bpmn:flowNodeRef>_2864f139-34e9-5b44-9672-ef146b57c730</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_431de99e-a89b-5990-8bea-a67001d4a219</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_45a945c8-72a7-5a39-9064-8a4f16a4c78a" name="Meter-data system" awa:actorType="application">
        <bpmn:documentation>Holds metering points, export meters and their tariffs.</bpmn:documentation>
        <bpmn:flowNodeRef>_527df5b8-a81f-5ac4-aadf-2f7520d9e957</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="_e85ae5c0-61e2-59cb-9d7a-776df3813e0f" name="Verify installation documents" awa:actorType="ai_agent">
      <bpmn:documentation>Check the installer's certificate, the generator or inverter compliance certificate, the commissioning report and the proof of ownership, and that the serial numbers on them agree.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"procedure":"Extract each installation document with the document tool. Compare the inverter or generator serial number on the compliance certificate with the one on the commissioning report. Compare the capacity declared on the application with the rated capacity on the certificate. Note anything that does not agree. Say how sure you are.","guardrails":[{"id":"c69d1a81-16c2-5eea-868b-11ce7891e209","name":"Instructions inside uploaded documents","stages":["tool_result"],"check":{"kind":"prompt_injection"},"action":"block","tools":["extract_document"]},{"id":"86be291d-e7ac-592e-951a-917ba282281c","name":"Personal data in the verifier's notes","stages":["output"],"check":{"kind":"personal_data","categories":["email","phone","iban"]},"fields":["notes"],"action":"redact"}]}</awa:properties>
        <awa:tools>[{"name":"extract_document","description":"Read an uploaded document: its type, whether it is legible, the fields printed on it and its text.","parameters":{"type":"object","required":["file_id","document_type"],"properties":{"file_id":{"type":"string"},"document_type":{"type":"string"},"application_id":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/documents/v1/extractions","headers":{"x-api-key":"{{secret:DOCUMENTS_API_KEY}}"}}}]</awa:tools>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["installation_valid","serials_match","rated_capacity_kw","unchecked_count","unreadable_count","confidence","notes"],"properties":{"installation_valid":{"type":"boolean"},"serials_match":{"type":"boolean"},"rated_capacity_kw":{"type":"number","exclusiveMinimum":0},"unchecked_count":{"type":"integer","minimum":0},"unreadable_count":{"type":"integer","minimum":0},"confidence":{"type":"number","minimum":0,"maximum":1},"notes":{"type":"string","minLength":10}}},"postconditions":[{"name":"Every installation document is checked","expression":"unchecked_count == 0"},{"name":"Every installation document is legible","expression":"unreadable_count == 0"},{"name":"Serial numbers agree","expression":"serials_match == true"},{"name":"Sure enough to act on","expression":"confidence &gt;= 0.75"}],"budgets":{"max_attempts":2,"max_duration":"PT5M","max_tokens":30000,"max_tool_calls":8},"on_violation":"escalate_human"}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_53c873be-d456-5c2a-a459-1713160c788a" name="Send simplified notification">
      <bpmn:documentation>File the simplified notification of a small installation with the grid operator.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"notify_grid_operator","description":"File a simplified notification of a small generating installation with the grid operator.","parameters":{"type":"object","required":["metering_point_id","technology","capacity_kw"],"properties":{"metering_point_id":{"type":"string"},"technology":{"type":"string"},"capacity_kw":{"type":"number"},"inverter_serial":{"type":"string"},"commissioned_on":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4545/grid/v1/notifications","headers":{"authorization":"Bearer {{secret:GRID_OPERATOR_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="_2864f139-34e9-5b44-9672-ef146b57c730" name="Grid operator approval">
      <bpmn:documentation>A grid engineer approves the export of a medium installation, and the capacity that may be exported.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["approved"],"properties":{"approved":{"type":"boolean"},"approved_export_kw":{"type":"number","minimum":0},"note":{"type":"string"}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="_431de99e-a89b-5990-8bea-a67001d4a219" name="Grid operator approval, two engineers">
      <bpmn:documentation>Two grid engineers approve the export of an installation above the four-eyes threshold; the deployment's four-eyes rule makes the second approval necessary.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["approved"],"properties":{"approved":{"type":"boolean"},"approved_export_kw":{"type":"number","minimum":0},"note":{"type":"string"}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="_df2c6915-6414-51a0-9121-055366c3d963" name="Refer to commercial team">
      <bpmn:documentation>Open a case for the commercial team, who agree a large installation's export individually.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_5129c05e-f0bb-5abd-b36f-56971f0693b8" name="Record export refusal">
      <bpmn:documentation>Record that the grid operator did not approve the export.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_527df5b8-a81f-5ac4-aadf-2f7520d9e957" name="Register export meter and tariff">
      <bpmn:documentation>Register the export meter and the export tariff with the meter-data system.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"register_export","description":"Register the export meter and the export tariff with the meter-data system.","parameters":{"type":"object","required":["metering_point_id","approved_export_kw","technology"],"properties":{"metering_point_id":{"type":"string"},"approved_export_kw":{"type":"number"},"technology":{"type":"string"}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4545/meter-data/rpc","method":"meterdata.register_export"}}]</awa:tools>
        <awa:retry>{"max_attempts":3,"initial_delay":"PT1S"}</awa:retry>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:startEvent id="_199cb027-8feb-5898-933e-16a9652b2358" name="Export registration requested">
      <bpmn:documentation>The onboarding of a home with its own generation asks for its export to be registered.</bpmn:documentation>
    </bpmn:startEvent>
    <bpmn:endEvent id="_64a88e19-9d34-5441-9351-ce72e338a883" name="Export registered" />
    <bpmn:endEvent id="_6236b9cc-f35d-5802-9c66-c63c2b5984d4" name="Export not registered" />
    <bpmn:businessRuleTask id="_09068ea1-5618-5f81-b4c5-d9082e024324" name="Classify installation" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_09068ea1-5618-5f81-b4c5-d9082e024324">
      <bpmn:documentation>What the grid operator needs, from the technology and the capacity. THE THRESHOLDS ARE EXAMPLES: they differ by country and by grid operator, and each operator edits this table.</bpmn:documentation>
    </bpmn:businessRuleTask>
