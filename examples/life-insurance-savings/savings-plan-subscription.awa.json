{
  "$schema": "https://awa.io/schema/awa.schema.json",
  "id": "51bb950b-7579-5ee2-81fb-4e1e29d7c18f",
  "name": "Savings Plan Subscription",
  "version": "1.0.0",
  "awa_version": "1.1",
  "description": "Subscribes an employee to the plan: proposes unit-linked funds or a model portfolio with their key information documents, checks the choice against the risk profile, runs the due diligence as a child run, reviews the beneficiary clause, has the contract signed, issues the policy, sets up the payroll deduction, invests the first premium and keeps the 30 days in which the employee may cancel with a full refund.",
  "sla": {
    "id": "71185281-781e-55db-8ba1-17005f33161f",
    "name": "Policy in force within two months of the profile",
    "target_time": "P60D",
    "max_time": "P90D",
    "escalation_policy": {
      "breach_action": "record",
      "notify_roles": [
        "50553dac-90de-578f-9aad-f97f51b13ed5"
      ]
    }
  },
  "roles": [
    {
      "id": "a53afcdd-729b-5cdb-919a-1f7dbbf0830d",
      "name": "AI adviser",
      "actor_type": "ai_agent",
      "description": "Proposes funds within the profile and warns, in plain words, when a choice goes beyond it.",
      "capabilities": [
        "unit-linked funds",
        "key information documents"
      ],
      "ai_model_config": {
        "model_id": "tier:balanced",
        "temperature": 0.2
      }
    },
    {
      "id": "51e7044f-e4b6-5c60-b947-b03ad660d7b5",
      "name": "Fund platform",
      "actor_type": "application",
      "description": "The range of unit-linked funds and model portfolios, with their key information documents and summary risk indicators."
    },
    {
      "id": "e51d88ee-5990-5af3-8c27-3d7220017a38",
      "name": "Licensed adviser",
      "actor_type": "human",
      "description": "Discusses a choice above the profile with the employee."
    },
    {
      "id": "048cfcae-b06d-535b-a8c4-58474b7c05f2",
      "name": "Compliance officer",
      "actor_type": "human",
      "description": "Approves, or not, a choice above the profile the employee insists on."
    },
    {
      "id": "6a8a7187-1b85-5846-83a6-a35663eb4992",
      "name": "Due diligence desk",
      "actor_type": "application",
      "description": "Runs the customer due diligence; the work is done by the Identity, AML and Tax Residence Checks workflow."
    },
    {
      "id": "ceedbcfc-b6be-55df-be0b-63a7f5ec2454",
      "name": "Contract checker",
      "actor_type": "ai_agent",
      "description": "Checks a beneficiary clause is complete and unambiguous.",
      "capabilities": [
        "beneficiary clauses"
      ],
      "ai_model_config": {
        "model_id": "tier:balanced",
        "temperature": 0.2
      }
    },
    {
      "id": "393242a7-7977-53d9-a8cb-17c40bf689d9",
      "name": "E-signature service",
      "actor_type": "application",
      "description": "Sends documents for qualified e-signature and reports them signed."
    },
    {
      "id": "50553dac-90de-578f-9aad-f97f51b13ed5",
      "name": "Policy administration",
      "actor_type": "application",
      "description": "Valoria Life's policy administration system."
    },
    {
      "id": "60c53a0b-0655-5bdc-a434-e40619468524",
      "name": "Employer payroll",
      "actor_type": "application",
      "description": "Kestrel's payroll system, which deducts the contribution from the salary and pays it to the insurer."
    },
    {
      "id": "df800a2c-a94f-5992-a4ea-b21f93f96b2f",
      "name": "Custodian bank",
      "actor_type": "application",
      "description": "The custodian bank that holds the assets covering the policies, apart from the insurer's own."
    },
    {
      "id": "2617bb5c-c57d-51f3-a904-086f3db57d63",
      "name": "HR portal",
      "actor_type": "application",
      "description": "The HR portal Valoria Life provides to the employer."
    },
    {
      "id": "83161e21-2b66-557b-807f-cb53d923044d",
      "name": "Back-office administrator",
      "actor_type": "human",
      "description": "Valoria Life's back-office, who takes over a file an agent could not settle."
    }
  ],
  "events": [
    {
      "id": "538b268e-e50d-5ad3-8db9-54671fd19de8",
      "name": "Profile completed",
      "event_type": "start",
      "description": "The employee's profile is known: the subscription starts.",
      "event_definition": {
        "name": "profile.completed"
      }
    },
    {
      "id": "a5f61c4d-f860-50c7-b0df-c1ced688aa37",
      "name": "Investments chosen",
      "event_type": "message",
      "description": "Wait for the employee's choice of funds in the portal.",
      "event_definition": {
        "name": "investments.chosen",
        "correlation_key": "enrolment_id",
        "timeout": "P14D",
        "timeout_edge_id": "7adad2c2-0e78-59fd-95c8-8cca6befa9db"
      }
    },
    {
      "id": "6af23654-f6e1-5622-ab7b-0c5f8329ae2d",
      "name": "Choice reconsidered",
      "event_type": "message",
      "description": "Wait for the employee to adjust the choice, or to keep it and acknowledge the risk.",
      "event_definition": {
        "name": "investments.reconsidered",
        "correlation_key": "enrolment_id",
        "timeout": "P14D",
        "timeout_edge_id": "4c45bcb0-443b-5c22-af0a-a1ac797c69a9"
      }
    },
    {
      "id": "46d43db2-8216-5573-8432-b0804eea5010",
      "name": "Investments confirmed",
      "event_type": "message",
      "description": "Tell the journey the investments are settled.",
      "event_definition": {
        "name": "investments.confirmed",
        "mode": "publish",
        "data": [
          "enrolment_id",
          "allocation",
          "portfolio_sri",
          "allocation_confirmed"
        ]
      }
    },
    {
      "id": "6cf047d2-369b-5e24-b425-8311e33b1ffc",
      "name": "Subscription form submitted",
      "event_type": "message",
      "description": "Wait for the subscription form: documents, tax self-certification, beneficiary clause, monthly contribution.",
      "event_definition": {
        "name": "subscription.submitted",
        "correlation_key": "enrolment_id",
        "timeout": "P14D",
        "timeout_edge_id": "8d0a8ea5-5b3b-5e01-863f-f1e3d6ff65eb"
      }
    },
    {
      "id": "edd322e0-f06e-5878-8284-eb0d5975c7c8",
      "name": "Contract signed",
      "event_type": "message",
      "description": "Wait for the e-signature service to report the signed contract.",
      "event_definition": {
        "name": "contract.signed",
        "correlation_key": "enrolment_id",
        "timeout": "P14D",
        "timeout_edge_id": "a92a5f58-32cc-5de0-913a-ce460134daa9"
      }
    },
    {
      "id": "9477f38c-cc91-56e1-b6aa-8987a1c50121",
      "name": "First premium received",
      "event_type": "message",
      "description": "Wait for the first payroll contribution. If none comes in 45 days the wait fails the run (EVENT_TIMEOUT), and compensation stops the deduction and cancels the policy.",
      "event_definition": {
        "name": "payroll.contribution_paid",
        "correlation_key": "enrolment_id",
        "timeout": "P45D"
      }
    },
    {
      "id": "d75ac4f9-ff37-5af8-a321-ab29daf1d9b2",
      "name": "Policy issued",
      "event_type": "message",
      "description": "Tell the journey the policy is issued and the first premium invested.",
      "event_definition": {
        "name": "policy.issued",
        "mode": "publish",
        "data": [
          "enrolment_id",
          "policy_id",
          "policy_issued",
          "plan_id",
          "employee",
          "monthly_contribution_eur",
          "allocation",
          "max_sri",
          "premiums_paid_eur",
          "tax_year",
          "deduction_id"
        ]
      }
    },
    {
      "id": "2534910f-c442-5d68-a4a0-0a4ad090c7d0",
      "name": "Cooling-off period",
      "event_type": "message",
      "description": "The 30 days in which the employee may cancel. A cancellation is the journey's exit policy.cancellation_requested: the host withdraws this run and compensation undoes the issue, the investment and the deduction. At the deadline, or when the policy administration closes the period, the policy is in force.",
      "event_definition": {
        "name": "cooling_off.ended",
        "correlation_key": "enrolment_id",
        "timeout": "P30D",
        "timeout_edge_id": "3a67da7d-7765-53e7-8682-516d003c4e7d"
      }
    },
    {
      "id": "07b34480-bd39-5128-a84c-340bd756e369",
      "name": "Policy in force",
      "event_type": "message",
      "description": "Tell the journey the policy is in force.",
      "event_definition": {
        "name": "policy.in_force",
        "mode": "publish",
        "data": [
          "enrolment_id",
          "policy_id",
          "policy_in_force",
          "in_force_on",
          "premiums_paid_eur"
        ]
      }
    },
    {
      "id": "d8bb94a2-b80c-57de-873b-0506711ccf39",
      "name": "Subscription closed",
      "event_type": "message",
      "description": "Tell the journey the subscription was not completed.",
      "event_definition": {
        "name": "subscription.lapsed",
        "mode": "publish",
        "data": [
          "enrolment_id",
          "lapsed_reason"
        ]
      }
    },
    {
      "id": "8560818d-e47a-5a63-9db7-630b0865bcab",
      "name": "Subscription refused",
      "event_type": "message",
      "description": "Tell the journey the subscription was refused after due diligence.",
      "event_definition": {
        "name": "subscription.refused",
        "mode": "publish",
        "data": [
          "enrolment_id",
          "refusal_reason"
        ]
      }
    },
    {
      "id": "d344b08f-38ff-58e0-baaa-b9e61f18d9de",
      "name": "Plan in force",
      "event_type": "end"
    },
    {
      "id": "325581ab-63b4-5ee2-bc7c-62bdf7d43567",
      "name": "Not subscribed",
      "event_type": "end"
    },
    {
      "id": "8454c33e-9881-591b-a5f8-f854ce2c12e0",
      "name": "Refused",
      "event_type": "end"
    }
  ],
  "activities": [
    {
      "id": "712db9d0-6232-5c79-b2fc-767fce4145ce",
      "name": "Propose investments",
      "role_id": "a53afcdd-729b-5cdb-919a-1f7dbbf0830d",
      "actor_type": "ai_agent",
      "description": "Propose the model portfolio that fits the risk profile and the sustainability preferences, and the funds the employee may choose instead, each with its key information document.",
      "procedure": "List the plan's funds and model portfolios with the fund tool. Propose the model portfolio whose summary risk indicator fits the profile, taking the sustainability preferences into account. List the funds within the profile as alternatives. Give the key information document of every fund you name. Never state a guaranteed return.",
      "tools": [
        {
          "name": "list_funds",
          "description": "List the unit-linked funds and model portfolios of the plan, each with its key information document and its summary risk indicator.",
          "parameters": {
            "type": "object",
            "required": [
              "plan_id"
            ],
            "properties": {
              "plan_id": {
                "type": "string"
              },
              "max_sri": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "sustainability": {
                "type": "string"
              }
            }
          },
          "binding": {
            "kind": "http",
            "method": "GET",
            "url": "http://localhost:4560/funds/v1/plans/{plan_id}/funds",
            "headers": {
              "x-api-key": "{{secret:FUND_PLATFORM_KEY}}"
            }
          }
        }
      ],
      "outcome_contract": {
        "output_schema": {
          "type": "object",
          "required": [
            "proposed_allocation",
            "allocation_total",
            "max_fund_sri",
            "kids",
            "missing_kid_count",
            "explanation"
          ],
          "properties": {
            "proposed_allocation": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "fund_id",
                  "percent"
                ],
                "properties": {
                  "fund_id": {
                    "type": "string"
                  },
                  "percent": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  }
                }
              }
            },
            "allocation_total": {
              "type": "number"
            },
            "max_fund_sri": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "kids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "fund_id",
                  "kid_id"
                ],
                "properties": {
                  "fund_id": {
                    "type": "string"
                  },
                  "kid_id": {
                    "type": "string"
                  }
                }
              }
            },
            "missing_kid_count": {
              "type": "integer",
              "minimum": 0
            },
            "model_portfolio": {
              "type": "string"
            },
            "explanation": {
              "type": "string",
              "minLength": 60
            }
          }
        },
        "postconditions": [
          {
            "name": "The allocation adds up to 100%",
            "expression": "allocation_total == 100"
          },
          {
            "name": "Every fund named has its key information document",
            "expression": "missing_kid_count == 0"
          }
        ],
        "budgets": {
          "max_attempts": 2,
          "max_tool_calls": 4
        }
      }
    },
    {
      "id": "f2a8ecb0-a039-5bfb-afa6-b6503373232d",
      "name": "Check choice against profile",
      "role_id": "51e7044f-e4b6-5c60-b947-b03ad660d7b5",
      "actor_type": "application",
      "description": "Check the chosen allocation against the risk profile: its weighted summary risk indicator, the excess over the profile's maximum, and that every key information document was delivered.",
      "tools": [
        {
          "name": "check_allocation",
          "description": "Check an allocation against a risk profile: the weighted summary risk indicator, its excess over the profile's maximum, and whether every fund's key information document was delivered.",
          "parameters": {
            "type": "object",
            "required": [
              "allocation",
              "max_sri"
            ],
            "properties": {
              "allocation": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "fund_id",
                    "percent"
                  ],
                  "properties": {
                    "fund_id": {
                      "type": "string"
                    },
                    "percent": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 100
                    }
                  }
                }
              },
              "max_sri": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "enrolment_id": {
                "type": "string"
              }
            }
          },
          "binding": {
            "kind": "http",
            "method": "POST",
            "url": "http://localhost:4560/funds/v1/suitability-checks",
            "headers": {
              "x-api-key": "{{secret:FUND_PLATFORM_KEY}}"
            }
          }
        }
      ]
    },
    {
      "id": "3ac8e49e-a6b0-5154-bfa6-8b139dcc3c1b",
      "name": "Warn about the risk",
      "role_id": "a53afcdd-729b-5cdb-919a-1f7dbbf0830d",
      "actor_type": "ai_agent",
      "description": "Tell the employee, in plain words, that the choice is riskier than the profile allows, by how much, and what they can do: adjust it, or keep it and acknowledge the risk after talking to an adviser.",
      "tools": [
        {
          "name": "send_notification",
          "description": "Send the employee a message in the HR portal's inbox, by e-mail, or both.",
          "parameters": {
            "type": "object",
            "required": [
              "enrolment_id",
              "channel",
              "template"
            ],
            "properties": {
              "enrolment_id": {
                "type": "string"
              },
              "channel": {
                "type": "string",
                "enum": [
                  "portal",
                  "email",
                  "portal_and_email"
                ]
              },
              "template": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          },
          "binding": {
            "kind": "http",
            "method": "POST",
            "url": "http://localhost:4560/portal/v1/notifications",
            "headers": {
              "authorization": "Bearer {{secret:PORTAL_TOKEN}}"
            }
          }
        }
      ],
      "outcome_contract": {
        "output_schema": {
          "type": "object",
          "required": [
            "warning",
            "portfolio_sri_stated",
            "profile_stated",
            "options_given"
          ],
          "properties": {
            "warning": {
              "type": "string",
              "minLength": 80
            },
            "portfolio_sri_stated": {
              "type": "boolean"
            },
            "profile_stated": {
              "type": "boolean"
            },
            "options_given": {
              "type": "boolean"
            }
          }
        },
        "postconditions": [
          {
            "name": "States the choice's risk indicator",
            "expression": "portfolio_sri_stated == true"
          },
          {
            "name": "States the profile",
            "expression": "profile_stated == true"
          },
          {
            "name": "Says what the employee can do",
            "expression": "options_given == true"
          }
        ]
      }
    },
    {
      "id": "aa073b03-5054-5eb5-9396-a20c4fd577a2",
      "name": "Discuss the risk with an adviser",
      "role_id": "e51d88ee-5990-5af3-8c27-3d7220017a38",
      "actor_type": "human",
      "description": "A licensed adviser talks the choice through with an employee who wants to keep it, and records the employee's informed acknowledgement.",
      "outcome_contract": {
        "output_schema": {
          "type": "object",
          "required": [
            "acknowledgement_recorded",
            "note"
          ],
          "properties": {
            "acknowledgement_recorded": {
              "type": "boolean"
            },
            "note": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    {
      "id": "5be98006-cbad-5d8f-be5e-527840e3256a",
      "name": "Approve choice above profile",
      "role_id": "048cfcae-b06d-535b-a8c4-58474b7c05f2",
      "actor_type": "human",
      "description": "A compliance officer accepts, or not, a choice above the profile that the employee insists on. Whoever advised the employee on it may not approve it.",
      "outcome_contract": {
        "output_schema": {
          "type": "object",
          "required": [
            "approved",
            "allocation_confirmed"
          ],
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "allocation_confirmed": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "50dc64c6-2c14-56e2-848d-a960866e4298",
      "name": "Run identity and AML checks",
      "role_id": "6a8a7187-1b85-5846-83a6-a35663eb4992",
      "actor_type": "application",
      "description": "Run the customer due diligence by the Identity, AML and Tax Residence Checks workflow.",
      "is_expandable": true,
      "expansion_workflow_id": "d0fb8198-0fde-5fd9-8d79-2b3c558ca363",
      "subworkflow": {
        "input": {
          "enrolment_id": "enrolment_id",
          "employee": "employee",
          "documents": "documents",
          "self_certification": "self_certification",
          "tax_residence": "tax_residence"
        },
        "output": {
          "kyc_status": "kyc_status",
          "cdd_level": "cdd_level",
          "fatca_status": "fatca_status",
          "crs_reportable": "crs_reportable",
          "kyc_file_id": "kyc_file_id",
          "screening_result": "screening_result"
        }
      },
      "outcome_contract": {
        "postconditions": [
          {
            "name": "Says how the due diligence ended",
            "expression": "kyc_status exists"
          }
        ]
      }
    },
    {
      "id": "d5f45515-cadc-5ccb-b890-eadbabc5a25f",
      "name": "Review beneficiary clause",
      "role_id": "ceedbcfc-b6be-55df-be0b-63a7f5ec2454",
      "actor_type": "ai_agent",
      "description": "Check the beneficiary clause: the standard clause, or named beneficiaries each identified, with shares that add up to 100%.",
      "outcome_contract": {
        "output_schema": {
          "type": "object",
          "required": [
            "clause_type",
            "shares_total",
            "unidentified_count",
            "beneficiary_clause_valid"
          ],
          "properties": {
            "clause_type": {
              "type": "string",
              "enum": [
                "standard",
                "named"
              ]
            },
            "shares_total": {
              "type": "number"
            },
            "unidentified_count": {
              "type": "integer",
              "minimum": 0
            },
            "beneficiary_clause_valid": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "postconditions": [
          {
            "name": "Shares add up to 100%",
            "expression": "shares_total == 100"
          },
          {
            "name": "Every beneficiary is identified",
            "expression": "unidentified_count == 0"
          }
        ],
        "on_violation": "escalate_human"
      }
    },
    {
      "id": "de20ccd9-2e2a-5dee-ae78-ac63df97f0f8",
      "name": "Prepare contract for signature",
      "role_id": "393242a7-7977-53d9-a8cb-17c40bf689d9",
      "actor_type": "application",
      "description": "Send the contract, the beneficiary clause and the payroll deduction mandate for e-signature.",
      "tools": [
        {
          "name": "request_signature",
          "description": "Send the subscription contract, the beneficiary clause and the payroll deduction mandate for e-signature.",
          "parameters": {
            "type": "object",
            "required": [
              "enrolment_id",
              "documents"
            ],
            "properties": {
              "enrolment_id": {
                "type": "string"
              },
              "documents": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "signer_email": {
                "type": "string"
              }
            }
          },
          "binding": {
            "kind": "http",
            "method": "POST",
            "url": "http://localhost:4560/esign/v1/envelopes",
            "headers": {
              "authorization": "Bearer {{secret:ESIGN_TOKEN}}"
            }
          }
        }
      ]
    },
    {
      "id": "ed60951c-f37c-5b76-9ac5-7f9e4fce092c",
      "name": "Issue policy",
      "role_id": "50553dac-90de-578f-9aad-f97f51b13ed5",
