{
  "id": "37a41753-a4b5-564d-828f-60fba735e5a8",
  "name": "Workplace Pension Savings",
  "version": "1.0.0",
  "awa_version": "1.1",
  "description": "An employee's way through the pension savings plan Valoria Life runs for Kestrel Engineering: the invitation in the HR portal, advice, the questionnaire and the risk profile, the choice of funds, the subscription with its due diligence, the 30 days to cancel, a year of payroll contributions and self-service, the year-end tax certificate, and the annual review.",
  "subject": {
    "name": "employee",
    "key": "enrolment_id"
  },
  "collect": [
    "enrolment_id",
    "plan_id",
    "contract_type",
    "employer",
    "employee",
    "tax_residence",
    "retirement_age",
    "household_members",
    "advice_given",
    "advice_channel",
    "risk_profile",
    "max_sri",
    "horizon_years",
    "sustainability_preference",
    "monthly_contribution_eur",
    "allocation",
    "portfolio_sri",
    "allocation_confirmed",
    "beneficiary_clause",
    "kyc_status",
    "cdd_level",
    "crs_reportable",
    "fatca_status",
    "policy_id",
    "policy_issued",
    "deduction_id",
    "premiums_paid_eur",
    "tax_year",
    "policy_in_force",
    "in_force_on",
    "deductible_eur",
    "deduction_article",
    "certificate_id",
    "tax_certificate_issued",
    "recommendations_accepted",
    "review_completed"
  ],
  "stages": [
    {
      "id": "invitation",
      "name": "Invitation",
      "description": "The employer opens the plan; the employee is invited in the HR portal and by e-mail, and reminded.",
      "workflows": [
        "6ff49b2a-cde9-5c66-9eb1-51d66d2472ac"
      ],
      "complete_when": "invitation_opened == true",
      "max_duration": "P30D",
      "owner": "Kestrel HR"
    },
    {
      "id": "discovery",
      "name": "Discovery and advice",
      "description": "The AI adviser explains the plan, the tax ceiling and the risks; a licensed adviser takes over by video call on request.",
      "workflows": [
        "6ff49b2a-cde9-5c66-9eb1-51d66d2472ac"
      ],
      "complete_when": "advice_given == true",
      "max_duration": "P14D",
      "owner": "Valoria advice desk"
    },
    {
      "id": "profile",
      "name": "Needs and profile",
      "description": "The questionnaire: demands and needs, knowledge and experience, capacity for loss, horizon, risk tolerance, sustainability preferences; the risk profile.",
      "workflows": [
        "6ff49b2a-cde9-5c66-9eb1-51d66d2472ac"
      ],
      "complete_when": "risk_profile exists",
      "max_duration": "P21D",
      "owner": "Valoria advice desk"
    },
    {
      "id": "investments",
      "name": "Investments",
      "description": "A model portfolio or the employee's own choice of unit-linked funds, each with its key information document, checked against the profile.",
      "workflows": [
        "51bb950b-7579-5ee2-81fb-4e1e29d7c18f"
      ],
      "complete_when": "allocation_confirmed == true",
      "max_duration": "P21D",
      "owner": "Valoria advice desk"
    },
    {
      "id": "subscription",
      "name": "Subscription",
      "description": "Identity, anti-money-laundering and tax residence checks, the beneficiary clause, the payroll mandate, the e-signature.",
      "workflows": [
        "d0fb8198-0fde-5fd9-8d79-2b3c558ca363"
      ],
      "complete_when": "contract_signed == true",
      "max_duration": "P30D",
      "owner": "Valoria subscription desk"
    },
    {
      "id": "cooling-off",
      "name": "Cooling-off and issue",
      "description": "The policy is issued and the first premium invested; the employee has 30 days to cancel with a full refund.",
      "complete_when": "policy_in_force == true",
      "max_duration": "P60D",
      "owner": "Valoria back-office"
    },
    {
      "id": "saving",
      "name": "Saving",
      "description": "Monthly payroll contributions, switches and top-ups in self-service, quarterly statements.",
      "workflows": [
        "bbbdb5da-0532-5292-918e-c5a6224d576a",
        "bacf22dc-eb73-5156-8025-c4a318db6e4e"
      ],
      "complete_when": "tax_review_due == true",
      "max_duration": "P300D",
      "owner": "Kestrel payroll"
    },
    {
      "id": "year-end-tax",
      "name": "Year-end tax",
      "description": "The deductible amount, a top-up proposed before 31 December, the tax certificate in January for the tax return.",
      "workflows": [
        "fda1e521-702a-518a-bdba-97c991f9e71d"
      ],
      "complete_when": "tax_certificate_issued == true",
      "max_duration": "P100D",
      "owner": "Valoria tax desk"
    },
    {
      "id": "annual-review",
      "name": "Annual review",
      "description": "Recommendations: rebalance, reduce the risk with age, update the beneficiary clause after a life event.",
      "workflows": [
        "ac38e3b7-996e-5ca8-85b3-6591b9457d3b"
      ],
      "complete_when": "review_completed == true",
      "max_duration": "P45D",
      "owner": "Valoria advice desk",
      "transitions": []
    }
  ],
  "triggers": [
    {
      "event": "savings.invited",
      "starts_journey": true,
      "start_workflow": "6ff49b2a-cde9-5c66-9eb1-51d66d2472ac"
    },
    {
      "event": "profile.completed",
      "start_workflow": "51bb950b-7579-5ee2-81fb-4e1e29d7c18f"
    },
    {
      "event": "policy.in_force",
      "start_workflow": "bbbdb5da-0532-5292-918e-c5a6224d576a"
    },
    {
      "event": "self_service.requested",
      "start_workflow": "bacf22dc-eb73-5156-8025-c4a318db6e4e"
    },
    {
      "event": "tax_year.review_due",
      "start_workflow": "fda1e521-702a-518a-bdba-97c991f9e71d"
    },
    {
      "event": "annual_review.due",
      "start_workflow": "ac38e3b7-996e-5ca8-85b3-6591b9457d3b"
    }
  ],
  "goals": [
    {
      "id": "policy-issued",
      "name": "Policy issued",
      "expression": "policy_issued == true"
    },
    {
      "id": "first-deduction-claimed",
      "name": "First year's deduction claimed",
      "expression": "deduction_claimed == true"
    }
  ],
  "exits": [
    {
      "event": "savings.invitation_lapsed",
      "outcome": "abandoned",
      "reason": "Did not take up the invitation"
    },
    {
      "event": "subscription.lapsed",
      "outcome": "abandoned",
      "reason": "Did not complete the subscription"
    },
    {
      "event": "subscription.refused",
      "outcome": "abandoned",
      "reason": "Not accepted after due diligence"
    },
    {
      "event": "policy.cancellation_requested",
      "outcome": "abandoned",
      "reason": "Cancelled within the 30-day period"
    }
  ],
