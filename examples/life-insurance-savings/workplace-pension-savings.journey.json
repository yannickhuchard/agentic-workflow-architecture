  "sentiment": {
    "min": -2,
    "max": 2,
    "initial": 0,
    "rules": [
      {
        "on": "touchpoint",
        "touchpoint": "reminded",
        "change": -0.25,
        "reason": "had to be reminded"
      },
      {
        "on": "touchpoint",
        "touchpoint": "last-reminder",
        "change": -0.25,
        "reason": "reminded again by the employer"
      },
      {
        "on": "touchpoint",
        "touchpoint": "video-call",
        "change": 0.5,
        "reason": "talked to a person"
      },
      {
        "on": "touchpoint",
        "touchpoint": "warned",
        "change": -0.25,
        "reason": "was told the choice is too risky"
      },
      {
        "on": "touchpoint",
        "touchpoint": "change-declined",
        "change": -0.25,
        "reason": "a change was refused"
      },
      {
        "on": "goal_reached",
        "goal": "policy-issued",
        "change": 0.5,
        "reason": "the policy is issued"
      },
      {
        "on": "touchpoint",
        "touchpoint": "cancels",
        "change": -0.5,
        "reason": "cancelled the plan"
      },
      {
        "on": "touchpoint",
        "touchpoint": "tax-certificate",
        "change": 0.5,
        "reason": "has the certificate for the tax return"
      },
      {
        "on": "event",
        "event": "annual_review.answered",
        "measure": {
          "path": "satisfaction",
