  </bpmn:process>
  <bpmn:process id="_6ff49b2a-cde9-5c66-9eb1-51d66d2472ac" name="Plan Invitation and Advice" isExecutable="true">
    <bpmn:documentation>Invites an employee to the employer's pension savings plan in the HR portal, reminds them, explains the plan, its tax ceiling and its risks through an AI adviser that hands over to a licensed adviser on request or when unsure, and establishes the demands and needs and the risk profile from the questionnaire.</bpmn:documentation>
    <bpmn:extensionElements>
      <awa:properties>{"$schema":"https://awa.io/schema/awa.schema.json"}</awa:properties>
      <awa:sla>{"id":"05a5ffb6-9caf-574e-a3b8-0079bd961011","name":"Advice and profile within six weeks","target_time":"P21D","max_time":"P42D","escalation_policy":{"breach_action":"record","notify_roles":["883e4f3b-ee2e-5c46-aeda-993ba4419ad6"]}}</awa:sla>
      <awa:contexts>[{"id":"2351dbe0-0346-586a-a113-f4165b9d5f68","name":"employee_profile","type":"data","sync_pattern":"shared_state","description":"The employee as the agents that serve them need to know them: first name, language, age, retirement age, tax residence and, once assessed, the risk profile. Salary and identity documents are not in it.","schema":{"type":"object","required":["first_name","tax_residence"],"properties":{"first_name":{"type":"string"},"preferred_language":{"type":"string"},"age":{"type":"integer"},"retirement_age":{"type":"integer"},"tax_residence":{"type":"string"},"risk_profile":{"type":"string"},"max_sri":{"type":"integer"},"horizon_years":{"type":"number"},"sustainability_preference":{"type":"string"},"monthly_contribution_eur":{"type":"number"}}}}]</awa:contexts>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_6ff49b2a-cde9-5c66-9eb1-51d66d2472ac">
      <bpmn:lane id="_46def729-3ca3-5b9c-9ea7-fbb9b25ac1a3" name="Policy administration" awa:actorType="application">
        <bpmn:documentation>Valoria Life's policy administration system: plans, enrolments, policies and premiums.</bpmn:documentation>
        <bpmn:flowNodeRef>_b9947f8a-a162-55d7-85d6-e4d6fbdfa1f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_1c9b1875-1fc2-51af-97ae-01dcff0d3cb9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_676d01b1-888b-5517-a445-5f31bb16468f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_c2185c99-afda-5fea-bb83-cfc609dae54c" name="HR portal" awa:actorType="application">
        <bpmn:documentation>The HR portal Valoria Life provides to the employer: inbox, questionnaires, self-service.</bpmn:documentation>
        <bpmn:flowNodeRef>_f7441a3d-db46-50e2-b4df-ed674945e911</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_e0b9a421-e120-5f6f-8697-a36d5634dbc2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_ddacbd33-f911-5a97-a83b-3d376d130015</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_22038c7b-2f25-586a-bdd3-e665486610a2" name="Reminder writer" awa:actorType="ai_agent">
        <bpmn:documentation>Writes short reminders in the employee's language.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["customer writing"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:fast","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_0f8b56af-2bea-58eb-893d-101bcfe728dc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_2eccfa65-fc8e-5ef9-b698-d7433973e3d2" name="AI adviser" awa:actorType="ai_agent">
        <bpmn:documentation>Explains the plan, its tax treatment and its risks, and turns the questionnaire into a demands-and-needs statement. Never prices, underwrites or decides on compliance.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["life insurance savings","Luxembourg personal income tax","insurance distribution rules"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:reasoning","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_ba81557c-6186-5621-9aea-dbe11b995fe3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_cd4e6821-b157-5900-bb13-2e3a0a36115f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_e43ce575-fe84-5c56-9e27-111bd093f70e" name="Advice calendar" awa:actorType="application">
        <bpmn:documentation>Books video calls with licensed advisers.</bpmn:documentation>
        <bpmn:flowNodeRef>_a78daefe-7cf3-5fc8-8033-b460b83de505</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_883e4f3b-ee2e-5c46-aeda-993ba4419ad6" name="Licensed adviser" awa:actorType="human">
        <bpmn:documentation>An insurance distributor registered with the supervisor, who gives advice by video call and takes over from the AI adviser.</bpmn:documentation>
        <bpmn:flowNodeRef>_adaa6959-0b29-5032-b530-4fedbccbbca7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="_b9947f8a-a162-55d7-85d6-e4d6fbdfa1f2" name="Register enrolment">
      <bpmn:documentation>Create the enrolment and the employee profile the agents read.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"register_enrolment","description":"Create the enrolment of an invited employee in the policy administration system.","parameters":{"type":"object","required":["enrolment_id","plan_id","employee","employer"],"properties":{"enrolment_id":{"type":"string"},"plan_id":{"type":"string"},"employee":{"type":"object"},"employer":{"type":"object"},"tax_residence":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/policy-admin/v1/enrolments","headers":{"authorization":"Bearer {{secret:POLICY_ADMIN_TOKEN}}"}}}]</awa:tools>
        <awa:retry>{"max_attempts":3,"initial_delay":"PT1S"}</awa:retry>
        <awa:contextBindings>[{"context_id":"2351dbe0-0346-586a-a113-f4165b9d5f68","access_mode":"write"}]</awa:contextBindings>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_f7441a3d-db46-50e2-b4df-ed674945e911" name="Send invitation">
      <bpmn:documentation>Invite the employee to the plan in the HR portal's inbox and by e-mail.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_0f8b56af-2bea-58eb-893d-101bcfe728dc" name="Send invitation reminder" awa:actorType="ai_agent">
      <bpmn:documentation>Remind the employee of the invitation: what the plan is, and until when it stays open.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
        <awa:contextBindings>[{"context_id":"2351dbe0-0346-586a-a113-f4165b9d5f68","access_mode":"read"}]</awa:contextBindings>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["message","deadline_stated"],"properties":{"message":{"type":"string","minLength":60},"deadline_stated":{"type":"boolean"},"reminder_id":{"type":"string"}}},"postconditions":[{"name":"States until when the invitation is open","expression":"deadline_stated == true"}]}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_e0b9a421-e120-5f6f-8697-a36d5634dbc2" name="Send last reminder">
      <bpmn:documentation>Send the employer's last reminder from Kestrel HR, through the HR portal.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_1c9b1875-1fc2-51af-97ae-01dcff0d3cb9" name="Close invitation">
      <bpmn:documentation>Close the enrolment: the employee did not answer, or did not continue.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_ba81557c-6186-5621-9aea-dbe11b995fe3" name="Explain the plan" awa:actorType="ai_agent">
      <bpmn:documentation>Explain the plan in the HR portal's chat: how it works, the tax ceiling under the article it is written under, the fees, that the value of unit-linked funds can fall, and the right to cancel. Hand over to a licensed adviser when the employee asks for one.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"procedure":"Read the plan's terms with the plan tool. Explain, in the employee's language: the contract and its minimum duration of ten years; that savings are paid out from age 60 and no later than 75; the deduction ceiling of the article the plan is written under for the current tax year; the fees; that the value of unit-linked funds goes down as well as up and is not guaranteed; the 30 days to cancel with a full refund. List every topic you covered. Offer a licensed adviser, and book one if the employee asks. Never state a guaranteed return. Say how sure you are that the employee has understood."}</awa:properties>
        <awa:tools>[{"name":"get_plan_rules","description":"Read the terms of the employer's savings plan: the contract, its minimum duration, the fees, the fund range and the tax article it is written under.","parameters":{"type":"object","required":["plan_id"],"properties":{"plan_id":{"type":"string"}}},"binding":{"kind":"http","method":"GET","url":"http://localhost:4560/policy-admin/v1/plans/{plan_id}","headers":{"authorization":"Bearer {{secret:POLICY_ADMIN_TOKEN}}"}}}]</awa:tools>
        <awa:contextBindings>[{"context_id":"2351dbe0-0346-586a-a113-f4165b9d5f68","access_mode":"read"}]</awa:contextBindings>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["explanation","topics_covered","uncovered_count","risk_warning_given","tax_ceiling_eur","handover_requested","confidence"],"properties":{"explanation":{"type":"string","minLength":200},"topics_covered":{"type":"array","items":{"type":"string","enum":["contract","duration","payout_age","tax_ceiling","fees","investment_risk","right_to_cancel"]}},"uncovered_count":{"type":"integer","minimum":0},"risk_warning_given":{"type":"boolean"},"tax_ceiling_eur":{"type":"number","exclusiveMinimum":0},"handover_requested":{"type":"boolean"},"confidence":{"type":"number","minimum":0,"maximum":1},"advice_given":{"type":"boolean"},"advice_channel":{"type":"string"}}},"postconditions":[{"name":"Every topic of the plan is covered","expression":"uncovered_count == 0"},{"name":"The investment risk is stated","expression":"risk_warning_given == true"},{"name":"Sure enough the employee has understood","expression":"confidence &gt;= 0.8"}],"budgets":{"max_attempts":2,"max_duration":"PT10M","max_tokens":40000,"max_tool_calls":4},"on_violation":"escalate_human"}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_a78daefe-7cf3-5fc8-8033-b460b83de505" name="Book video call">
      <bpmn:documentation>Book a video call with a licensed adviser at the time the employee chose.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"book_video_call","description":"Book a video call with a licensed adviser in the advice calendar.","parameters":{"type":"object","required":["enrolment_id","topic"],"properties":{"enrolment_id":{"type":"string"},"topic":{"type":"string"},"preferred_slot":{"type":"string"},"language":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/advice/v1/appointments","headers":{"authorization":"Bearer {{secret:ADVICE_CALENDAR_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="_adaa6959-0b29-5032-b530-4fedbccbbca7" name="Advise in video call">
      <bpmn:documentation>A licensed adviser explains the plan by video call, answers the employee's questions and records the advice given.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["advice_given","advice_summary"],"properties":{"advice_given":{"type":"boolean"},"advice_summary":{"type":"string","minLength":20},"advice_channel":{"type":"string"},"monthly_contribution_eur":{"type":"number","minimum":0}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="_ddacbd33-f911-5a97-a83b-3d376d130015" name="Send questionnaire">
      <bpmn:documentation>Open the questionnaire in the HR portal: demands and needs, knowledge and experience, financial situation and capacity for loss, objectives and risk tolerance, sustainability preferences.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"open_questionnaire","description":"Open the demands-and-needs and suitability questionnaire for the employee in the HR portal.","parameters":{"type":"object","required":["enrolment_id","questionnaire"],"properties":{"enrolment_id":{"type":"string"},"questionnaire":{"type":"string"},"language":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/questionnaires","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_cd4e6821-b157-5900-bb13-2e3a0a36115f" name="Assess demands and needs" awa:actorType="ai_agent">
      <bpmn:documentation>Turn the answers into the demands-and-needs statement and the suitability assessment of the Insurance Distribution Directive, and flag answers that contradict each other.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"procedure":"Read the answers. Write the demands and needs in plain words. Check every section is answered: knowledge and experience, financial situation including the capacity for loss, objectives including the horizon and risk tolerance, sustainability preferences. List answers that contradict each other, such as a short horizon with a high risk tolerance. Say how sure you are.","guardrails":[{"id":"67c8f788-8fd1-5e65-aaf7-1b0b0b92c6a7","name":"E-mail addresses, phone numbers and bank accounts in what the agent writes","stages":["output"],"check":{"kind":"personal_data","categories":["email","phone","iban"]},"action":"redact"}]}</awa:properties>
        <awa:contextBindings>[{"context_id":"2351dbe0-0346-586a-a113-f4165b9d5f68","access_mode":"read"}]</awa:contextBindings>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["demands_and_needs","sections_unanswered","contradictions","confidence","notes"],"properties":{"demands_and_needs":{"type":"string","minLength":80},"sections_unanswered":{"type":"integer","minimum":0},"contradictions":{"type":"array","items":{"type":"string"}},"confidence":{"type":"number","minimum":0,"maximum":1},"notes":{"type":"string","minLength":10}}},"postconditions":[{"name":"Every section of the questionnaire is answered","expression":"sections_unanswered == 0"},{"name":"Sure enough to profile","expression":"confidence &gt;= 0.75"}],"budgets":{"max_attempts":2,"max_duration":"PT5M","max_tokens":30000},"on_violation":"escalate_human"}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_676d01b1-888b-5517-a445-5f31bb16468f" name="Record suitability profile">
      <bpmn:documentation>Record the demands and needs, the suitability assessment and the risk profile on the enrolment.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"record_suitability_profile","description":"Record the demands and needs, the suitability assessment and the risk profile on the enrolment.","parameters":{"type":"object","required":["enrolment_id","risk_profile","max_sri"],"properties":{"enrolment_id":{"type":"string"},"risk_profile":{"type":"string","enum":["cautious","moderate","balanced","dynamic"]},"max_sri":{"type":"integer","minimum":1,"maximum":7},"demands_and_needs":{"type":"string"},"sustainability_preference":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/policy-admin/v1/enrolments/{enrolment_id}/profile","headers":{"authorization":"Bearer {{secret:POLICY_ADMIN_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:startEvent id="_b99a7e35-12bd-5ef4-8985-249f9aa6634d" name="Employee invited">
      <bpmn:documentation>The employer opens the plan to the employee in the HR portal.</bpmn:documentation>
      <bpmn:messageEventDefinition id="MessageEventDefinition_b99a7e35-12bd-5ef4-8985-249f9aa6634d" messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="_03110dc5-e514-57ef-bba2-bb4f2e1d6291" name="Invitation opened">
      <bpmn:documentation>Wait for the employee to open the invitation.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_03110dc5-e514-57ef-bba2-bb4f2e1d6291" messageRef="Message_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="_56593040-1e05-5efe-9a38-2e2a56693ecf" name="Invitation opened after reminder">
      <bpmn:documentation>Wait once more after the reminder.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_56593040-1e05-5efe-9a38-2e2a56693ecf" messageRef="Message_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="_f755c6fb-eeb0-5c3f-99ae-dcedb61c2dd9" name="Invitation opened after last reminder">
      <bpmn:documentation>Wait a last time after the employer's reminder.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_f755c6fb-eeb0-5c3f-99ae-dcedb61c2dd9" messageRef="Message_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_8a928207-ab26-5165-ba6c-8367d44a1e71" name="Advice given">
      <bpmn:documentation>Tell the journey the plan has been explained, and by whom.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","advice_given","advice_channel"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_8a928207-ab26-5165-ba6c-8367d44a1e71" messageRef="Message_3" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="_1260f3b5-b60f-5b82-9ba7-9ba6beda0f81" name="Questionnaire answered">
      <bpmn:documentation>Wait for the questionnaire.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1260f3b5-b60f-5b82-9ba7-9ba6beda0f81" messageRef="Message_4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_49ffed8a-de1e-57f8-afad-d1eef883a9b3" name="Profile completed">
      <bpmn:documentation>Tell the journey and the subscription the employee's profile.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","plan_id","employee","employer","tax_residence","retirement_age","risk_profile","max_sri","horizon_years","capacity_for_loss","sustainability_preference","demands_and_needs","monthly_contribution_eur","profile_reference"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_49ffed8a-de1e-57f8-afad-d1eef883a9b3" messageRef="Message_5" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_bfefa930-2ca1-574e-9895-f2ec99aac455" name="Invitation lapsed">
      <bpmn:documentation>Tell the journey the invitation lapsed.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","lapsed_reason"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_bfefa930-2ca1-574e-9895-f2ec99aac455" messageRef="Message_6" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="_98c62bce-ab99-50b6-9a02-db1403825d97" name="Advice completed" />
    <bpmn:endEvent id="_b0d9e3b8-9de0-5ed4-a873-d5b854bcd195" name="Not taken up" />
    <bpmn:businessRuleTask id="_d906cec7-1cbf-506d-9418-a79a7d289a01" name="Risk profile" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_d906cec7-1cbf-506d-9418-a79a7d289a01">
      <bpmn:documentation>The risk profile, and the highest summary risk indicator (SRI, 1 to 7, from the key information documents) a choice may reach, from the suitability answers. THE BANDS ARE EXAMPLES each insurer sets in its own advice policy.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:eventBasedGateway id="Wait_03110dc5-e514-57ef-bba2-bb4f2e1d6291" />
    <bpmn:intermediateCatchEvent id="Timeout_03110dc5-e514-57ef-bba2-bb4f2e1d6291" name="Invitation opened: no event within P7D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_03110dc5-e514-57ef-bba2-bb4f2e1d6291">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Wait_56593040-1e05-5efe-9a38-2e2a56693ecf" />
    <bpmn:intermediateCatchEvent id="Timeout_56593040-1e05-5efe-9a38-2e2a56693ecf" name="Invitation opened after reminder: no event within P7D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_56593040-1e05-5efe-9a38-2e2a56693ecf">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Wait_f755c6fb-eeb0-5c3f-99ae-dcedb61c2dd9" />
    <bpmn:intermediateCatchEvent id="Timeout_f755c6fb-eeb0-5c3f-99ae-dcedb61c2dd9" name="Invitation opened after last reminder: no event within P14D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_f755c6fb-eeb0-5c3f-99ae-dcedb61c2dd9">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Wait_1260f3b5-b60f-5b82-9ba7-9ba6beda0f81" />
    <bpmn:intermediateCatchEvent id="Timeout_1260f3b5-b60f-5b82-9ba7-9ba6beda0f81" name="Questionnaire answered: no event within P14D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_1260f3b5-b60f-5b82-9ba7-9ba6beda0f81">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
