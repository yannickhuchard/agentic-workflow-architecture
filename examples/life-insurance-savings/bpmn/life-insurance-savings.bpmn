    <bpmn:intermediateCatchEvent id="Timeout_6af23654-f6e1-5622-ab7b-0c5f8329ae2d" name="Choice reconsidered: no event within P14D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_6af23654-f6e1-5622-ab7b-0c5f8329ae2d">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Wait_6cf047d2-369b-5e24-b425-8311e33b1ffc" />
    <bpmn:intermediateCatchEvent id="Timeout_6cf047d2-369b-5e24-b425-8311e33b1ffc" name="Subscription form submitted: no event within P14D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_6cf047d2-369b-5e24-b425-8311e33b1ffc">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Wait_edd322e0-f06e-5878-8284-eb0d5975c7c8" />
