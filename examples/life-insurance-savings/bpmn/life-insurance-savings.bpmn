  </bpmn:process>
  <bpmn:process id="_bbbdb5da-0532-5292-918e-c5a6224d576a" name="Payroll Contributions" isExecutable="true">
    <bpmn:documentation>From the policy's coming into force, invests each monthly payroll contribution, a top-up included, records it on the policy, sends a statement each quarter, and closes the savings year with the premiums of the tax year after the December payroll.</bpmn:documentation>
    <bpmn:extensionElements>
      <awa:properties>{"$schema":"https://awa.io/schema/awa.schema.json"}</awa:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_bbbdb5da-0532-5292-918e-c5a6224d576a">
      <bpmn:lane id="_961a77de-df61-5036-817a-a752c0fbe1c2" name="Custodian bank" awa:actorType="application">
        <bpmn:documentation>The custodian bank that holds the assets covering the policies.</bpmn:documentation>
        <bpmn:flowNodeRef>_0d3763d2-4a8d-5106-95d4-3d1bd40f699c</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_d05ab4e4-c99b-54cd-8eb9-387a5188d618" name="Policy administration" awa:actorType="application">
        <bpmn:documentation>Valoria Life's policy administration system.</bpmn:documentation>
      </bpmn:lane>
      <bpmn:lane id="_78e0bb16-e0de-5aa2-8171-728a602652f5" name="HR portal" awa:actorType="application">
        <bpmn:documentation>The HR portal Valoria Life provides to the employer.</bpmn:documentation>
        <bpmn:flowNodeRef>_8ad7581e-72f3-572e-a740-3c9a80caec32</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_fbd26665-ce61-53a3-8642-2ef40aa7ea2d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_e90cc9e4-ed55-5bd7-b39e-8d1272d0248e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="_0d3763d2-4a8d-5106-95d4-3d1bd40f699c" name="Invest contribution">
      <bpmn:documentation>Record the contribution on the policy and buy units of the allocation through the custodian bank.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"record_premium","description":"Record a premium on the policy and return the premiums paid in the tax year so far.","parameters":{"type":"object","required":["policy_id","period","amount_eur"],"properties":{"policy_id":{"type":"string"},"period":{"type":"string"},"amount_eur":{"type":"number","exclusiveMinimum":0},"paid_before_eur":{"type":"number","minimum":0}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/policy-admin/v1/policies/{policy_id}/premiums","headers":{"authorization":"Bearer {{secret:POLICY_ADMIN_TOKEN}}"}}},{"name":"place_order","description":"Buy units with a premium through the custodian bank: in the allocation given, or else in the policy's current allocation.","parameters":{"type":"object","required":["policy_id","amount_eur"],"properties":{"policy_id":{"type":"string"},"amount_eur":{"type":"number","exclusiveMinimum":0},"allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},"period":{"type":"string"}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/custody/rpc","method":"custody.place_order"}}]</awa:tools>
        <awa:retry>{"max_attempts":3,"initial_delay":"PT5S"}</awa:retry>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_8ad7581e-72f3-572e-a740-3c9a80caec32" name="Report missing contribution">
      <bpmn:documentation>Tell the employee and Kestrel HR that no contribution arrived for the month.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_fbd26665-ce61-53a3-8642-2ef40aa7ea2d" name="Send quarterly statement">
      <bpmn:documentation>Send the quarterly statement: the value, the units by fund and the premiums paid this year.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"get_position","description":"Read the value of a policy, its units by fund and how far its allocation has drifted from the target.","parameters":{"type":"object","required":["policy_id"],"properties":{"policy_id":{"type":"string"},"target_allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},"premiums_eur":{"type":"number","minimum":0}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/custody/rpc","method":"custody.get_position"}},{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_e90cc9e4-ed55-5bd7-b39e-8d1272d0248e" name="Send annual statement">
      <bpmn:documentation>Send the annual statement after the December payroll.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"get_position","description":"Read the value of a policy, its units by fund and how far its allocation has drifted from the target.","parameters":{"type":"object","required":["policy_id"],"properties":{"policy_id":{"type":"string"},"target_allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},"premiums_eur":{"type":"number","minimum":0}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/custody/rpc","method":"custody.get_position"}},{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:startEvent id="_e19d9d08-c979-5577-a4a7-e8b34b97b9a2" name="Policy in force">
      <bpmn:documentation>The 30 days to cancel have passed: from the next payroll, the contributions are invested here.</bpmn:documentation>
      <bpmn:messageEventDefinition id="MessageEventDefinition_e19d9d08-c979-5577-a4a7-e8b34b97b9a2" messageRef="Message_15" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="_db76daf1-e439-5599-a977-23c4e03326d8" name="Contribution paid">
      <bpmn:documentation>Wait for the next payroll: the employer pays the month's contribution.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_db76daf1-e439-5599-a977-23c4e03326d8" messageRef="Message_12" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_c730430e-1e47-5e79-9d00-81518142c3e6" name="Contribution recorded">
      <bpmn:documentation>Tell the journey the premiums paid in the tax year so far.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","period","premiums_paid_eur"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_c730430e-1e47-5e79-9d00-81518142c3e6" messageRef="Message_18" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_5ccef1f4-bd25-510d-9660-17358ec74abd" name="Savings year closed">
      <bpmn:documentation>Tell the journey and the year-end tax the premiums of the tax year.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","policy_id","tax_year","premiums_paid_eur","savings_year_closed"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_5ccef1f4-bd25-510d-9660-17358ec74abd" messageRef="Message_19" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="_2ae945ca-0ab0-55fc-9566-1e8281b8a066" name="Year closed" />
    <bpmn:businessRuleTask id="_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05" name="After the contribution" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05">
      <bpmn:documentation>What follows a contribution: a statement at the end of a quarter, the close of the savings year after December, otherwise the next payroll.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:eventBasedGateway id="Wait_db76daf1-e439-5599-a977-23c4e03326d8" />
    <bpmn:intermediateCatchEvent id="Timeout_db76daf1-e439-5599-a977-23c4e03326d8" name="Contribution paid: no event within P40D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_db76daf1-e439-5599-a977-23c4e03326d8">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P40D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Route_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05" gatewayDirection="Diverging" default="_a7dbbc0d-5512-544f-b6d3-152084f0ab4e" />
    <bpmn:sequenceFlow id="_3e8bb491-d9b0-514c-82a7-d4105c6a702e" sourceRef="_e19d9d08-c979-5577-a4a7-e8b34b97b9a2" targetRef="Wait_db76daf1-e439-5599-a977-23c4e03326d8" />
    <bpmn:sequenceFlow id="_d71231b5-4a91-5bcd-b926-5338551a7977" sourceRef="_db76daf1-e439-5599-a977-23c4e03326d8" targetRef="_0d3763d2-4a8d-5106-95d4-3d1bd40f699c" />
    <bpmn:sequenceFlow id="_b2c1f359-2060-5117-8a4c-94d0db0b2d3c" name="no payroll in 40 days" sourceRef="Timeout_db76daf1-e439-5599-a977-23c4e03326d8" targetRef="_8ad7581e-72f3-572e-a740-3c9a80caec32" />
    <bpmn:sequenceFlow id="_b4467691-1bc6-5a01-b445-194aec24549f" sourceRef="_8ad7581e-72f3-572e-a740-3c9a80caec32" targetRef="Wait_db76daf1-e439-5599-a977-23c4e03326d8" />
    <bpmn:sequenceFlow id="_a6d8081d-6a6e-5f84-b6e1-c6bf48eff60c" sourceRef="_0d3763d2-4a8d-5106-95d4-3d1bd40f699c" targetRef="_c730430e-1e47-5e79-9d00-81518142c3e6" />
    <bpmn:sequenceFlow id="_7891c224-1c12-5784-a95c-509bb01d9d64" sourceRef="_c730430e-1e47-5e79-9d00-81518142c3e6" targetRef="_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05" />
    <bpmn:sequenceFlow id="_645043db-92e7-5190-b885-d6170475df76" name="December" sourceRef="Route_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05" targetRef="_e90cc9e4-ed55-5bd7-b39e-8d1272d0248e">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://awa.io/schema/decision-route/1.1">chosen by rule 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="_b1ffdf6b-7db6-5344-8d0a-33d5e874f2cd" name="end of a quarter" sourceRef="Route_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05" targetRef="_fbd26665-ce61-53a3-8642-2ef40aa7ea2d">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://awa.io/schema/decision-route/1.1">chosen by rule 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="_a7dbbc0d-5512-544f-b6d3-152084f0ab4e" name="next payroll" sourceRef="Route_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05" targetRef="Wait_db76daf1-e439-5599-a977-23c4e03326d8" />
    <bpmn:sequenceFlow id="_40d2771b-6b9a-579a-a811-4df2d0e12187" sourceRef="_fbd26665-ce61-53a3-8642-2ef40aa7ea2d" targetRef="Wait_db76daf1-e439-5599-a977-23c4e03326d8" />
    <bpmn:sequenceFlow id="_0cea2f32-b069-534b-9e12-060b35fec574" sourceRef="_e90cc9e4-ed55-5bd7-b39e-8d1272d0248e" targetRef="_5ccef1f4-bd25-510d-9660-17358ec74abd" />
    <bpmn:sequenceFlow id="_8df2141f-acc8-5796-bf4a-c271e334eb2b" sourceRef="_5ccef1f4-bd25-510d-9660-17358ec74abd" targetRef="_2ae945ca-0ab0-55fc-9566-1e8281b8a066" />
    <bpmn:sequenceFlow id="Wait_db76daf1-e439-5599-a977-23c4e03326d8_event" sourceRef="Wait_db76daf1-e439-5599-a977-23c4e03326d8" targetRef="_db76daf1-e439-5599-a977-23c4e03326d8" />
    <bpmn:sequenceFlow id="Wait_db76daf1-e439-5599-a977-23c4e03326d8_timeout" sourceRef="Wait_db76daf1-e439-5599-a977-23c4e03326d8" targetRef="Timeout_db76daf1-e439-5599-a977-23c4e03326d8" />
    <bpmn:sequenceFlow id="Route_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05_in" sourceRef="_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05" targetRef="Route_f3fc651a-b99b-5549-9e92-eb9c3f5bdc05" />
  </bpmn:process>
  <bpmn:process id="_bacf22dc-eb73-5156-8025-c4a318db6e4e" name="Self-Service Change" isExecutable="true">
    <bpmn:documentation>A change the employee makes in the HR portal: a fund switch, or a top-up collected with the next payroll. Each is checked against the risk profile and the plan's rules before it is made.</bpmn:documentation>
    <bpmn:extensionElements>
      <awa:properties>{"$schema":"https://awa.io/schema/awa.schema.json"}</awa:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_bacf22dc-eb73-5156-8025-c4a318db6e4e">
      <bpmn:lane id="_af0e50fc-c896-5f03-90d1-5d39d8c85a70" name="Fund platform" awa:actorType="application">
        <bpmn:documentation>Checks allocations against risk profiles.</bpmn:documentation>
        <bpmn:flowNodeRef>_2c0b43b4-f326-57db-97e8-1b75e2e2662a</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_5b62091c-0227-5dc1-b62b-0a7cc63fdde4" name="Custodian bank" awa:actorType="application">
        <bpmn:documentation>The custodian bank that holds the assets covering the policies.</bpmn:documentation>
        <bpmn:flowNodeRef>_61a4ddf5-c3de-520d-be2d-4bb97509645c</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_38fbdbe1-19a8-5d6e-a61d-fc2eeb39a182" name="Employer payroll" awa:actorType="application">
        <bpmn:documentation>Kestrel's payroll system.</bpmn:documentation>
        <bpmn:flowNodeRef>_4a7c6f9e-e0f3-50de-b13d-e42fa9fb0efe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_7fa7796e-7f94-5290-9fc0-d27dbe232df0" name="HR portal" awa:actorType="application">
        <bpmn:documentation>The HR portal Valoria Life provides to the employer.</bpmn:documentation>
        <bpmn:flowNodeRef>_6a518d0e-5ae5-5653-b85d-79fef899c7db</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="_2c0b43b4-f326-57db-97e8-1b75e2e2662a" name="Check change against profile">
      <bpmn:documentation>Check the allocation the change leads to against the risk profile.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"check_allocation","description":"Check an allocation against a risk profile: the weighted summary risk indicator, its excess over the profile's maximum, and whether every fund's key information document was delivered.","parameters":{"type":"object","required":["allocation","max_sri"],"properties":{"allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},"max_sri":{"type":"integer","minimum":1,"maximum":7},"enrolment_id":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/funds/v1/suitability-checks","headers":{"x-api-key":"{{secret:FUND_PLATFORM_KEY}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_61a4ddf5-c3de-520d-be2d-4bb97509645c" name="Switch funds">
      <bpmn:documentation>Move the policy's value to the new allocation.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"switch_funds","description":"Move the value of a policy to a new allocation, through the custodian bank.","parameters":{"type":"object","required":["policy_id","allocation"],"properties":{"policy_id":{"type":"string"},"allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/custody/rpc","method":"custody.switch"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_4a7c6f9e-e0f3-50de-b13d-e42fa9fb0efe" name="Schedule top-up">
      <bpmn:documentation>Add the top-up to the next payroll deduction.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"schedule_one_off_deduction","description":"Add a one-off amount to the employee's next payroll deduction: a top-up.","parameters":{"type":"object","required":["employee_number","policy_id","amount_eur"],"properties":{"employee_number":{"type":"string"},"policy_id":{"type":"string"},"amount_eur":{"type":"number","exclusiveMinimum":0}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/payroll/rpc","method":"payroll.schedule_one_off"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_6a518d0e-5ae5-5653-b85d-79fef899c7db" name="Decline the change">
      <bpmn:documentation>Tell the employee why the change cannot be made, and offer a licensed adviser.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:startEvent id="_c67ed7d1-119f-5648-b39c-1a7e87fadcba" name="Change requested">
      <bpmn:documentation>The employee asks for a fund switch or a top-up in the HR portal.</bpmn:documentation>
      <bpmn:messageEventDefinition id="MessageEventDefinition_c67ed7d1-119f-5648-b39c-1a7e87fadcba" messageRef="Message_20" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="_8f443243-56b6-5805-82b2-72b0cfa9ddf6" name="Change made">
      <bpmn:documentation>Tell the journey the change is made.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","request_type","change_status"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_8f443243-56b6-5805-82b2-72b0cfa9ddf6" messageRef="Message_21" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_a5b73f5d-1a0f-585c-a276-f60921e7d723" name="Change declined">
      <bpmn:documentation>Tell the journey the change was declined.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","request_type","decline_reason"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_a5b73f5d-1a0f-585c-a276-f60921e7d723" messageRef="Message_22" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="_2b298c52-c8c0-59a1-8164-0016ea0a304a" name="Done" />
    <bpmn:endEvent id="_57efeab0-956e-52d0-9404-e7bd8a533d19" name="Not done" />
    <bpmn:businessRuleTask id="_000d06d3-7110-5a01-9040-b730a43f7d4b" name="Change within the rules" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_000d06d3-7110-5a01-9040-b730a43f7d4b">
      <bpmn:documentation>A switch must stay within the profile; a top-up is invested in the current allocation, and the plan takes at most 10,000 EUR of top-ups a year (an example of a plan rule).</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Route_000d06d3-7110-5a01-9040-b730a43f7d4b" gatewayDirection="Diverging" default="_cdc7185e-b624-562b-95a0-01edc85695fc" />
    <bpmn:sequenceFlow id="_408fda25-6c7e-55d0-b4a8-7beb53231964" sourceRef="_c67ed7d1-119f-5648-b39c-1a7e87fadcba" targetRef="_2c0b43b4-f326-57db-97e8-1b75e2e2662a" />
    <bpmn:sequenceFlow id="_0b04f008-8ee0-599b-b499-6d54f7032fb0" sourceRef="_2c0b43b4-f326-57db-97e8-1b75e2e2662a" targetRef="_000d06d3-7110-5a01-9040-b730a43f7d4b" />
    <bpmn:sequenceFlow id="_517d4b37-1b66-524c-aed5-abbe9dd66357" name="switch within the profile" sourceRef="Route_000d06d3-7110-5a01-9040-b730a43f7d4b" targetRef="_61a4ddf5-c3de-520d-be2d-4bb97509645c">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://awa.io/schema/decision-route/1.1">chosen by rule 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="_5aeb5464-2975-5553-ae4c-288e8fb29816" name="top-up within the plan" sourceRef="Route_000d06d3-7110-5a01-9040-b730a43f7d4b" targetRef="_4a7c6f9e-e0f3-50de-b13d-e42fa9fb0efe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://awa.io/schema/decision-route/1.1">chosen by rule 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="_cdc7185e-b624-562b-95a0-01edc85695fc" name="outside the rules" sourceRef="Route_000d06d3-7110-5a01-9040-b730a43f7d4b" targetRef="_6a518d0e-5ae5-5653-b85d-79fef899c7db" />
    <bpmn:sequenceFlow id="_7aff574b-7485-5c61-81c0-2750a69a6703" sourceRef="_61a4ddf5-c3de-520d-be2d-4bb97509645c" targetRef="_8f443243-56b6-5805-82b2-72b0cfa9ddf6" />
    <bpmn:sequenceFlow id="_147f6b8b-d8e9-51a1-b508-16208a198672" sourceRef="_4a7c6f9e-e0f3-50de-b13d-e42fa9fb0efe" targetRef="_8f443243-56b6-5805-82b2-72b0cfa9ddf6" />
    <bpmn:sequenceFlow id="_86c0bbe6-0abb-575a-83b5-426dbe4f67db" sourceRef="_8f443243-56b6-5805-82b2-72b0cfa9ddf6" targetRef="_2b298c52-c8c0-59a1-8164-0016ea0a304a" />
    <bpmn:sequenceFlow id="_42404e75-dd7c-53c5-becb-9be01dc64cf9" sourceRef="_6a518d0e-5ae5-5653-b85d-79fef899c7db" targetRef="_a5b73f5d-1a0f-585c-a276-f60921e7d723" />
    <bpmn:sequenceFlow id="_0cdf0197-83cb-564a-8c47-e149b94ab421" sourceRef="_a5b73f5d-1a0f-585c-a276-f60921e7d723" targetRef="_57efeab0-956e-52d0-9404-e7bd8a533d19" />
    <bpmn:sequenceFlow id="Route_000d06d3-7110-5a01-9040-b730a43f7d4b_in" sourceRef="_000d06d3-7110-5a01-9040-b730a43f7d4b" targetRef="Route_000d06d3-7110-5a01-9040-b730a43f7d4b" />
  </bpmn:process>
  <bpmn:process id="_fda1e521-702a-518a-bdba-97c991f9e71d" name="Year-End Tax" isExecutable="true">
    <bpmn:documentation>From November to January: the deductible amount per article of the income tax law, a top-up proposal to reach the ceiling before 31 December, and the annual tax certificate for the tax return. A cross-border worker's file goes to a tax adviser first, since whether the deduction applies depends on their situation.</bpmn:documentation>
    <bpmn:extensionElements>
      <awa:properties>{"$schema":"https://awa.io/schema/awa.schema.json"}</awa:properties>
      <awa:sla>{"id":"d36074d9-8995-5ffa-a120-b543eebc4551","name":"Certificate by the end of February","target_time":"P90D","max_time":"P120D","escalation_policy":{"breach_action":"record","notify_roles":["707c0626-fad0-5873-ad39-2527cd21987b"]}}</awa:sla>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_fda1e521-702a-518a-bdba-97c991f9e71d">
      <bpmn:lane id="_71ab4a84-84f4-54ef-8227-1ceca5e136e6" name="Tax computation service" awa:actorType="application">
        <bpmn:documentation>Computes deductible amounts from premiums and the ceilings of the decision table.</bpmn:documentation>
        <bpmn:flowNodeRef>_6faf986a-08fa-5eb6-a797-afca824079f5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_c9bc74b5-4a3b-54e2-853b-01e102fc1e58</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_0cc07954-26ac-5c80-b4a3-c39ae4aa44d1" name="Tax adviser" awa:actorType="human">
        <bpmn:documentation>Valoria Life's tax adviser for cross-border workers.</bpmn:documentation>
        <bpmn:flowNodeRef>_e6ff3dda-ee76-54be-9d25-04a1d114017e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_53946c75-5e83-5f37-8e56-5c9ad49afbab" name="AI adviser" awa:actorType="ai_agent">
        <bpmn:documentation>Writes the top-up proposal.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["Luxembourg personal income tax","customer writing"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:balanced","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_52d284cd-c7b4-54cd-b35e-4192bbfe94cd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_0a240d8f-95ae-5076-9b9c-26f4e44d8cce" name="Tax certificate service" awa:actorType="application">
        <bpmn:documentation>Issues the annual tax certificates of premiums paid.</bpmn:documentation>
        <bpmn:flowNodeRef>_2bdf56b7-04a3-5162-819a-08dbc259c86e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_707c0626-fad0-5873-ad39-2527cd21987b" name="Back-office administrator" awa:actorType="human">
        <bpmn:documentation>Valoria Life's back-office.</bpmn:documentation>
        <bpmn:flowNodeRef>_8fd7d8fe-fad4-53f3-84ba-9d6062837ace</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_811db54a-f8f9-5d08-9f42-a26f54dc9315" name="HR portal" awa:actorType="application">
        <bpmn:documentation>The HR portal Valoria Life provides to the employer.</bpmn:documentation>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="_e6ff3dda-ee76-54be-9d25-04a1d114017e" name="Tax adviser review">
      <bpmn:documentation>A tax adviser looks at a cross-border worker's situation: whether they can be assimilated to a resident (at least 90% of their income taxable in Luxembourg, or the other thresholds of Art. 157ter LIR) and so deduct the premiums, and what to tell them.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:sla>{"id":"101d2524-e284-5dcf-8655-9bb2aba6b631","name":"Cross-border files answered within ten days","target_time":"P5D","max_time":"P10D","escalation_policy":{"breach_action":"record","notify_roles":["707c0626-fad0-5873-ad39-2527cd21987b"]}}</awa:sla>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["deduction_applicable","note"],"properties":{"deduction_applicable":{"type":"boolean"},"assimilated_to_resident":{"type":"boolean"},"note":{"type":"string","minLength":20}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="_6faf986a-08fa-5eb6-a797-afca824079f5" name="Project the year">
      <bpmn:documentation>Project the year's premiums and the deductible amount, with the contributions still to come, and the shortfall to the ceiling.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"compute_deductions","description":"Compute the deductible amount of premiums per article of the income tax law, from the premiums paid, the contributions still to come and the ceilings the decision table gives.","parameters":{"type":"object","required":["tax_year","articles","ceilings_eur","premiums_eur"],"properties":{"tax_year":{"type":"integer"},"articles":{"type":"array","items":{"type":"string"}},"ceilings_eur":{"type":"array","items":{"type":"number"}},"bases":{"type":"array","items":{"type":"string"}},"premiums_eur":{"type":"number","minimum":0},"monthly_contribution_eur":{"type":"number","minimum":0},"months_remaining":{"type":"integer","minimum":0},"household_members":{"type":"integer","minimum":1}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/tax/v1/deduction-computations","headers":{"authorization":"Bearer {{secret:TAX_SERVICE_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_52d284cd-c7b4-54cd-b35e-4192bbfe94cd" name="Write top-up proposal" awa:actorType="ai_agent">
      <bpmn:documentation>Propose a top-up that reaches the ceiling before 31 December: the ceiling, the shortfall, how the top-up is collected with the December payroll, and that the deduction depends on the employee's own tax situation.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["proposal","proposed_top_up_eur","ceiling_stated","deadline_stated","tax_caveat_given"],"properties":{"proposal":{"type":"string","minLength":120},"proposed_top_up_eur":{"type":"number","exclusiveMinimum":0},"ceiling_stated":{"type":"boolean"},"deadline_stated":{"type":"boolean"},"tax_caveat_given":{"type":"boolean"}}},"postconditions":[{"name":"States the ceiling","expression":"ceiling_stated == true"},{"name":"States the deadline of 31 December","expression":"deadline_stated == true"},{"name":"Says the deduction depends on the employee's situation","expression":"tax_caveat_given == true"}]}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="_8fd7d8fe-fad4-53f3-84ba-9d6062837ace" name="Confirm premiums by hand">
      <bpmn:documentation>The savings year did not close: a back-office administrator confirms the premiums of the tax year.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:serviceTask id="_c9bc74b5-4a3b-54e2-853b-01e102fc1e58" name="Compute deductible amounts">
      <bpmn:documentation>Compute the deductible amount per article from the premiums of the tax year.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"compute_deductions","description":"Compute the deductible amount of premiums per article of the income tax law, from the premiums paid, the contributions still to come and the ceilings the decision table gives.","parameters":{"type":"object","required":["tax_year","articles","ceilings_eur","premiums_eur"],"properties":{"tax_year":{"type":"integer"},"articles":{"type":"array","items":{"type":"string"}},"ceilings_eur":{"type":"array","items":{"type":"number"}},"bases":{"type":"array","items":{"type":"string"}},"premiums_eur":{"type":"number","minimum":0},"monthly_contribution_eur":{"type":"number","minimum":0},"months_remaining":{"type":"integer","minimum":0},"household_members":{"type":"integer","minimum":1}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/tax/v1/deduction-computations","headers":{"authorization":"Bearer {{secret:TAX_SERVICE_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_2bdf56b7-04a3-5162-819a-08dbc259c86e" name="Issue tax certificate">
      <bpmn:documentation>Issue the annual tax certificate and put it in the HR portal.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"issue_tax_certificate","description":"Issue the annual tax certificate of the premiums paid, for the employee's tax return.","parameters":{"type":"object","required":["policy_id","tax_year","article","premiums_eur","deductible_eur"],"properties":{"policy_id":{"type":"string"},"tax_year":{"type":"integer"},"article":{"type":"string"},"premiums_eur":{"type":"number"},"deductible_eur":{"type":"number"},"employee":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/tax-certificates/v1/certificates","headers":{"authorization":"Bearer {{secret:CERTIFICATES_TOKEN}}"}}},{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:startEvent id="_2da659c0-b7ea-5ba1-9bdb-d115e98d93a3" name="Tax review due">
      <bpmn:documentation>November: the insurer's calendar opens the year-end review of the tax year.</bpmn:documentation>
      <bpmn:messageEventDefinition id="MessageEventDefinition_2da659c0-b7ea-5ba1-9bdb-d115e98d93a3" messageRef="Message_23" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="_9fde317f-9e1e-5407-884c-7faaa6b655fc" name="Year&#39;s premiums known">
      <bpmn:documentation>Wait for the close of the savings year after the December payroll.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_9fde317f-9e1e-5407-884c-7faaa6b655fc" messageRef="Message_19" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="_e513f492-5f53-54c7-b544-7b0f521b5eb2" name="Certificates due">
      <bpmn:documentation>Wait for the January certificate run of the policy administration.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_e513f492-5f53-54c7-b544-7b0f521b5eb2" messageRef="Message_24" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_0cc83d63-75b8-5479-adb9-1478263576d6" name="Tax certificate issued">
      <bpmn:documentation>Tell the journey the certificate is in the HR portal.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","tax_year","certificate_id","deduction_article","deductible_eur","tax_certificate_issued"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0cc83d63-75b8-5479-adb9-1478263576d6" messageRef="Message_25" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="_bc8d7791-0daa-5c13-a755-2a39529b6251" name="Year-end done" />
    <bpmn:businessRuleTask id="_616c2901-c046-5d10-89f8-4497eb7db24c" name="Tax residence route" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_616c2901-c046-5d10-89f8-4497eb7db24c">
      <bpmn:documentation>A resident of Luxembourg goes straight to the deduction rules. A cross-border worker goes to a tax adviser first.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="_e1ff76ec-d75b-5648-8bff-5de3dff3de27" name="Deduction rules" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_e1ff76ec-d75b-5648-8bff-5de3dff3de27">
      <bpmn:documentation>The articles of the Luxembourg income tax law (LIR) under which premiums are deductible as special expenses, with their ceilings, AS DATA: a tax change is a new rule here, not a change of code. FACTS.md gives the source of each figure and marks those a tax adviser must confirm. This is not tax advice.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="_fc57fcda-b79c-5dbf-ab80-df512694d99a" name="Top-up worth proposing" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_fc57fcda-b79c-5dbf-ab80-df512694d99a">
      <bpmn:documentation>A top-up is proposed when the year's premiums will stay below the ceiling.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:eventBasedGateway id="Wait_9fde317f-9e1e-5407-884c-7faaa6b655fc" />
    <bpmn:intermediateCatchEvent id="Timeout_9fde317f-9e1e-5407-884c-7faaa6b655fc" name="Year&#39;s premiums known: no event within P75D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_9fde317f-9e1e-5407-884c-7faaa6b655fc">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P75D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Wait_e513f492-5f53-54c7-b544-7b0f521b5eb2" />
    <bpmn:intermediateCatchEvent id="Timeout_e513f492-5f53-54c7-b544-7b0f521b5eb2" name="Certificates due: no event within P60D">
      <bpmn:timerEventDefinition id="TimerEventDefinition_Timeout_e513f492-5f53-54c7-b544-7b0f521b5eb2">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P60D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
