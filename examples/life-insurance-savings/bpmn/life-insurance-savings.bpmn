  </bpmn:process>
  <bpmn:process id="_51bb950b-7579-5ee2-81fb-4e1e29d7c18f" name="Savings Plan Subscription" isExecutable="true">
    <bpmn:documentation>Subscribes an employee to the plan: proposes unit-linked funds or a model portfolio with their key information documents, checks the choice against the risk profile, runs the due diligence as a child run, reviews the beneficiary clause, has the contract signed, issues the policy, sets up the payroll deduction, invests the first premium and keeps the 30 days in which the employee may cancel with a full refund.</bpmn:documentation>
    <bpmn:extensionElements>
      <awa:properties>{"$schema":"https://awa.io/schema/awa.schema.json"}</awa:properties>
      <awa:sla>{"id":"71185281-781e-55db-8ba1-17005f33161f","name":"Policy in force within two months of the profile","target_time":"P60D","max_time":"P90D","escalation_policy":{"breach_action":"record","notify_roles":["50553dac-90de-578f-9aad-f97f51b13ed5"]}}</awa:sla>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_51bb950b-7579-5ee2-81fb-4e1e29d7c18f">
      <bpmn:lane id="_a53afcdd-729b-5cdb-919a-1f7dbbf0830d" name="AI adviser" awa:actorType="ai_agent">
        <bpmn:documentation>Proposes funds within the profile and warns, in plain words, when a choice goes beyond it.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["unit-linked funds","key information documents"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:balanced","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_712db9d0-6232-5c79-b2fc-767fce4145ce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_3ac8e49e-a6b0-5154-bfa6-8b139dcc3c1b</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_51e7044f-e4b6-5c60-b947-b03ad660d7b5" name="Fund platform" awa:actorType="application">
        <bpmn:documentation>The range of unit-linked funds and model portfolios, with their key information documents and summary risk indicators.</bpmn:documentation>
        <bpmn:flowNodeRef>_f2a8ecb0-a039-5bfb-afa6-b6503373232d</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_e51d88ee-5990-5af3-8c27-3d7220017a38" name="Licensed adviser" awa:actorType="human">
        <bpmn:documentation>Discusses a choice above the profile with the employee.</bpmn:documentation>
        <bpmn:flowNodeRef>_aa073b03-5054-5eb5-9396-a20c4fd577a2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_048cfcae-b06d-535b-a8c4-58474b7c05f2" name="Compliance officer" awa:actorType="human">
        <bpmn:documentation>Approves, or not, a choice above the profile the employee insists on.</bpmn:documentation>
        <bpmn:flowNodeRef>_5be98006-cbad-5d8f-be5e-527840e3256a</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_6a8a7187-1b85-5846-83a6-a35663eb4992" name="Due diligence desk" awa:actorType="application">
        <bpmn:documentation>Runs the customer due diligence; the work is done by the Identity, AML and Tax Residence Checks workflow.</bpmn:documentation>
        <bpmn:flowNodeRef>_50dc64c6-2c14-56e2-848d-a960866e4298</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_ceedbcfc-b6be-55df-be0b-63a7f5ec2454" name="Contract checker" awa:actorType="ai_agent">
        <bpmn:documentation>Checks a beneficiary clause is complete and unambiguous.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["beneficiary clauses"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:balanced","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_d5f45515-cadc-5ccb-b890-eadbabc5a25f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_393242a7-7977-53d9-a8cb-17c40bf689d9" name="E-signature service" awa:actorType="application">
        <bpmn:documentation>Sends documents for qualified e-signature and reports them signed.</bpmn:documentation>
        <bpmn:flowNodeRef>_de20ccd9-2e2a-5dee-ae78-ac63df97f0f8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_50553dac-90de-578f-9aad-f97f51b13ed5" name="Policy administration" awa:actorType="application">
        <bpmn:documentation>Valoria Life's policy administration system.</bpmn:documentation>
        <bpmn:flowNodeRef>_ed60951c-f37c-5b76-9ac5-7f9e4fce092c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_7c9cf587-2e49-5ce5-a4c4-5bb4e68c860a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_c1bf7220-5ff5-5fcc-8c65-b6c06571981b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_43c2dbdb-2396-53e3-b698-8b0aabf173cb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_ffc7cd3c-f0fc-5291-86fa-49daf7cccfad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_60c53a0b-0655-5bdc-a434-e40619468524" name="Employer payroll" awa:actorType="application">
        <bpmn:documentation>Kestrel's payroll system, which deducts the contribution from the salary and pays it to the insurer.</bpmn:documentation>
        <bpmn:flowNodeRef>_def60566-e9e2-5626-8349-1141b03be9d6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_eb5ef360-8afd-59a8-8c55-dd4faab08425</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_df800a2c-a94f-5992-a4ea-b21f93f96b2f" name="Custodian bank" awa:actorType="application">
        <bpmn:documentation>The custodian bank that holds the assets covering the policies, apart from the insurer's own.</bpmn:documentation>
        <bpmn:flowNodeRef>_064546c0-fcb8-5cb1-92d7-742cc19da66f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_e5bdad1f-5e0f-5ba9-90ad-d19597b3fa47</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_2617bb5c-c57d-51f3-a904-086f3db57d63" name="HR portal" awa:actorType="application">
        <bpmn:documentation>The HR portal Valoria Life provides to the employer.</bpmn:documentation>
        <bpmn:flowNodeRef>_2d932caa-81db-5a58-9c40-ac9769efa875</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_83161e21-2b66-557b-807f-cb53d923044d" name="Back-office administrator" awa:actorType="human">
        <bpmn:documentation>Valoria Life's back-office, who takes over a file an agent could not settle.</bpmn:documentation>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="_712db9d0-6232-5c79-b2fc-767fce4145ce" name="Propose investments" awa:actorType="ai_agent">
      <bpmn:documentation>Propose the model portfolio that fits the risk profile and the sustainability preferences, and the funds the employee may choose instead, each with its key information document.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"procedure":"List the plan's funds and model portfolios with the fund tool. Propose the model portfolio whose summary risk indicator fits the profile, taking the sustainability preferences into account. List the funds within the profile as alternatives. Give the key information document of every fund you name. Never state a guaranteed return."}</awa:properties>
        <awa:tools>[{"name":"list_funds","description":"List the unit-linked funds and model portfolios of the plan, each with its key information document and its summary risk indicator.","parameters":{"type":"object","required":["plan_id"],"properties":{"plan_id":{"type":"string"},"max_sri":{"type":"integer","minimum":1,"maximum":7},"sustainability":{"type":"string"}}},"binding":{"kind":"http","method":"GET","url":"http://localhost:4560/funds/v1/plans/{plan_id}/funds","headers":{"x-api-key":"{{secret:FUND_PLATFORM_KEY}}"}}}]</awa:tools>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["proposed_allocation","allocation_total","max_fund_sri","kids","missing_kid_count","explanation"],"properties":{"proposed_allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},"allocation_total":{"type":"number"},"max_fund_sri":{"type":"integer","minimum":1,"maximum":7},"kids":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","kid_id"],"properties":{"fund_id":{"type":"string"},"kid_id":{"type":"string"}}}},"missing_kid_count":{"type":"integer","minimum":0},"model_portfolio":{"type":"string"},"explanation":{"type":"string","minLength":60}}},"postconditions":[{"name":"The allocation adds up to 100%","expression":"allocation_total == 100"},{"name":"Every fund named has its key information document","expression":"missing_kid_count == 0"}],"budgets":{"max_attempts":2,"max_tool_calls":4}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_f2a8ecb0-a039-5bfb-afa6-b6503373232d" name="Check choice against profile">
      <bpmn:documentation>Check the chosen allocation against the risk profile: its weighted summary risk indicator, the excess over the profile's maximum, and that every key information document was delivered.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"check_allocation","description":"Check an allocation against a risk profile: the weighted summary risk indicator, its excess over the profile's maximum, and whether every fund's key information document was delivered.","parameters":{"type":"object","required":["allocation","max_sri"],"properties":{"allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},"max_sri":{"type":"integer","minimum":1,"maximum":7},"enrolment_id":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/funds/v1/suitability-checks","headers":{"x-api-key":"{{secret:FUND_PLATFORM_KEY}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_3ac8e49e-a6b0-5154-bfa6-8b139dcc3c1b" name="Warn about the risk" awa:actorType="ai_agent">
      <bpmn:documentation>Tell the employee, in plain words, that the choice is riskier than the profile allows, by how much, and what they can do: adjust it, or keep it and acknowledge the risk after talking to an adviser.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["warning","portfolio_sri_stated","profile_stated","options_given"],"properties":{"warning":{"type":"string","minLength":80},"portfolio_sri_stated":{"type":"boolean"},"profile_stated":{"type":"boolean"},"options_given":{"type":"boolean"}}},"postconditions":[{"name":"States the choice's risk indicator","expression":"portfolio_sri_stated == true"},{"name":"States the profile","expression":"profile_stated == true"},{"name":"Says what the employee can do","expression":"options_given == true"}]}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="_aa073b03-5054-5eb5-9396-a20c4fd577a2" name="Discuss the risk with an adviser">
      <bpmn:documentation>A licensed adviser talks the choice through with an employee who wants to keep it, and records the employee's informed acknowledgement.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["acknowledgement_recorded","note"],"properties":{"acknowledgement_recorded":{"type":"boolean"},"note":{"type":"string","minLength":10}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="_5be98006-cbad-5d8f-be5e-527840e3256a" name="Approve choice above profile">
      <bpmn:documentation>A compliance officer accepts, or not, a choice above the profile that the employee insists on. Whoever advised the employee on it may not approve it.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["approved","allocation_confirmed"],"properties":{"approved":{"type":"boolean"},"allocation_confirmed":{"type":"boolean"},"note":{"type":"string"}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:callActivity id="_50dc64c6-2c14-56e2-848d-a960866e4298" name="Run identity and AML checks" calledElement="_d0fb8198-0fde-5fd9-8d79-2b3c558ca363">
      <bpmn:documentation>Run the customer due diligence by the Identity, AML and Tax Residence Checks workflow.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"subworkflow":{"input":{"enrolment_id":"enrolment_id","employee":"employee","documents":"documents","self_certification":"self_certification","tax_residence":"tax_residence"},"output":{"kyc_status":"kyc_status","cdd_level":"cdd_level","fatca_status":"fatca_status","crs_reportable":"crs_reportable","kyc_file_id":"kyc_file_id","screening_result":"screening_result"}}}</awa:properties>
        <awa:outcomeContract>{"postconditions":[{"name":"Says how the due diligence ended","expression":"kyc_status exists"}]}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:serviceTask id="_d5f45515-cadc-5ccb-b890-eadbabc5a25f" name="Review beneficiary clause" awa:actorType="ai_agent">
      <bpmn:documentation>Check the beneficiary clause: the standard clause, or named beneficiaries each identified, with shares that add up to 100%.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["clause_type","shares_total","unidentified_count","beneficiary_clause_valid"],"properties":{"clause_type":{"type":"string","enum":["standard","named"]},"shares_total":{"type":"number"},"unidentified_count":{"type":"integer","minimum":0},"beneficiary_clause_valid":{"type":"boolean"},"note":{"type":"string"}}},"postconditions":[{"name":"Shares add up to 100%","expression":"shares_total == 100"},{"name":"Every beneficiary is identified","expression":"unidentified_count == 0"}],"on_violation":"escalate_human"}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_de20ccd9-2e2a-5dee-ae78-ac63df97f0f8" name="Prepare contract for signature">
      <bpmn:documentation>Send the contract, the beneficiary clause and the payroll deduction mandate for e-signature.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"request_signature","description":"Send the subscription contract, the beneficiary clause and the payroll deduction mandate for e-signature.","parameters":{"type":"object","required":["enrolment_id","documents"],"properties":{"enrolment_id":{"type":"string"},"documents":{"type":"array","items":{"type":"string"}},"signer_email":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/esign/v1/envelopes","headers":{"authorization":"Bearer {{secret:ESIGN_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_ed60951c-f37c-5b76-9ac5-7f9e4fce092c" name="Issue policy">
      <bpmn:documentation>Issue the policy and open its account with the custodian bank.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"issue_policy","description":"Issue the policy in the policy administration system and open its unit-linked account with the custodian bank.","parameters":{"type":"object","required":["enrolment_id","plan_id","monthly_contribution_eur","allocation","beneficiary_clause"],"properties":{"enrolment_id":{"type":"string"},"plan_id":{"type":"string"},"monthly_contribution_eur":{"type":"number","exclusiveMinimum":0},"allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},"beneficiary_clause":{"type":"object"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/policy-admin/v1/policies","headers":{"authorization":"Bearer {{secret:POLICY_ADMIN_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_def60566-e9e2-5626-8349-1141b03be9d6" name="Set up payroll deduction">
      <bpmn:documentation>Set up the monthly payroll deduction the employee signed, from the next payroll.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"create_payroll_deduction","description":"Set up the monthly payroll deduction the employee signed, from the next payroll.","parameters":{"type":"object","required":["employee_number","policy_id","monthly_amount_eur"],"properties":{"employee_number":{"type":"string"},"policy_id":{"type":"string"},"monthly_amount_eur":{"type":"number","exclusiveMinimum":0}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/payroll/rpc","method":"payroll.create_deduction"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_064546c0-fcb8-5cb1-92d7-742cc19da66f" name="Invest first premium">
      <bpmn:documentation>Record the first premium and buy the units of the chosen allocation through the custodian bank.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"record_premium","description":"Record a premium on the policy and return the premiums paid in the tax year so far.","parameters":{"type":"object","required":["policy_id","period","amount_eur"],"properties":{"policy_id":{"type":"string"},"period":{"type":"string"},"amount_eur":{"type":"number","exclusiveMinimum":0},"paid_before_eur":{"type":"number","minimum":0}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/policy-admin/v1/policies/{policy_id}/premiums","headers":{"authorization":"Bearer {{secret:POLICY_ADMIN_TOKEN}}"}}},{"name":"place_order","description":"Buy units with a premium through the custodian bank: in the allocation given, or else in the policy's current allocation.","parameters":{"type":"object","required":["policy_id","amount_eur"],"properties":{"policy_id":{"type":"string"},"amount_eur":{"type":"number","exclusiveMinimum":0},"allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},"period":{"type":"string"}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/custody/rpc","method":"custody.place_order"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_2d932caa-81db-5a58-9c40-ac9769efa875" name="Send policy documents">
      <bpmn:documentation>Send the policy documents: the policy schedule, the key information documents, and the right to cancel within 30 days with a full refund.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_7c9cf587-2e49-5ce5-a4c4-5bb4e68c860a" name="Confirm policy in force">
      <bpmn:documentation>Mark the policy in force once the 30 days have passed without a cancellation.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_c1bf7220-5ff5-5fcc-8c65-b6c06571981b" name="Close subscription">
      <bpmn:documentation>Close the subscription: the employee did not continue within the time given.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_43c2dbdb-2396-53e3-b698-8b0aabf173cb" name="Record refusal">
      <bpmn:documentation>Record that the subscription is refused after the due diligence, and tell the employee.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_ffc7cd3c-f0fc-5291-86fa-49daf7cccfad" name="Cancel policy" isForCompensation="true">
      <bpmn:documentation>Cancel the policy from its start.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"cancel_policy","description":"Cancel a policy from its start, as if it had never been issued.","parameters":{"type":"object","required":["policy_id","reason"],"properties":{"policy_id":{"type":"string"},"reason":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/policy-admin/v1/policies/{policy_id}/cancellation","headers":{"authorization":"Bearer {{secret:POLICY_ADMIN_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_eb5ef360-8afd-59a8-8c55-dd4faab08425" name="Stop payroll deduction" isForCompensation="true">
      <bpmn:documentation>Stop the payroll deduction.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"stop_payroll_deduction","description":"Stop a payroll deduction.","parameters":{"type":"object","required":["deduction_id","reason"],"properties":{"deduction_id":{"type":"string"},"reason":{"type":"string"}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/payroll/rpc","method":"payroll.stop_deduction"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_e5bdad1f-5e0f-5ba9-90ad-d19597b3fa47" name="Redeem units and refund premium" isForCompensation="true">
      <bpmn:documentation>Sell the units bought and refund every premium paid in full: the plan bears any loss in value during the 30 days.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"redeem_units","description":"Sell every unit bought for a policy, through the custodian bank.","parameters":{"type":"object","required":["policy_id","reason"],"properties":{"policy_id":{"type":"string"},"reason":{"type":"string"}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/custody/rpc","method":"custody.redeem_all"}},{"name":"refund_premium","description":"Refund premiums to the employee's account.","parameters":{"type":"object","required":["policy_id","amount_eur","reason"],"properties":{"policy_id":{"type":"string"},"amount_eur":{"type":"number","minimum":0},"reason":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/policy-admin/v1/refunds","headers":{"authorization":"Bearer {{secret:POLICY_ADMIN_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Compensation_ed60951c-f37c-5b76-9ac5-7f9e4fce092c" attachedToRef="_ed60951c-f37c-5b76-9ac5-7f9e4fce092c">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_ed60951c-f37c-5b76-9ac5-7f9e4fce092c" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Compensation_def60566-e9e2-5626-8349-1141b03be9d6" attachedToRef="_def60566-e9e2-5626-8349-1141b03be9d6">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_def60566-e9e2-5626-8349-1141b03be9d6" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Compensation_064546c0-fcb8-5cb1-92d7-742cc19da66f" attachedToRef="_064546c0-fcb8-5cb1-92d7-742cc19da66f">
      <bpmn:compensateEventDefinition id="CompensateEventDefinition_064546c0-fcb8-5cb1-92d7-742cc19da66f" />
    </bpmn:boundaryEvent>
    <bpmn:startEvent id="_538b268e-e50d-5ad3-8db9-54671fd19de8" name="Profile completed">
      <bpmn:documentation>The employee's profile is known: the subscription starts.</bpmn:documentation>
      <bpmn:messageEventDefinition id="MessageEventDefinition_538b268e-e50d-5ad3-8db9-54671fd19de8" messageRef="Message_5" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="_a5f61c4d-f860-50c7-b0df-c1ced688aa37" name="Investments chosen">
      <bpmn:documentation>Wait for the employee's choice of funds in the portal.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_a5f61c4d-f860-50c7-b0df-c1ced688aa37" messageRef="Message_7" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="_6af23654-f6e1-5622-ab7b-0c5f8329ae2d" name="Choice reconsidered">
      <bpmn:documentation>Wait for the employee to adjust the choice, or to keep it and acknowledge the risk.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_6af23654-f6e1-5622-ab7b-0c5f8329ae2d" messageRef="Message_8" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_46d43db2-8216-5573-8432-b0804eea5010" name="Investments confirmed">
      <bpmn:documentation>Tell the journey the investments are settled.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","allocation","portfolio_sri","allocation_confirmed"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_46d43db2-8216-5573-8432-b0804eea5010" messageRef="Message_9" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="_6cf047d2-369b-5e24-b425-8311e33b1ffc" name="Subscription form submitted">
      <bpmn:documentation>Wait for the subscription form: documents, tax self-certification, beneficiary clause, monthly contribution.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_6cf047d2-369b-5e24-b425-8311e33b1ffc" messageRef="Message_10" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="_edd322e0-f06e-5878-8284-eb0d5975c7c8" name="Contract signed">
      <bpmn:documentation>Wait for the e-signature service to report the signed contract.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_edd322e0-f06e-5878-8284-eb0d5975c7c8" messageRef="Message_11" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="_9477f38c-cc91-56e1-b6aa-8987a1c50121" name="First premium received">
      <bpmn:documentation>Wait for the first payroll contribution. If none comes in 45 days the wait fails the run (EVENT_TIMEOUT), and compensation stops the deduction and cancels the policy.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id","timeout":"P45D"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_9477f38c-cc91-56e1-b6aa-8987a1c50121" messageRef="Message_12" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_d75ac4f9-ff37-5af8-a321-ab29daf1d9b2" name="Policy issued">
      <bpmn:documentation>Tell the journey the policy is issued and the first premium invested.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","policy_id","policy_issued","plan_id","employee","monthly_contribution_eur","allocation","max_sri","premiums_paid_eur","tax_year","deduction_id"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_d75ac4f9-ff37-5af8-a321-ab29daf1d9b2" messageRef="Message_13" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="_2534910f-c442-5d68-a4a0-0a4ad090c7d0" name="Cooling-off period">
      <bpmn:documentation>The 30 days in which the employee may cancel. A cancellation is the journey's exit policy.cancellation_requested: the host withdraws this run and compensation undoes the issue, the investment and the deduction. At the deadline, or when the policy administration closes the period, the policy is in force.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_2534910f-c442-5d68-a4a0-0a4ad090c7d0" messageRef="Message_14" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_07b34480-bd39-5128-a84c-340bd756e369" name="Policy in force">
      <bpmn:documentation>Tell the journey the policy is in force.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","policy_id","policy_in_force","in_force_on","premiums_paid_eur"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_07b34480-bd39-5128-a84c-340bd756e369" messageRef="Message_15" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_d8bb94a2-b80c-57de-873b-0506711ccf39" name="Subscription closed">
      <bpmn:documentation>Tell the journey the subscription was not completed.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","lapsed_reason"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_d8bb94a2-b80c-57de-873b-0506711ccf39" messageRef="Message_16" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="_8560818d-e47a-5a63-9db7-630b0865bcab" name="Subscription refused">
      <bpmn:documentation>Tell the journey the subscription was refused after due diligence.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","refusal_reason"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_8560818d-e47a-5a63-9db7-630b0865bcab" messageRef="Message_17" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="_d344b08f-38ff-58e0-baaa-b9e61f18d9de" name="Plan in force" />
    <bpmn:endEvent id="_325581ab-63b4-5ee2-bc7c-62bdf7d43567" name="Not subscribed" />
    <bpmn:endEvent id="_8454c33e-9881-591b-a5f8-f854ce2c12e0" name="Refused" />
    <bpmn:businessRuleTask id="_9417c5db-ad9d-5883-adac-42142c0747e0" name="Suitability of the choice" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_9417c5db-ad9d-5883-adac-42142c0747e0">
      <bpmn:documentation>Whether the chosen allocation fits the risk profile: its weighted summary risk indicator against the profile's maximum, and the key information documents delivered.</bpmn:documentation>
    </bpmn:businessRuleTask>
