  <bpmn:process id="_ac38e3b7-996e-5ca8-85b3-6591b9457d3b" name="Annual Review" isExecutable="true">
    <bpmn:documentation>The yearly review: the employee's changes of situation, the position of the plan, and the AI adviser's recommendations (rebalance, reduce the risk as retirement approaches, review the beneficiary clause after a life event), confirmed by a licensed adviser where they change the plan, then applied as the employee accepts them.</bpmn:documentation>
    <bpmn:extensionElements>
      <awa:properties>{"$schema":"https://awa.io/schema/awa.schema.json"}</awa:properties>
      <awa:contexts>[{"id":"47876230-d538-5cf9-982e-5016bc62139a","name":"employee_profile","type":"data","sync_pattern":"shared_state","description":"The employee as the AI adviser needs to know them for the review: first name, language, age, retirement age, tax residence and risk profile.","schema":{"type":"object","required":["first_name","tax_residence"],"properties":{"first_name":{"type":"string"},"preferred_language":{"type":"string"},"age":{"type":"integer"},"retirement_age":{"type":"integer"},"tax_residence":{"type":"string"},"risk_profile":{"type":"string"},"max_sri":{"type":"integer"},"horizon_years":{"type":"number"},"sustainability_preference":{"type":"string"},"monthly_contribution_eur":{"type":"number"}}}}]</awa:contexts>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_ac38e3b7-996e-5ca8-85b3-6591b9457d3b">
      <bpmn:lane id="_83e794e8-0760-5f30-8a22-199f962f0f6c" name="HR portal" awa:actorType="application">
        <bpmn:documentation>The HR portal Valoria Life provides to the employer.</bpmn:documentation>
        <bpmn:flowNodeRef>_884f17a5-d958-5821-9aeb-1f52bce61ea5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_52ca7d33-bd1a-5789-898f-c3a61945929a</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_83612add-f588-58d7-8ccb-f871e62acaf0" name="Custodian bank" awa:actorType="application">
        <bpmn:documentation>The custodian bank that holds the assets covering the policies.</bpmn:documentation>
        <bpmn:flowNodeRef>_62f3743b-1aee-5d42-85a4-5e30b59fa457</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_8059093c-2e7a-586f-9668-2a1052f19388</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_572033a9-6503-5923-b692-6b9287dbb431" name="AI adviser" awa:actorType="ai_agent">
        <bpmn:documentation>Recommends changes to the plan from the employee's situation and its position. Never promises a return.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["life insurance savings","lifecycle investing"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:reasoning","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_c07f36ef-dd4e-5b5b-90b3-e92a336375f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_9ac92339-da87-55ae-91a8-2c3858eb93a0" name="Licensed adviser" awa:actorType="human">
        <bpmn:documentation>Confirms recommendations that change the plan.</bpmn:documentation>
        <bpmn:flowNodeRef>_4b0e448f-661b-5cdb-b061-e3febdee1294</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_24dc90db-16e5-5fad-b805-2c8727428006" name="Policy administration" awa:actorType="application">
        <bpmn:documentation>Valoria Life's policy administration system.</bpmn:documentation>
        <bpmn:flowNodeRef>_eeda37ab-975d-5e8c-b9d6-ba405c86037f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="_884f17a5-d958-5821-9aeb-1f52bce61ea5" name="Invite to annual review">
      <bpmn:documentation>Invite the employee to the review in the HR portal: a few questions on what changed in the year.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
        <awa:contextBindings>[{"context_id":"47876230-d538-5cf9-982e-5016bc62139a","access_mode":"write"}]</awa:contextBindings>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_62f3743b-1aee-5d42-85a4-5e30b59fa457" name="Read the plan&#39;s position">
      <bpmn:documentation>Read the value, the units by fund and the drift from the target allocation.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"get_position","description":"Read the value of a policy, its units by fund and how far its allocation has drifted from the target.","parameters":{"type":"object","required":["policy_id"],"properties":{"policy_id":{"type":"string"},"target_allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}},"premiums_eur":{"type":"number","minimum":0}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/custody/rpc","method":"custody.get_position"}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_c07f36ef-dd4e-5b5b-90b3-e92a336375f3" name="Recommend changes" awa:actorType="ai_agent">
      <bpmn:documentation>Recommend what to change, with a reason for each: rebalance when the allocation has drifted, reduce the risk as retirement approaches, review the beneficiary clause after a life event, or no change.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"procedure":"Read the position, the answers and the profile. Recommend a rebalance when a fund has drifted more than five points from its target. Recommend reducing the risk when retirement is ten years away or less. Recommend reviewing the beneficiary clause after a marriage, a partnership, a birth, a divorce or a death. Say when a licensed adviser must confirm. Never promise or imply a guaranteed return on unit-linked funds; their value can fall.","guardrails":[{"id":"3c29345d-fca0-5418-878a-192e5d32f82f","name":"E-mail addresses, phone numbers and bank accounts in what the agent writes","stages":["output"],"check":{"kind":"personal_data","categories":["email","phone","iban"]},"action":"redact"}]}</awa:properties>
        <awa:contextBindings>[{"context_id":"47876230-d538-5cf9-982e-5016bc62139a","access_mode":"read"}]</awa:contextBindings>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["recommendations","recommendation_text","requires_adviser"],"properties":{"recommendations":{"type":"array","minItems":1,"items":{"type":"object","required":["type","reason"],"properties":{"type":{"type":"string","enum":["rebalance","reduce_risk","review_beneficiary","increase_contribution","no_change"]},"reason":{"type":"string","minLength":10}}}},"recommendation_text":{"type":"string","minLength":80},"requires_adviser":{"type":"boolean"},"target_allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}}}},"budgets":{"max_attempts":3,"max_duration":"PT5M","max_tokens":40000}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="_4b0e448f-661b-5cdb-b061-e3febdee1294" name="Confirm recommendations with an adviser">
      <bpmn:documentation>A licensed adviser confirms, or changes, recommendations that change the plan.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["recommendations_confirmed"],"properties":{"recommendations_confirmed":{"type":"boolean"},"note":{"type":"string"}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="_52ca7d33-bd1a-5789-898f-c3a61945929a" name="Publish recommendations">
      <bpmn:documentation>Put the recommendations in the HR portal for the employee to accept or decline.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"send_notification","description":"Send the employee a message in the HR portal's inbox, by e-mail, or both.","parameters":{"type":"object","required":["enrolment_id","channel","template"],"properties":{"enrolment_id":{"type":"string"},"channel":{"type":"string","enum":["portal","email","portal_and_email"]},"template":{"type":"string"},"subject":{"type":"string"},"body":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/portal/v1/notifications","headers":{"authorization":"Bearer {{secret:PORTAL_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_8059093c-2e7a-586f-9668-2a1052f19388" name="Apply accepted changes">
      <bpmn:documentation>Apply what the employee accepted: a switch to the new allocation, a new beneficiary clause.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"switch_funds","description":"Move the value of a policy to a new allocation, through the custodian bank.","parameters":{"type":"object","required":["policy_id","allocation"],"properties":{"policy_id":{"type":"string"},"allocation":{"type":"array","minItems":1,"items":{"type":"object","required":["fund_id","percent"],"properties":{"fund_id":{"type":"string"},"percent":{"type":"number","exclusiveMinimum":0,"maximum":100}}}}}},"binding":{"kind":"jsonrpc","endpoint":"http://localhost:4560/custody/rpc","method":"custody.switch"}},{"name":"update_beneficiary_clause","description":"Replace the beneficiary clause of a policy.","parameters":{"type":"object","required":["policy_id","beneficiary_clause"],"properties":{"policy_id":{"type":"string"},"beneficiary_clause":{"type":"object"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/policy-admin/v1/policies/{policy_id}/beneficiary-clause","headers":{"authorization":"Bearer {{secret:POLICY_ADMIN_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_eeda37ab-975d-5e8c-b9d6-ba405c86037f" name="Record the review">
      <bpmn:documentation>Record the review, the recommendations and what the employee decided.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:startEvent id="_512307dc-9046-5f4e-b900-22b1c4b24a5a" name="Review due">
      <bpmn:documentation>The anniversary of the policy: the insurer's calendar opens the annual review.</bpmn:documentation>
      <bpmn:messageEventDefinition id="MessageEventDefinition_512307dc-9046-5f4e-b900-22b1c4b24a5a" messageRef="Message_26" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="_e5b937b8-ee5e-51d6-9377-193b866f2275" name="Review answers received">
      <bpmn:documentation>Wait for the employee's answers: changes of situation, life events, whether the deduction was claimed.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_e5b937b8-ee5e-51d6-9377-193b866f2275" messageRef="Message_27" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="_4c74bb46-40a8-59e5-9a58-b28a90c55eba" name="Recommendations answered">
      <bpmn:documentation>Wait for the employee to accept or decline the recommendations.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"correlation_key":"enrolment_id"}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_4c74bb46-40a8-59e5-9a58-b28a90c55eba" messageRef="Message_28" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="_e7d38b0b-c2a5-5f8e-917d-d01aa2f7a74e" name="Review completed">
      <bpmn:documentation>Tell the journey the review is done.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"event_definition":{"data":["enrolment_id","review_completed","recommendations_accepted"]}}</awa:properties>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="MessageEventDefinition_e7d38b0b-c2a5-5f8e-917d-d01aa2f7a74e" messageRef="Message_29" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="_10be8bd4-8ca6-5cc9-ab72-77332ee8ee29" name="Reviewed" />
    <bpmn:businessRuleTask id="_654065b2-d667-52f1-b372-ac1bbd20ca63" name="Adviser needed" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_654065b2-d667-52f1-b372-ac1bbd20ca63">
      <bpmn:documentation>Recommendations that change the plan's risk or its beneficiaries are confirmed by a licensed adviser before the employee sees them.</bpmn:documentation>
    </bpmn:businessRuleTask>
