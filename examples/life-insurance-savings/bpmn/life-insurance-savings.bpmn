  <bpmn:collaboration id="Collaboration_d0fb8198-0fde-5fd9-8d79-2b3c558ca363">
    <bpmn:participant id="Participant_d0fb8198-0fde-5fd9-8d79-2b3c558ca363" name="Identity, AML and Tax Residence Checks" processRef="_d0fb8198-0fde-5fd9-8d79-2b3c558ca363" />
    <bpmn:participant id="Participant_6ff49b2a-cde9-5c66-9eb1-51d66d2472ac" name="Plan Invitation and Advice" processRef="_6ff49b2a-cde9-5c66-9eb1-51d66d2472ac" />
    <bpmn:participant id="Participant_51bb950b-7579-5ee2-81fb-4e1e29d7c18f" name="Savings Plan Subscription" processRef="_51bb950b-7579-5ee2-81fb-4e1e29d7c18f" />
    <bpmn:participant id="Participant_bbbdb5da-0532-5292-918e-c5a6224d576a" name="Payroll Contributions" processRef="_bbbdb5da-0532-5292-918e-c5a6224d576a" />
    <bpmn:participant id="Participant_bacf22dc-eb73-5156-8025-c4a318db6e4e" name="Self-Service Change" processRef="_bacf22dc-eb73-5156-8025-c4a318db6e4e" />
    <bpmn:participant id="Participant_fda1e521-702a-518a-bdba-97c991f9e71d" name="Year-End Tax" processRef="_fda1e521-702a-518a-bdba-97c991f9e71d" />
    <bpmn:participant id="Participant_ac38e3b7-996e-5ca8-85b3-6591b9457d3b" name="Annual Review" processRef="_ac38e3b7-996e-5ca8-85b3-6591b9457d3b" />
  </bpmn:collaboration>
  <bpmn:process id="_d0fb8198-0fde-5fd9-8d79-2b3c558ca363" name="Identity, AML and Tax Residence Checks" isExecutable="true">
    <bpmn:documentation>Customer due diligence before a life insurance contract is issued: identity documents read by an agent, screening against the lists of politically exposed persons and sanctions, the CRS and FATCA tax residence self-certification, and a compliance officer, then two approvers, for a politically exposed person or a possible sanctions match.</bpmn:documentation>
    <bpmn:extensionElements>
      <awa:properties>{"$schema":"https://awa.io/schema/awa.schema.json"}</awa:properties>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_d0fb8198-0fde-5fd9-8d79-2b3c558ca363">
      <bpmn:lane id="_aba5493f-675f-58e0-88ae-2d45aa6605ae" name="Document reader" awa:actorType="ai_agent">
        <bpmn:documentation>Reads identity documents and proofs of address and checks them against the enrolment.</bpmn:documentation>
        <bpmn:extensionElements>
          <awa:properties>{"capabilities":["document extraction","identity documents"]}</awa:properties>
          <awa:modelConfig>{"model_id":"tier:reasoning","temperature":0.2}</awa:modelConfig>
        </bpmn:extensionElements>
        <bpmn:flowNodeRef>_56c27f40-daf5-5d75-87c7-fa07dbf62500</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_c66bbb2d-f550-58b0-8efb-d4de4404a765" name="Screening service" awa:actorType="application">
        <bpmn:documentation>Screens people against the lists of politically exposed persons, sanctions and adverse media.</bpmn:documentation>
        <bpmn:flowNodeRef>_e7cca41a-238f-5e05-9bd0-574b792cd9be</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_c5fe41aa-9bfe-5cdf-bd9f-8cb2566a2191" name="KYC service" awa:actorType="application">
        <bpmn:documentation>Holds the due diligence files and validates tax self-certifications.</bpmn:documentation>
        <bpmn:flowNodeRef>_a7eabc03-11fb-5739-9ba1-5d6740e18278</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_ff0e18c1-3c9d-5e16-a102-c00ec85e3655</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_38b7886b-4698-5c36-920f-1b4a93056434</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="_feb1964d-e4b1-5db4-ab8e-1127a1361a26" name="Compliance officer" awa:actorType="human">
        <bpmn:documentation>Resolves screening alerts, establishes the source of wealth and approves business relationships with politically exposed persons.</bpmn:documentation>
        <bpmn:flowNodeRef>_2719d7e3-ff82-544f-b15f-c53a44934029</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>_82380bf0-48eb-501e-917f-a97ec28d202d</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="_56c27f40-daf5-5d75-87c7-fa07dbf62500" name="Verify identity documents" awa:actorType="ai_agent">
      <bpmn:documentation>Check the identity document and the proof of address: legible, in date, and matching the employee's name, date of birth and address.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:properties>{"procedure":"Extract each uploaded document with the document tool. Compare the name and date of birth with the enrolment. Check the identity document is in date. Count the documents you could not read. Say how sure you are.","guardrails":[{"id":"940d7e5e-6b45-57a6-9fcd-73017699705f","name":"Instructions inside uploaded documents","stages":["tool_result"],"check":{"kind":"prompt_injection"},"action":"block","tools":["extract_document"]},{"id":"16a5fa6d-ba6e-52dc-9a39-b427d7870b2d","name":"E-mail addresses, phone numbers and bank accounts in what the agent writes","stages":["output"],"check":{"kind":"personal_data","categories":["email","phone","iban"]},"action":"redact"}]}</awa:properties>
        <awa:tools>[{"name":"extract_document","description":"Read an uploaded identity document or proof of address: its type, whether it is legible, the fields printed on it and its text.","parameters":{"type":"object","required":["file_id","document_type"],"properties":{"file_id":{"type":"string"},"document_type":{"type":"string"},"enrolment_id":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/documents/v1/extractions","headers":{"x-api-key":"{{secret:DOCUMENTS_API_KEY}}"}}}]</awa:tools>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["identity_verified","unreadable_count","confidence","notes"],"properties":{"identity_verified":{"type":"boolean"},"unreadable_count":{"type":"integer","minimum":0},"document_expiry":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},"notes":{"type":"string","minLength":10}}},"postconditions":[{"name":"Every document is legible","expression":"unreadable_count == 0"},{"name":"Sure enough to act on","expression":"confidence &gt;= 0.8"}],"budgets":{"max_attempts":2,"max_duration":"PT5M","max_tokens":30000,"max_tool_calls":6},"on_violation":"escalate_human"}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_e7cca41a-238f-5e05-9bd0-574b792cd9be" name="Screen PEP and sanctions">
      <bpmn:documentation>Screen the employee against the lists of politically exposed persons, sanctions and adverse media.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"screen_person","description":"Screen a person against the lists of politically exposed persons, sanctions and adverse media.","parameters":{"type":"object","required":["enrolment_id","first_name","last_name","date_of_birth"],"properties":{"enrolment_id":{"type":"string"},"first_name":{"type":"string"},"last_name":{"type":"string"},"date_of_birth":{"type":"string"},"nationality":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/screening/v1/screenings","headers":{"authorization":"Bearer {{secret:SCREENING_TOKEN}}"}}}]</awa:tools>
        <awa:retry>{"max_attempts":3,"initial_delay":"PT2S","backoff_multiplier":2}</awa:retry>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_a7eabc03-11fb-5739-9ba1-5d6740e18278" name="Validate tax self-certification">
      <bpmn:documentation>Check the CRS and FATCA self-certification: the countries of tax residence, each tax identification number, and US status.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"validate_self_certification","description":"Check a tax residence self-certification for CRS and FATCA: the countries of residence, the format of each tax identification number, and US status.","parameters":{"type":"object","required":["enrolment_id","self_certification"],"properties":{"enrolment_id":{"type":"string"},"self_certification":{"type":"object"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/kyc/v1/self-certifications/validations","headers":{"authorization":"Bearer {{secret:KYC_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="_2719d7e3-ff82-544f-b15f-c53a44934029" name="Resolve compliance alert">
      <bpmn:documentation>A compliance officer resolves a screening alert or a self-certification that does not hold: confirms or clears the match, establishes the source of wealth and of the funds, and rates the risk.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:sla>{"id":"083776d8-a10d-5f70-919b-7c750ccd6425","name":"Alerts resolved within two working days","target_time":"P1D","max_time":"P2D","escalation_policy":{"breach_action":"record","notify_roles":["feb1964d-e4b1-5db4-ab8e-1127a1361a26"]}}</awa:sla>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["pep_confirmed","relationship_refused","note"],"properties":{"pep_confirmed":{"type":"boolean"},"relationship_refused":{"type":"boolean"},"source_of_wealth":{"type":"string"},"risk_rating":{"type":"string","enum":["low","medium","high"]},"note":{"type":"string","minLength":10}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="_82380bf0-48eb-501e-917f-a97ec28d202d" name="Approve PEP relationship">
      <bpmn:documentation>Two approvers accept, or refuse, a business relationship with a politically exposed person; the deployment's four-eyes rule makes the second approval necessary.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:outcomeContract>{"output_schema":{"type":"object","required":["approved"],"properties":{"approved":{"type":"boolean"},"note":{"type":"string"}}}}</awa:outcomeContract>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="_ff0e18c1-3c9d-5e16-a102-c00ec85e3655" name="Record due diligence">
      <bpmn:documentation>Record the due diligence file as accepted, with its level, its CRS reporting and its FATCA status.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"record_due_diligence","description":"Record the customer due diligence file: its level, the screening, the tax residences to report under CRS and the FATCA status.","parameters":{"type":"object","required":["enrolment_id","cdd_level","outcome"],"properties":{"enrolment_id":{"type":"string"},"cdd_level":{"type":"string"},"outcome":{"type":"string","enum":["accepted","refused"]},"screening_reference":{"type":"string"},"crs_reportable":{"type":"boolean"},"fatca_status":{"type":"string"},"note":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/kyc/v1/files","headers":{"authorization":"Bearer {{secret:KYC_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="_38b7886b-4698-5c36-920f-1b4a93056434" name="Record refusal of relationship">
      <bpmn:documentation>Record that the business relationship is refused.</bpmn:documentation>
      <bpmn:extensionElements>
        <awa:tools>[{"name":"record_due_diligence","description":"Record the customer due diligence file: its level, the screening, the tax residences to report under CRS and the FATCA status.","parameters":{"type":"object","required":["enrolment_id","cdd_level","outcome"],"properties":{"enrolment_id":{"type":"string"},"cdd_level":{"type":"string"},"outcome":{"type":"string","enum":["accepted","refused"]},"screening_reference":{"type":"string"},"crs_reportable":{"type":"boolean"},"fatca_status":{"type":"string"},"note":{"type":"string"}}},"binding":{"kind":"http","method":"POST","url":"http://localhost:4560/kyc/v1/files","headers":{"authorization":"Bearer {{secret:KYC_TOKEN}}"}}}]</awa:tools>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:startEvent id="_790d2cf0-af27-5078-b0ee-1feebbf72c8e" name="Checks requested">
      <bpmn:documentation>The subscription asks for the employee's due diligence.</bpmn:documentation>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="_41ae06b4-73ee-5f55-b3da-fc9b6b6d7fdb" name="Checks back">
      <bpmn:documentation>The screening and the self-certification are both back.</bpmn:documentation>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="_ac4ac0de-c073-58e1-b89c-2c01a4336e23" name="Checks passed" />
    <bpmn:endEvent id="_7f15c95d-0529-540a-b03a-155025c1ff31" name="Checks failed" />
    <bpmn:businessRuleTask id="_ad61d1cd-b838-5150-b862-0cb76f516565" name="Customer due diligence" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" awa:decisionRef="_ad61d1cd-b838-5150-b862-0cb76f516565">
      <bpmn:documentation>The level of due diligence and who decides it, from the identity check, the screening and the self-certification.</bpmn:documentation>
    </bpmn:businessRuleTask>
    <bpmn:parallelGateway id="Join_41ae06b4-73ee-5f55-b3da-fc9b6b6d7fdb" gatewayDirection="Converging" />
    <bpmn:exclusiveGateway id="Route_2719d7e3-ff82-544f-b15f-c53a44934029" gatewayDirection="Diverging" default="_2baf6af8-08b2-55aa-8d98-2afa873c6ac4" />
    <bpmn:exclusiveGateway id="Route_82380bf0-48eb-501e-917f-a97ec28d202d" gatewayDirection="Diverging" default="_07ceec69-3f46-5855-a52c-4ec2856b376f" />
    <bpmn:exclusiveGateway id="Route_ad61d1cd-b838-5150-b862-0cb76f516565" gatewayDirection="Diverging" default="_95a52f58-cddf-55f7-805d-c8a71a93ca2d" />
    <bpmn:sequenceFlow id="_42b56e71-afca-5b1d-9f46-c2ce21945ed6" sourceRef="_790d2cf0-af27-5078-b0ee-1feebbf72c8e" targetRef="_56c27f40-daf5-5d75-87c7-fa07dbf62500" />
    <bpmn:sequenceFlow id="_2c5c5d7e-b7ae-565e-84ec-91a65a858eac" sourceRef="_56c27f40-daf5-5d75-87c7-fa07dbf62500" targetRef="_e7cca41a-238f-5e05-9bd0-574b792cd9be" />
    <bpmn:sequenceFlow id="_446e5df5-eef5-5543-8e04-8fcb90eab955" sourceRef="_56c27f40-daf5-5d75-87c7-fa07dbf62500" targetRef="_a7eabc03-11fb-5739-9ba1-5d6740e18278" />
    <bpmn:sequenceFlow id="_3e5da5f8-7980-5bb3-ba98-e1fd3019b74a" sourceRef="_e7cca41a-238f-5e05-9bd0-574b792cd9be" targetRef="Join_41ae06b4-73ee-5f55-b3da-fc9b6b6d7fdb" />
    <bpmn:sequenceFlow id="_07419c0e-641b-556e-9617-a16d1ba590c5" sourceRef="_a7eabc03-11fb-5739-9ba1-5d6740e18278" targetRef="Join_41ae06b4-73ee-5f55-b3da-fc9b6b6d7fdb" />
    <bpmn:sequenceFlow id="_0c125a69-1183-594f-90bf-05e9af7fd5dd" sourceRef="_41ae06b4-73ee-5f55-b3da-fc9b6b6d7fdb" targetRef="_ad61d1cd-b838-5150-b862-0cb76f516565" />
    <bpmn:sequenceFlow id="_d6829d81-e75a-5a58-bea1-c28fb4e84f98" name="identity not verified" sourceRef="Route_ad61d1cd-b838-5150-b862-0cb76f516565" targetRef="_38b7886b-4698-5c36-920f-1b4a93056434">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://awa.io/schema/decision-route/1.1">chosen by rule 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="_95a52f58-cddf-55f7-805d-c8a71a93ca2d" name="alert" sourceRef="Route_ad61d1cd-b838-5150-b862-0cb76f516565" targetRef="_2719d7e3-ff82-544f-b15f-c53a44934029" />
    <bpmn:sequenceFlow id="_7c753667-c0a2-5710-b23f-36380a6e553c" name="clear" sourceRef="Route_ad61d1cd-b838-5150-b862-0cb76f516565" targetRef="_ff0e18c1-3c9d-5e16-a102-c00ec85e3655">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://awa.io/schema/decision-route/1.1">chosen by rules 4, 5</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="_ee70cc1f-3de9-5681-8a2f-ac53f02e7472" name="politically exposed" sourceRef="Route_2719d7e3-ff82-544f-b15f-c53a44934029" targetRef="_82380bf0-48eb-501e-917f-a97ec28d202d">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://www.omg.org/spec/DMN/20191111/FEEL/">pep_confirmed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="_c0d5507e-4481-52ba-b19b-b151d950c676" name="refused" sourceRef="Route_2719d7e3-ff82-544f-b15f-c53a44934029" targetRef="_38b7886b-4698-5c36-920f-1b4a93056434">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="https://www.omg.org/spec/DMN/20191111/FEEL/">relationship_refused = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="_2baf6af8-08b2-55aa-8d98-2afa873c6ac4" name="cleared" sourceRef="Route_2719d7e3-ff82-544f-b15f-c53a44934029" targetRef="_ff0e18c1-3c9d-5e16-a102-c00ec85e3655" />
