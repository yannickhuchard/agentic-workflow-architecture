  "decision_nodes": [
    {
      "id": "d906cec7-1cbf-506d-9418-a79a7d289a01",
      "name": "Risk profile",
      "description": "The risk profile, and the highest summary risk indicator (SRI, 1 to 7, from the key information documents) a choice may reach, from the suitability answers. THE BANDS ARE EXAMPLES each insurer sets in its own advice policy.",
      "decision_table": {
        "hit_policy": "first",
        "inputs": [
          {
            "name": "capacity_for_loss",
            "label": "Capacity for loss",
            "type": "string"
          },
          {
            "name": "horizon_years",
            "label": "Horizon (years)",
            "type": "number"
          },
          {
            "name": "risk_tolerance",
            "label": "Risk tolerance (1 to 5)",
            "type": "number"
          },
          {
            "name": "knowledge_level",
            "label": "Knowledge and experience",
            "type": "string"
          }
        ],
        "outputs": [
          {
            "name": "risk_profile",
            "type": "string"
          },
          {
            "name": "max_sri",
            "type": "number"
          }
        ],
        "rules": [
          {
            "description": "No loss can be borne",
            "input_entries": [
              "\"none\"",
              "-",
              "-",
              "-"
            ],
            "output_entries": [
              "cautious",
              2
            ]
          },
          {
            "description": "A horizon under five years",
            "input_entries": [
              "-",
              "< 5",
              "-",
              "-"
            ],
            "output_entries": [
              "cautious",
              2
            ]
          },
          {
            "description": "A low risk tolerance, or a limited capacity for loss",
            "input_entries": [
              "-",
              "-",
              "<= 2",
              "-"
            ],
            "output_entries": [
              "moderate",
              3
            ]
          },
          {
            "description": "A limited capacity for loss",
            "input_entries": [
              "\"limited\"",
              "-",
              "-",
              "-"
            ],
            "output_entries": [
              "moderate",
              3
            ]
          },
          {
            "description": "High tolerance, long horizon, informed investor",
            "input_entries": [
              "\"moderate\", \"substantial\"",
              ">= 15",
              ">= 4",
              "\"informed\", \"advanced\""
            ],
            "output_entries": [
              "dynamic",
              5
            ]
          },
          {
            "description": "Everyone else",
            "input_entries": [
              "-",
              "-",
              "-",
              "-"
            ],
            "output_entries": [
              "balanced",
              4
            ]
          }
        ]
      },
      "default_output_edge_id": "f007ac1c-d18a-5b7b-8738-731f70aeaef0"
    }
  ],
