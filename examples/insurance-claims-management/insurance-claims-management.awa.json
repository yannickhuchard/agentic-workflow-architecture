    "decision_nodes": [
        {
            "id": "7967f9ef-a547-52d8-a25e-3b6d9ee19a12",
            "name": "Claim Routing Decision",
            "description": "Routes claims based on amount, fraud score, and confidence. 95% of claims go through automated approval, 3% require high-value human review, 2% require exception/fraud investigation.",
            "decision_table": {
                "hit_policy": "first",
                "inputs": [
                    {
                        "name": "claim_amount",
                        "label": "Claim Amount ($)",
                        "type": "number"
                    },
                    {
                        "name": "fraud_score",
                        "label": "Fraud Risk Score",
                        "type": "number"
                    },
                    {
                        "name": "confidence_score",
                        "label": "AI Confidence",
                        "type": "number"
                    },
                    {
                        "name": "has_exception",
                        "label": "Has Exception Flag",
                        "type": "boolean"
                    }
                ],
                "outputs": [
                    {
                        "name": "route",
                        "label": "Routing Decision",
                        "type": "string",
                        "allowed_values": [
                            "auto_approve",
                            "human_highvalue",
                            "human_exception"
                        ]
                    }
                ],
                "rules": [
                    {
                        "id": "adff08c9-0677-5150-ab63-a3d13e8f30a9",
                        "description": "High fraud score or exception → Human exception review",
                        "input_entries": [
                            "-",
                            "> 70",
                            "-",
                            "-"
                        ],
                        "output_entries": [
                            "human_exception"
                        ],
                        "output_edge_id": "13272354-679e-5d9a-99af-4bf636292f20"
                    },
                    {
                        "id": "500fecc4-cc7b-5e2b-b487-df8041db2712",
                        "description": "Exception flagged → Human exception review",
                        "input_entries": [
                            "-",
                            "-",
                            "-",
                            "true"
                        ],
                        "output_entries": [
                            "human_exception"
                        ],
                        "output_edge_id": "13272354-679e-5d9a-99af-4bf636292f20"
                    },
                    {
                        "id": "f6527300-0324-510f-ac12-b1cc4895578e",
                        "description": "Low AI confidence → Human review",
                        "input_entries": [
                            "-",
                            "-",
                            "< 0.7",
                            "-"
                        ],
                        "output_entries": [
                            "human_highvalue"
                        ],
                        "output_edge_id": "c09e61a6-0c00-5ed8-bc72-2f1dd857a6bb"
                    },
                    {
                        "id": "49554cfa-70b9-51a8-ab69-3a3c14423d36",
                        "description": "High value claims → Human review",
                        "input_entries": [
                            "> 10000",
                            "< 70",
                            ">= 0.7",
                            "false"
                        ],
                        "output_entries": [
                            "human_highvalue"
                        ],
                        "output_edge_id": "c09e61a6-0c00-5ed8-bc72-2f1dd857a6bb"
                    },
                    {
                        "id": "f0c612c2-84fe-59b0-aeb3-eb08fc22c60c",
                        "description": "Standard claims → Automated approval (95% of cases)",
                        "input_entries": [
                            "<= 10000",
                            "< 30",
                            ">= 0.85",
                            "false"
                        ],
                        "output_entries": [
                            "auto_approve"
                        ],
                        "output_edge_id": "4f8e3d0d-3377-5084-b84d-93bb1986e37d"
                    }
                ]
            },
            "default_output_edge_id": "c09e61a6-0c00-5ed8-bc72-2f1dd857a6bb"
        }
    ],
