      "programs": [],
      "controls": [],
      "is_expandable": false,
      "skills": [],
      "tool_requirements": [],
      "outcome_contract": {
        "output_schema": {
          "type": "object",
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "postconditions": [],
        "on_violation": "fail"
      }
    },
    {
      "id": "d29a2625-600e-5e05-844f-bbb5f042e6f7",
      "name": "Send it back to composition",
      "description": "Record the reviewer's note and compose again.",
      "role_id": "f989a2af-251d-5dd8-a82e-72a73a5bcd02",
      "actor_type": "application",
      "inputs": [],
