{
    "name": "agentic-workflow-architecture",
    "version": "2.0.0",
    "description": "TypeScript SDK for Agentic Workflow Architecture (AWA)",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "bin": {
        "awa": "dist/cli/index.js"
    },
    "scripts": {
        "build": "tsup src/index.ts src/cli/index.ts --format cjs,esm --dts --shims && node scripts/copy-views.mjs",
        "dev": "tsup src/index.ts src/cli/index.ts --format cjs,esm --dts --watch",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "lint": "eslint src/",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.src.json",
        "build:measures": "esbuild src/runtime/kpi.ts --bundle --format=iife --global-name=AWA_MEASURES --target=es2019 --banner:js=\"// Generated from sdk/typescript/src/runtime/kpi.ts by npm run build:measures. Do not edit.\" --outfile=../../tools/visualization/awa-kpis.js --log-level=warning",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "dist",
        "prisma/schema.prisma",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "keywords": [
        "awa",
        "agentic",
        "workflow",
        "process",
        "bpmn",
        "ai-agent"
    ],
    "author": "Yannick HUCHARD",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yannickhuchard/agentic-workflow-architecture.git"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^6.19.2",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "commander": "^14.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.2.4",
        "express": "^5.2.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@a2a-js/sdk": "^1.3.0",
        "@grpc/grpc-js": "^1.14.7",
        "@grpc/proto-loader": "^0.8.1",
        "@grpc/reflection": "^1.0.4",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
        "@opentelemetry/sdk-trace": "^3.1.1",
        "@opentelemetry/semantic-conventions": "1.45.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.0",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "eslint": "^8.56.0",
        "pg": "^8.23.1",
        "prisma": "^6.19.2",
        "protobufjs": "^8.8.1",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "peerDependencies": {
        "@huggingface/transformers": ">=3.0.0",
        "typescript": ">=5.0.0",
        "@grpc/grpc-js": ">=1.10.0",
        "@grpc/proto-loader": ">=0.7.0",
        "pg": ">=8.11.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "peerDependenciesMeta": {
        "@huggingface/transformers": {
            "optional": true
        },
        "@grpc/grpc-js": {
            "optional": true
        },
        "@grpc/proto-loader": {
            "optional": true
        },
        "pg": {
            "optional": true
        }
    },
    "overrides": {
        "deepmerge-ts": "^8.0.0",
        "effect": "^3.22.5"
    }
}
