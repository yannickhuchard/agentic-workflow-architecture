      "card": {
        "name": "Claims assessor",
        "description": "Claims assessor, reached over A2A",
        "version": "1.0.0",
        "supportedInterfaces": [
          {
            "url": "https://agents.example/claims/a2a",
            "protocolBinding": "JSONRPC",
            "protocolVersion": "1.0"
          }
        ],
        "capabilities": {
          "streaming": false,
          "pushNotifications": false
        },
        "defaultInputModes": [
          "application/json",
          "text/plain"
        ],
        "defaultOutputModes": [
          "application/json"
        ],
        "skills": [
          {
            "id": "assess",
            "name": "Assess",
            "description": "Assess a claim",
            "tags": [
              "claims"
            ]
          }
        ]
      },
      "replies": [
        {
          "result": {
            "task": {
              "id": "task-1",
              "contextId": "ctx-1",
              "status": {
                "state": "TASK_STATE_COMPLETED"
              },
              "artifacts": [
                {
                  "artifactId": "a0",
                  "parts": [
                    {
                      "data": {
                        "decision": "approve"
                      },
                      "mediaType": "application/json"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "expect": {
    "status": "failed",
    "agent_card_reads": 0,
    "agent_requests": [],
    "journal_count": {
      "activity.started": 1
    },
    "journal_contains": [
      {
        "type": "activity.failed",
        "data": {
          "error": {
            "code": "PERMISSION_DENIED"
