            "protocolVersion": "1.0"
          }
        ],
        "capabilities": {
          "streaming": false,
          "pushNotifications": false
        },
        "defaultInputModes": [
          "application/json",
          "text/plain"
        ],
        "defaultOutputModes": [
          "application/json"
        ],
        "skills": [
          {
            "id": "assess",
