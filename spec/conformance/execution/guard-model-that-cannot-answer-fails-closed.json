      {
        "text": "I think it is fine"
      }
    ]
  },
  "expect": {
    "status": "failed",
    "journal_contains": [
      {
        "type": "guardrail.triggered",
        "data": {
          "check": "model",
          "action": "block"
        }
      },
      {
        "type": "token.failed",
        "data": {
          "error": {
            "code": "GUARDRAIL_ERROR"
          }
        }
      }
    ]
  }
}
