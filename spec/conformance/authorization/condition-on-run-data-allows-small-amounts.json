{
  "id": "condition-on-run-data-allows-small-amounts",
  "level": "authorization",
  "spec": "30.2",
  "description": "The same policy lets a clerk settle a claim whose amount is below the threshold.",
  "workflow": {
    "id": "b3d1481a-286c-5b2f-9db3-5f86bb44f348",
    "name": "condition-on-run-data-allows-small-amounts",
    "version": "1.0.0",
    "awa_version": "1.1",
    "activities": [
      {
        "id": "f16282e1-fdad-53ea-8039-84668ab25d6a",
        "name": "Settle",
        "role_id": "cb09b49b-7704-5c79-a4e7-9b2b797b13c3",
        "actor_type": "human"
      }
    ],
    "edges": [],
    "roles": [
      {
        "id": "cb09b49b-7704-5c79-a4e7-9b2b797b13c3",
        "name": "Settler",
        "actor_type": "human"
      }
    ]
  },
  "authorization": {
    "policy": {
      "rules": [
        {
          "id": "host-starts",
          "effect": "allow",
          "actions": [
            "start_run"
          ],
          "subject": {
            "ids": [
              "host"
            ]
          }
        },
        {
          "id": "clerks-small",
          "effect": "allow",
          "actions": [
            "complete_task"
          ],
          "subject": {
            "roles": [
              "clerk"
            ]
          },
          "condition": "run.amount < 10000"
        },
        {
          "id": "cleared-approvers",
          "effect": "allow",
          "actions": [
            "complete_task"
          ],
          "subject": {
            "roles": [
              "approver"
            ]
          },
          "condition": "principal.attributes.clearance >= 3"
        }
      ]
    },
    "record_allows": true
  },
  "steps": [
    {
      "start": {
        "input": {
          "amount": 500
        }
      },
      "expect": {
        "allowed": true
      }
    },
    {
      "complete": {
        "activity": "Settle",
        "principal": {
          "id": "carol",
          "kind": "person",
          "attributes": {
            "roles": [
              "clerk"
            ],
            "contractor": true
          }
        },
        "output": {
          "paid": true
        }
      },
      "expect": {
        "allowed": true
      }
    }
  ],
  "expect": {
    "status": "completed",
    "decisions": [
      {
        "action": "complete_task",
        "decision": "allow",
        "principal": {
          "id": "carol",
          "kind": "person"
        },
        "rule": "clerks-small",
        "reason": "rule",
        "resource": {
          "workflow_name": "condition-on-run-data-allows-small-amounts",
          "activity_name": "Settle",
          "role_name": "Settler"
        }
      }
    ]
  }
}
