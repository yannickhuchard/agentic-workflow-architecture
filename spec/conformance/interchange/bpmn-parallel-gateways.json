  "description": "A diverging parallel gateway is an intermediate event that splits; a converging one before a task is that task's join \"all\". An unnamed process takes its participant's name.",
  "bpmn": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:awa=\"https://awa.io/schema/interchange/1.1\" id=\"Definitions_and\" targetNamespace=\"https://example.com/bpmn\">\n<bpmn:collaboration id=\"C\"><bpmn:participant id=\"Pool\" name=\"Parallel checks\" processRef=\"P\"/></bpmn:collaboration>\n<bpmn:process id=\"P\">\n<bpmn:startEvent id=\"S\"/>\n<bpmn:parallelGateway id=\"Gs\" name=\"Split\"/>\n<bpmn:serviceTask id=\"T_a\" name=\"Check identity\"/>\n<bpmn:serviceTask id=\"T_b\" name=\"Check credit\"/>\n<bpmn:parallelGateway id=\"Gj\"/>\n<bpmn:serviceTask id=\"T_c\" name=\"Decide\"/>\n<bpmn:endEvent id=\"E\"/>\n<bpmn:sequenceFlow id=\"F1\" sourceRef=\"S\" targetRef=\"Gs\"/>\n<bpmn:sequenceFlow id=\"F2\" sourceRef=\"Gs\" targetRef=\"T_a\"/>\n<bpmn:sequenceFlow id=\"F3\" sourceRef=\"Gs\" targetRef=\"T_b\"/>\n<bpmn:sequenceFlow id=\"F4\" sourceRef=\"T_a\" targetRef=\"Gj\"/>\n<bpmn:sequenceFlow id=\"F5\" sourceRef=\"T_b\" targetRef=\"Gj\"/>\n<bpmn:sequenceFlow id=\"F6\" sourceRef=\"Gj\" targetRef=\"T_c\"/>\n<bpmn:sequenceFlow id=\"F7\" sourceRef=\"T_c\" targetRef=\"E\"/>\n</bpmn:process>\n</bpmn:definitions>\n",
