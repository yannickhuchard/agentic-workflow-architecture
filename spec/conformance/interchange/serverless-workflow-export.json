        "target_id": "0f315e0c-4f20-578a-a4f0-196057679532"
      },
      {
        "id": "6bc04070-f977-5f29-bb10-31597c794f0f",
        "source_id": "0f315e0c-4f20-578a-a4f0-196057679532",
        "target_id": "fdba26e2-62db-5fa5-9bd1-2cad38543e7f",
        "condition": "amount > 1000",
        "label": "Large"
      },
      {
        "id": "41e49077-71ae-55b8-8bfe-74b0a1ac2e58",
        "source_id": "0f315e0c-4f20-578a-a4f0-196057679532",
        "target_id": "e0f235b6-bcbd-5000-a964-44087db3b5c0",
