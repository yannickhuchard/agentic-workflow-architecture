  "kind": "import_bpmn",
  "description": "An inclusive split becomes a parallel split into guards that take or skip their branch, and every branch meets the matching join through a merge, so the join waits for exactly one token per branch.",
  "bpmn": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:awa=\"https://awa.io/schema/interchange/1.1\" id=\"Definitions_or\" targetNamespace=\"https://example.com/bpmn\">\n<bpmn:process id=\"P\" name=\"Claim checks\">\n<bpmn:startEvent id=\"S\"/>\n<bpmn:serviceTask id=\"T_in\" name=\"Assess\"/>\n<bpmn:inclusiveGateway id=\"G\" name=\"Which checks?\" default=\"F_none\"/>\n<bpmn:serviceTask id=\"T_med\" name=\"Medical check\"/>\n<bpmn:serviceTask id=\"T_veh\" name=\"Vehicle check\"/>\n<bpmn:serviceTask id=\"T_none\" name=\"Basic check\"/>\n<bpmn:inclusiveGateway id=\"J\" name=\"Checks done\"/>\n<bpmn:serviceTask id=\"T_out\" name=\"Decide\"/>\n<bpmn:endEvent id=\"E\"/>\n<bpmn:sequenceFlow id=\"F1\" sourceRef=\"S\" targetRef=\"T_in\"/>\n<bpmn:sequenceFlow id=\"F2\" sourceRef=\"T_in\" targetRef=\"G\"/>\n<bpmn:sequenceFlow id=\"F_med\" sourceRef=\"G\" targetRef=\"T_med\" name=\"injury\"><bpmn:conditionExpression xsi:type=\"bpmn:tFormalExpression\" language=\"https://www.omg.org/spec/DMN/20191111/FEEL/\">injury = true</bpmn:conditionExpression></bpmn:sequenceFlow>\n<bpmn:sequenceFlow id=\"F_veh\" sourceRef=\"G\" targetRef=\"T_veh\"><bpmn:conditionExpression xsi:type=\"bpmn:tFormalExpression\" language=\"https://www.omg.org/spec/DMN/20191111/FEEL/\">vehicle_damage = true</bpmn:conditionExpression></bpmn:sequenceFlow>\n<bpmn:sequenceFlow id=\"F_none\" sourceRef=\"G\" targetRef=\"T_none\"/>\n<bpmn:sequenceFlow id=\"F_m\" sourceRef=\"T_med\" targetRef=\"J\"/>\n<bpmn:sequenceFlow id=\"F_v\" sourceRef=\"T_veh\" targetRef=\"J\"/>\n<bpmn:sequenceFlow id=\"F_n\" sourceRef=\"T_none\" targetRef=\"J\"/>\n<bpmn:sequenceFlow id=\"F_o\" sourceRef=\"J\" targetRef=\"T_out\"/>\n<bpmn:sequenceFlow id=\"F_e\" sourceRef=\"T_out\" targetRef=\"E\"/>\n</bpmn:process>\n</bpmn:definitions>\n",
