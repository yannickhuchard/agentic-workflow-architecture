  "spec": "27.3",
  "kind": "import_bpmn",
  "description": "An embedded subprocess and a call activity are expandable activities. The subprocess's content is a workflow of its own; the call activity names the process it calls. Processes come first, then subprocesses.",
  "bpmn": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:awa=\"https://awa.io/schema/interchange/1.1\" id=\"Definitions_sub\" targetNamespace=\"https://example.com/bpmn\">\n<bpmn:process id=\"P_main\" name=\"Claim\">\n<bpmn:startEvent id=\"S\"/>\n<bpmn:subProcess id=\"SP\" name=\"Collect documents\">\n<bpmn:startEvent id=\"S2\"/>\n<bpmn:userTask id=\"T_upload\" name=\"Upload documents\"/>\n<bpmn:endEvent id=\"E2\"/>\n<bpmn:sequenceFlow id=\"G1\" sourceRef=\"S2\" targetRef=\"T_upload\"/>\n<bpmn:sequenceFlow id=\"G2\" sourceRef=\"T_upload\" targetRef=\"E2\"/>\n</bpmn:subProcess>\n<bpmn:callActivity id=\"CA\" name=\"Run checks\" calledElement=\"P_check\"/>\n<bpmn:endEvent id=\"E\"/>\n<bpmn:sequenceFlow id=\"F1\" sourceRef=\"S\" targetRef=\"SP\"/>\n<bpmn:sequenceFlow id=\"F2\" sourceRef=\"SP\" targetRef=\"CA\"/>\n<bpmn:sequenceFlow id=\"F3\" sourceRef=\"CA\" targetRef=\"E\"/>\n</bpmn:process>\n<bpmn:process id=\"P_check\" name=\"Checks\">\n<bpmn:startEvent id=\"S3\"/>\n<bpmn:serviceTask id=\"T_check\" name=\"Check\"/>\n<bpmn:endEvent id=\"E3\"/>\n<bpmn:sequenceFlow id=\"H1\" sourceRef=\"S3\" targetRef=\"T_check\"/>\n<bpmn:sequenceFlow id=\"H2\" sourceRef=\"T_check\" targetRef=\"E3\"/>\n</bpmn:process>\n</bpmn:definitions>\n",
