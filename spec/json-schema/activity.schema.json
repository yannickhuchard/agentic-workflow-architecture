{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://awa.io/schema/activity.schema.json",
    "title": "Activity",
    "description": "A unit of work in the agentic workflow",
    "type": "object",
    "required": [
        "id",
        "name",
        "role_id",
        "actor_type"
    ],
    "properties": {
        "id": {
            "$ref": "awa.schema.json#/$defs/uuid",
            "description": "Unique identifier"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Activity title"
        },
        "description": {
            "type": "string",
            "description": "High-level summary of what the activity does and why it is performed"
        },
        "procedure": {
            "type": "string",
            "description": "Step-by-step instructions for HOW to perform this activity. This is the natural language algorithm that serves as executable logic for AI agents, procedural documentation for humans, and API sequence specification for applications."
        },
        "role_id": {
            "$ref": "awa.schema.json#/$defs/uuid",
            "description": "Performing role reference"
        },
        "actor_type": {
            "$ref": "awa.schema.json#/$defs/actor_type"
        },
        "system_id": {
            "$ref": "awa.schema.json#/$defs/uuid",
            "description": "Enterprise system used"
        },
        "machine_id": {
            "$ref": "awa.schema.json#/$defs/uuid",
            "description": "Physical device/robot"
        },
        "endpoint_id": {
            "$ref": "awa.schema.json#/$defs/uuid",
            "description": "API endpoint"
        },
        "organization_id": {
            "$ref": "awa.schema.json#/$defs/uuid",
            "description": "Organization performing this activity"
        },
        "inputs": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/data_object"
            },
            "description": "Input data specifications"
        },
        "outputs": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/data_object"
            },
            "description": "Output data specifications"
        },
        "context_bindings": {
            "type": "array",
            "items": {
                "$ref": "context.schema.json#/$defs/context_binding"
            },
            "description": "Context bindings for this activity"
        },
        "access_rights": {
            "type": "array",
            "items": {
                "$ref": "access-right.schema.json"
            },
            "description": "Required or provisioned access rights"
        },
        "programs": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/program"
            },
            "description": "Executable implementations"
        },
        "controls": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/control"
            },
            "description": "Compliance policies"
        },
        "sla": {
            "$ref": "sla.schema.json",
            "description": "Activity-level SLA"
        },
        "analytics": {
            "$ref": "analytics.schema.json",
            "description": "VSM metrics for this activity"
        },
        "is_expandable": {
            "type": "boolean",
            "default": false,
            "description": "Can this activity be expanded to a sub-workflow"
        },
        "expansion_workflow_id": {
            "$ref": "awa.schema.json#/$defs/uuid",
            "description": "Sub-workflow expanding this activity. With is_expandable true, the activity is performed by a child run of this workflow (specification 24)"
        },
        "subworkflow": {
            "type": "object",
            "description": "How a call activity's child run is given its input and how its output becomes the activity's outcome (specification 24.1)",
            "properties": {
                "input": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": "Each property of the child run's input, with the path in the parent token's data it is read from. When absent, the child is given the data the activity would be given"
                },
                "output": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": "Each property of the activity's outcome, with the path in the child run's output it is read from. When absent, the outcome is the child run's output"
                }
            },
            "additionalProperties": false
        },
        "skills": {
            "type": "array",
            "items": {
                "$ref": "awa.schema.json#/$defs/skill_binding"
            },
            "description": "Skills (Cognitive/Expertise) required to perform this activity"
        },
        "tool_requirements": {
            "type": "array",
            "items": {
                "$ref": "awa.schema.json#/$defs/tool_requirement"
            },
            "description": "Tools (Interfaces/Software) required to perform this activity"
        },
        "verification": {
            "$ref": "#/$defs/verification_policy",
            "description": "Acceptance verification applied to the activity output. Fail closed: an output that is not verified as 'pass' is rejected."
        },
        "retry": {
            "$ref": "#/$defs/retry_policy",
            "description": "What the engine does when the actor raises an error"
        },
        "outcome_contract": {
            "$ref": "#/$defs/outcome_contract",
            "description": "What must be true of the activity's outcome, whatever strategy the actor used"
        },
        "join": {
            "type": "string",
            "enum": [
                "any",
                "all"
            ],
            "default": "any",
            "description": "How tokens arriving over several incoming edges are treated. any: each token executes the activity. all: the engine waits for a token on every incoming edge, merges them and executes the activity once."
        },
        "compensation": {
            "type": "object",
            "required": [
                "activity_id"
            ],
            "properties": {
                "activity_id": {
                    "$ref": "awa.schema.json#/$defs/uuid",
                    "description": "Activity that undoes this one if the run later fails. It must not be the target of any edge."
                }
            },
            "description": "How to undo this activity"
        },
        "knowledge": {
            "type": "object",
            "description": "Asks the engine to give the actor knowledge distilled from earlier runs of this activity",
            "properties": {
                "types": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "strategy",
                            "failure_pattern",
                            "decision_precedent",
                            "lesson"
                        ]
                    },
                    "default": [
                        "strategy",
                        "failure_pattern"
                    ]
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Only entries carrying at least one of these tags"
                },
                "max_entries": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 5
                },
                "min_status": {
                    "type": "string",
                    "enum": [
                        "draft",
                        "reviewed"
                    ],
                    "default": "reviewed",
                    "description": "reviewed: only entries a person has reviewed. draft: unreviewed entries as well."
                }
            }
        },
        "tools": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/tool"
            },
            "description": "Functions the actor may call while performing the activity. Every call is journalled with a link to what it ran."
        },
        "a2a": {
            "$ref": "#/$defs/a2a_agent",
            "description": "The agent that performs this activity over A2A, replacing its role's"
        }
    },
    "$defs": {
        "data_object": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "schema": {
                    "type": "object",
                    "description": "JSON Schema of the data object"
                },
                "required": {
                    "type": "boolean",
                    "default": true
                }
            }
        },
        "program": {
            "type": "object",
            "required": [
                "id",
                "name",
                "language"
            ],
            "properties": {
                "id": {
                    "$ref": "awa.schema.json#/$defs/uuid"
                },
                "name": {
                    "type": "string"
                },
                "language": {
                    "type": "string",
                    "enum": [
                        "python",
                        "typescript",
                        "javascript",
                        "java",
                        "sql",
                        "mcp_tool",
                        "rest_api",
                        "graphql",
                        "shell"
                    ]
                },
                "code": {
                    "type": "string",
                    "description": "Inline code"
                },
                "code_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "External code reference"
                },
                "parameters": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "type"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string"
                            },
                            "required": {
                                "type": "boolean",
                                "default": true
                            },
                            "default": {}
                        }
                    }
                },
                "mcp_server": {
                    "type": "string",
                    "description": "MCP server name for mcp_tool language"
                }
            }
        },
        "control": {
            "type": "object",
            "required": [
                "id",
                "name",
                "type"
            ],
            "properties": {
                "id": {
                    "$ref": "awa.schema.json#/$defs/uuid"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "type": {
                    "$ref": "awa.schema.json#/$defs/control_type"
                },
                "expression": {
                    "type": "string",
                    "description": "Executable policy expression"
                },
                "enforcement": {
                    "$ref": "awa.schema.json#/$defs/enforcement"
                }
            }
        },
        "verification_criterion": {
            "type": "object",
            "required": [
                "id",
                "name",
                "description",
                "type"
            ],
            "properties": {
                "id": {
                    "$ref": "awa.schema.json#/$defs/uuid"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string",
                    "description": "What must be true of the output, in natural language"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "completeness",
                        "accuracy",
                        "format",
                        "compliance",
                        "custom"
                    ]
                },
                "expression": {
                    "type": "string",
                    "description": "Condition expression (see specification, Condition Expressions) evaluated against the output. Required for deterministic verification."
                },
                "weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 1
                },
                "required": {
                    "type": "boolean",
                    "default": true,
                    "description": "If true, failing this criterion fails verification regardless of score"
                }
            }
        },
        "verification_policy": {
            "type": "object",
            "required": [
                "criteria"
            ],
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "default": true
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "ai_judge",
                        "schema_only",
                        "custom"
                    ],
                    "default": "ai_judge",
                    "description": "ai_judge: a model evaluates each criterion. schema_only: only criterion expressions are evaluated, deterministically. custom: an engine-registered verifier."
                },
                "criteria": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/verification_criterion"
                    }
                },
                "max_retries": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10,
                    "default": 3
                },
                "retry_with_feedback": {
                    "type": "boolean",
                    "default": true,
                    "description": "Feed the failed criteria back to an ai_agent actor on retry"
                },
                "output_schema": {
                    "type": "object",
                    "description": "JSON Schema the output must satisfy"
                },
                "judge_model_id": {
                    "type": "string",
                    "description": "Model reference for the judge (see specification, Model Binding). If absent the engine default is used."
                },
                "judge_temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.1
                },
                "pass_threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.9
                }
            }
        },
        "retry_policy": {
            "type": "object",
            "properties": {
                "max_attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 1,
                    "description": "Total executions allowed when the actor raises errors, including the first"
                },
                "initial_delay": {
                    "$ref": "awa.schema.json#/$defs/duration",
                    "default": "PT1S",
                    "description": "Delay before the second attempt"
                },
                "max_delay": {
                    "$ref": "awa.schema.json#/$defs/duration",
                    "default": "PT30S",
                    "description": "Upper bound on the delay between attempts"
                },
                "backoff_multiplier": {
                    "type": "number",
                    "minimum": 1,
                    "default": 2,
                    "description": "Factor applied to the delay after each failed attempt"
                },
                "jitter": {
                    "type": "boolean",
                    "default": true,
                    "description": "Vary each delay randomly by up to 25% to avoid synchronised retries"
                },
                "non_retryable_errors": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Error codes that end the activity immediately"
                }
            }
        },
        "outcome_contract": {
            "type": "object",
            "properties": {
                "output_schema": {
                    "type": "object",
                    "description": "JSON Schema (2020-12) the outcome must validate against"
                },
                "postconditions": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "expression"
                        ],
                        "properties": {
                            "id": {
                                "$ref": "awa.schema.json#/$defs/uuid"
                            },
                            "name": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            },
                            "expression": {
                                "type": "string",
                                "description": "Condition expression that must be true of the outcome"
                            }
                        }
                    }
                },
                "budgets": {
                    "type": "object",
                    "properties": {
                        "max_attempts": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50,
                            "description": "Most executions of the actor allowed for one visit, for any reason"
                        },
                        "max_duration": {
                            "$ref": "awa.schema.json#/$defs/duration",
                            "description": "Longest a single attempt may take"
                        },
                        "max_tokens": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Most model tokens, input plus output, the visit may consume, including judge tokens"
                        },
                        "max_tool_calls": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 16,
                            "description": "Most tool calls allowed in one attempt"
                        }
                    }
                },
                "on_violation": {
                    "type": "string",
                    "enum": [
                        "fail",
                        "escalate_human"
                    ],
                    "default": "fail",
                    "description": "What happens when the outcome is rejected and no automatic attempt remains"
                }
            }
        },
        "tool": {
            "type": "object",
            "required": [
                "name",
                "binding"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$",
                    "description": "Name the actor calls the tool by. Unique within the activity."
                },
                "description": {
                    "type": "string",
                    "description": "What the tool does and when to use it. Shown to the model."
                },
                "parameters": {
                    "type": "object",
                    "description": "JSON Schema of the arguments object. Arguments are validated against it before the tool runs."
                },
                "binding": {
                    "$ref": "#/$defs/tool_binding"
                },
                "documentation": {
                    "type": "string",
                    "format": "uri",
                    "description": "Where the underlying interface is documented, e.g. an OpenAPI document"
                },
                "timeout": {
                    "$ref": "awa.schema.json#/$defs/duration",
                    "default": "PT30S"
                }
            }
        },
        "tool_binding": {
            "description": "What actually runs when the tool is called",
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "kind",
                        "url"
                    ],
                    "properties": {
                        "kind": {
                            "const": "http"
                        },
                        "method": {
                            "type": "string",
                            "enum": [
                                "GET",
                                "POST",
                                "PUT",
                                "PATCH",
                                "DELETE",
                                "HEAD"
                            ],
                            "default": "GET"
                        },
                        "url": {
                            "type": "string",
                            "description": "URL. {name} is replaced by the argument of that name."
                        },
                        "headers": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            },
                            "description": "Request headers. {{secret:NAME}} is replaced by a secret the deployment supplies. Never journalled."
                        }
                    }
                },
                {
                    "type": "object",
                    "required": [
                        "kind",
                        "command"
                    ],
                    "properties": {
                        "kind": {
                            "const": "command"
                        },
                        "command": {
                            "type": "string",
                            "description": "Program to run. Runs only if the deployment allows it."
                        },
                        "args": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Arguments. {name} is replaced by the argument of that name. No shell is involved."
                        }
                    }
                },
                {
                    "type": "object",
                    "required": [
                        "kind",
                        "endpoint",
                        "method"
                    ],
                    "properties": {
                        "kind": {
                            "const": "jsonrpc"
                        },
                        "endpoint": {
                            "type": "string",
                            "format": "uri"
                        },
                        "method": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "required": [
                        "kind",
                        "endpoint",
                        "service",
                        "method"
                    ],
                    "properties": {
                        "kind": {
                            "const": "grpc"
                        },
                        "endpoint": {
                            "type": "string"
                        },
                        "service": {
                            "type": "string"
                        },
                        "method": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "required": [
                        "kind",
                        "server",
                        "tool"
                    ],
                    "properties": {
                        "kind": {
                            "const": "mcp"
                        },
                        "server": {
                            "type": "string"
                        },
                        "tool": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "required": [
                        "kind",
                        "name"
                    ],
                    "properties": {
                        "kind": {
                            "const": "function"
                        },
                        "name": {
                            "type": "string",
                            "description": "A handler registered with the engine"
                        }
                    }
                }
            ]
        },
        "a2a_agent": {
            "type": "object",
            "description": "An agent reached over the Agent2Agent protocol (A2A 1.0) that performs the activity (specification section 28)",
            "required": [
                "agent_card"
            ],
            "properties": {
                "agent_card": {
                    "type": "string",
                    "format": "uri",
                    "description": "URL of the agent's card"
                },
                "skill": {
                    "type": "string",
                    "description": "Id of the skill on the card the work is for"
                },
                "on_input_required": {
                    "type": "string",
                    "enum": [
                        "wait",
                        "fail"
                    ],
                    "default": "wait",
                    "description": "wait: the token waits for the host to give the input the agent asks for. fail: the attempt fails with AGENT_INPUT_REQUIRED"
                },
                "headers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    },
                    "description": "Headers sent with every request to the agent. {{secret:NAME}} is replaced by a secret the deployment supplies. Never journalled."
                }
            },
            "additionalProperties": false
        }
    }
}
